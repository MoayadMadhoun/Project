@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "نسيت كلمة المرور؟";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style>
            :root {
                --teal:       #2ABFB0;
                --teal-dark:  #1FA89A;
                --navy:       #1B2A4A;
                --bg:         #F0F4F8;
                --dot:        #C8DDE8;
            }

            * { box-sizing: border-box; }

            body {
                font-family: 'Tajawal', sans-serif;
                background-color: var(--bg);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

            /* ── dot-grid decorations ── */
            body::before,
            body::after {
                content: '';
                position: fixed;
                width: 120px;
                height: 180px;
                background-image: radial-gradient(circle, var(--dot) 1.5px, transparent 1.5px);
                background-size: 14px 14px;
                opacity: .7;
                pointer-events: none;
            }
            body::before { top: 80px;  left: 40px; }
            body::after  { bottom: 60px; right: 40px; }

            /* ── blob decorations ── */
            .blob {
                position: fixed;
                border-radius: 50%;
                opacity: .12;
                pointer-events: none;
            }
            .blob-1 {
                width: 260px; height: 260px;
                background: var(--teal);
                top: -60px; left: -80px;
            }
            .blob-2 {
                width: 180px; height: 180px;
                background: var(--teal);
                bottom: -40px; right: 60px;
            }

            /* ── card ── */
            .card-wrap {
                background: #fff;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 8px 40px rgba(0,0,0,.10);
                width: 100%;
                max-width: 580px;
            }

            /* ── teal header strip ── */
            .card-header-brand {
                background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
                padding: 28px 32px 48px;
                text-align: center;
                position: relative;
            }
            .brand-logo {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                color: #fff;
                text-decoration: none;
            }
            .brand-logo svg {
                width: 42px; height: 42px;
            }
            .brand-name {
                font-size: 1.55rem;
                font-weight: 800;
                letter-spacing: .3px;
                color: #fff;
            }

            /* ── wave between header and body ── */
            .wave-divider {
                display: block;
                margin-top: -2px;
                line-height: 0;
            }
            .wave-divider svg {
                width: 100%; height: 36px;
                display: block;
            }

            /* ── body ── */
            .card-body-inner {
                padding: 10px 44px 44px;
                text-align: center;
            }

            /* lock icon circle */
            .lock-circle {
                width: 76px; height: 76px;
                border-radius: 50%;
                background: #E6F7F5;
                display: flex; align-items: center; justify-content: center;
                margin: -38px auto 24px;
                border: 4px solid #fff;
                position: relative;
                z-index: 2;
            }
            .lock-circle svg {
                width: 34px; height: 34px;
                color: var(--teal);
            }

            .page-title {
                font-size: 1.65rem;
                font-weight: 800;
                color: var(--navy);
                margin-bottom: 10px;
            }
            .page-subtitle {
                font-size: .95rem;
                color: #6B7A90;
                line-height: 1.8;
                margin-bottom: 28px;
            }

            /* ── form ── */
            .field-label {
                display: block;
                text-align: right;
                font-size: .9rem;
                font-weight: 700;
                color: var(--navy);
                margin-bottom: 6px;
            }
            .field-label .req { color: var(--teal); margin-right: 2px; }

            .input-wrap {
                position: relative;
                margin-bottom: 18px;
            }
            .input-wrap .input-icon {
                position: absolute;
                right: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--teal);
                pointer-events: none;
            }
            .input-wrap input.form-control {
                border: 1.5px solid #D4E2EC;
                border-radius: 10px;
                padding: 14px 48px 14px 16px;
                font-size: .95rem;
                font-family: 'Tajawal', sans-serif;
                color: var(--navy);
                transition: border-color .2s, box-shadow .2s;
                text-align: right;
            }
            .input-wrap input.form-control:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(42,191,176,.15);
                outline: none;
            }
            .input-wrap input.form-control::placeholder { color: #A8B8C8; }

            .btn-reset {
                background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 14px;
                font-size: 1rem;
                font-weight: 700;
                font-family: 'Tajawal', sans-serif;
                width: 100%;
                transition: opacity .2s, transform .15s;
            }
            .btn-reset:hover { opacity: .9; transform: translateY(-1px); }
            .btn-reset:active { transform: translateY(0); }

            /* ── divider or ── */
            .or-divider {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 22px 0;
                color: #A8B8C8;
                font-size: .85rem;
            }
            .or-divider::before,
            .or-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #E4EDF3;
            }

            /* ── back link ── */
            .back-link {
                color: var(--teal);
                font-weight: 700;
                font-size: .95rem;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: gap .2s;
            }
            .back-link:hover { gap: 10px; color: var(--teal-dark); }

            /* validation */
            .text-danger { font-size: .82rem; display: block; margin-top: 4px; text-align: right; }
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="card-wrap">

        <!-- Teal header -->
        <div class="card-header-brand">
            <a href="/" class="brand-logo">
               
                @* <span class="brand-name">Spaceara</span> *@
            </a>
        </div>

        <!-- Wave -->
        <div class="wave-divider">
            <svg viewBox="0 0 580 36" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0 Q145 36 290 18 Q435 0 580 18 L580 0 Z" fill="#1FA89A" />
            </svg>
        </div>

        <!-- Body -->
        <div class="card-body-inner">

            <!-- Lock icon -->
            <div class="lock-circle">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="11" width="18" height="11" rx="3" stroke="currentColor" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" />
                    <circle cx="12" cy="16" r="1.5" fill="currentColor" />
                    <line x1="12" y1="17.5" x2="12" y2="19" stroke="currentColor" stroke-linecap="round" />
                </svg>
            </div>

            <h1 class="page-title">نسيت كلمة المرور؟</h1>
            <p class="page-subtitle">
                أدخل البريد الإلكتروني المرتبط بحسابك وسنرسل لك<br>
                رابط إعادة تعيين كلمة المرور.
            </p>

            <!-- ====== ORIGINAL LOGIC — untouched ====== -->
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <label class="field-label">
                    <span class="req">*</span> البريد الإلكتروني
                </label>
                <div class="input-wrap">
                    <svg class="input-icon" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <rect x="2" y="4" width="20" height="16" rx="3" />
                        <path d="M2 7l10 7 10-7" />
                    </svg>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="example@domain.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-reset">
                    إرسال رابط إعادة التعيين
                </button>
            </form>
            <!-- ====== END ORIGINAL LOGIC ====== -->

            <div class="or-divider">أو</div>

            <a href="/Identity/Account/Login" class="back-link">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                العودة لتسجيل الدخول
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>