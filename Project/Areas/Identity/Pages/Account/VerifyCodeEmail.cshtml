
@page
@model Project.Areas.Identity.Pages.Account.VerifyCodeEmailModel
@{
    ViewData["Title"] = "Verify Your Email";
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/verification.css" asp-append-version="true" />
</head>
<body>
    <div class="container min-vh d-flex align-items-center justify-content-center">
        <div class="row w-100 justify-content-center">
            <div class="col-10 col-md-5 justify-content-center">
                <div class="card me-sm-3 card-sh py-2">
                    <div class="  text-center">
                        <h3 class="title-color mt-3"> @ViewData["Title"]</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-center text-muted fw-semibold"><span style="color:#afb0b4">We sent a verification code to </span> <br /><span class="title-color">@Model.Email</span></p>
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Email" id="emailHidden" />
                            <input type="hidden" asp-for="Code" id="fullCode" />
                            <div class="text-center justify-content-center">
                                <label asp-for="Code" class="form-label text-center d-block mb-3 " style="color:#0eb6bf;">
                                    <span style="font-weight:450;font-size:18px;"> Your Verifiction Code</span>
                                </label>
                                <div class="otp-container d-flex m-0 justify-content-center gap-1 gap-sm-2  " dir="ltr">
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" autofocus />
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" />
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" />
                                    <span class="under-dash">-</span>
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" />
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" />
                                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" autocomplete="one-time-code" />
                                </div>
                                <span asp-validation-for="Code" class="text-danger text-center d-block mt-2"></span>
                            </div>
                            <div class="d-grid mt-3 p-3">
                                <button type="submit" class="btn btn-color  btn-lg" id="verifyBtn">Verify</button>
                            </div>
                        </form>
                    </div>

                </div>
                <p class="mt-3 text-center">Code Expires in <span id="timer" class="fw-bold text-danger">10:00</span></p>
                <div class="text-center"><button class="btn btn-link text-decoration-none text-center  p-0" id="resendBtn" disabled>Resend Code (60s)</button></div>
            </div>
        </div>
    </div>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Validation -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- JS -->
    <script src="~/js/verification.js" asp-append-version="true"></script>





</body>
</html>


