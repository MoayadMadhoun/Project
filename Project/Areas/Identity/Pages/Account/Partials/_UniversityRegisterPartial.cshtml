<div class=" m-0 input-icon ">
    <i class="fa-solid fa-envelope"></i>
    <input asp-for="Input.Email" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="البريد الالكتروني الرسمي" />
    <label class="form-label">  </label>
    <span class="text-danger" asp-validation-for="Input.Email"></span>
</div>
<div class=" m-0 input-icon ">
    <i class="fa-solid fa-lock"></i>
    <input asp-for="Input.Password" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="كلمة المرور" />
    <label class="form-label">  </label>
    <span class="text-danger" asp-validation-for="Input.Password"></span>

</div>
<div class=" m-0 input-icon ">
    <i class="fa-solid fa-lock"></i>
    <input asp-for="Input.ConfirmPassword" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="تأكيد كلمة المرور" />
    <label class="form-label">  </label>
    <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>

</div>
<div class=" m-0 input-icon ">
    <i class="fa-solid fa-phone"></i>
    <input asp-for="UniversityInput.PhoneNumber" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="رقم الهاتف المباشر للجهة المسؤولة " />
    <label class="form-label">
    </label>
    <span class="text-danger" asp-validation-for="UniversityInput.PhoneNumber"></span>

</div>


