@model Project.Areas.Identity.Pages.Account.RegisterModel;


@section RegisterStyle {

    <link href="~/css/regester-style.css" rel="stylesheet" />
}
<div class=" m-0 input-icon  ">
    <i class="fa-solid fa-building-columns"></i>
    <input asp-for="UniversityInput.FullName" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="اسم الجامعة" />
    <label class="form-label "> </label>
    <span class="text-danger" asp-validation-for="UniversityInput.FullName"></span>
</div>
<div class=" m-0 input-icon ">
    <i class="fa-solid fa-location-dot"></i>
    <input asp-for="UniversityInput.Address" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder=" عنوان المقر الرئيسي" />
    <label class="form-label"> </label>
    <span class="text-danger" asp-validation-for="UniversityInput.Address"></span>

</div>
