
@model Project.Areas.Identity.Pages.Account.RegisterModel;

    <style>
       
        .form-control-s {
            width: 100%;
          padding: 0.375rem ; 
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.5;
            color: black;
            appearance: none;
            background-color: white;
            background-clip: padding-box;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.12);
            height: 45px;
        }

            .form-control-s:focus {
                border: 1.5px solid #0eb6bf;
                outline: none;
                box-shadow: 0 2px 2px  #0eb6bf;
            }

    .form-select{
        box-shadow: 0 5px 5px rgba(0, 0, 0, 0.12);
    }
        .form-select:focus {
            border-color: #0eb6bf;
            outline: none;
            box-shadow: 0 2px 2px #0eb6bf;
        }

        .div-bg-std {
            background-color: #f7f7f7;
            border-radius: 10px;
        box-shadow: 0 2px 5px #0eb6bf;
        }

    .input-icon:focus-within i {
        color: #0eb6bf;
        font-size: 18px;
    }
        .input-icon {
            position: relative;
            width: 50%;
        }

            .input-icon i {
                position: absolute;
                left: 12px;
                top: 50%;
                margin-top:6px;
                font-size:16px;
                transform: translateY(-50%);
                color: gray;
                
            }
         .bi-exclamation-circle{
                color: #0eb6bf;
        text-shadow: 0 1px 1px #0eb6bf;
        filter: drop-shadow(0 1px 1px #0eb6bf inset);
        
    
            }
           

    </style>




    <div class="">

        <div class="d-flex justify-content-between">

            <div class="input-icon m-2">
                <i class="fa-solid fa-user"></i>
                <input asp-for="StudentInput.FullName" class="form-control-s" placeholder="الاسم الكامل" />
            <span class="text-danger" asp-validation-for="StudentInput.FullName"></span>
            </div>

            <div class="input-icon m-2">
                <i class="fa-solid fa-envelope"></i>
            <input asp-for="Input.Email" class="form-control-s" placeholder="البريد الالكتروني" />
            <span class="text-danger" asp-validation-for="Input.Email"></span>
            </div>

        </div>

        <div class="d-flex justify-content-between">

            <div class="input-icon m-2">
                <i class="fa-solid fa-phone"></i>
            <input asp-for="StudentInput.PhoneNumber" class="form-control-s" placeholder="رقم الهاتف" />
            <span class="text-danger" asp-validation-for="StudentInput.PhoneNumber"></span>

            </div>

            <div class="input-icon m-2">
                <i class="fa-solid fa-lock"></i>
            <input asp-for="Input.Password" class="form-control-s" placeholder="كلمة المرور" />
            <span class="text-danger" asp-validation-for="Input.Password"></span>
            </div>

        </div>

    </div>
<div class="d-flex justify-content-center">

    <div class="input-icon m-2" style="width:100%;">
        <i class="fa-solid fa-lock"></i>
        <input asp-for="Input.ConfirmPassword" class="form-control-s" placeholder=" تأكيد كلمة المرور" />
        <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
    </div>
</div>


    <div class="mt-4 div-bg-std p-3 mb-4">

        <div class="text-end m-2">
        <i class="bi bi-exclamation-circle"></i>
            بيانات الطالب الأكاديمية
        </div>

        <div>

            <div class="d-flex justify-content-between">

                <div class="input-icon m-2">
                    <i class="fa-solid fa-id-card"></i>
                <input asp-for="StudentInput.StudentNumber" class="form-control-s" placeholder="الرقم الجامعي" />
                <span class="text-danger" asp-validation-for="StudentInput.StudentNumber"></span>

                </div>

            <select asp-for="StudentInput.UniversityID" asp-items="Model.UniversityList" class="form-select  w-50 m-2" id="universitySelect">
                    <option value="">الجامعة</option>
                </select>
            <span class="text-danger" asp-validation-for="StudentInput.UniversityID"></span>

            </div>

            <div class="d-flex justify-content-between">

                <div class="input-icon m-2">
                    <i class="fa-solid fa-graduation-cap"></i>
                <select asp-for="StudentInput.SpecialtyId" class="form-control-s" placeholder="التخصص" id="specialtiesSelect">
                    <option value="">التخصص</option>
                    </select>
                <span class="text-danger" asp-validation-for="StudentInput.SpecialtyId"></span>
                </div>

            <select asp-for="StudentInput.DepartmentID" class="form-select  w-50 m-2" id="departmentSelect">
                    <option value="">القسم</option>
                </select>
            <span class="text-danger" asp-validation-for="StudentInput.DepartmentID"></span>

            </div>

        </div>

    </div>

    

<script>
    document.getElementById("universitySelect").addEventListener("change", async function () {

        const universityId = this.value;
        const departmentSelect = document.getElementById("departmentSelect");

        departmentSelect.innerHTML = '<option value="">اختر القسم</option>';

        if (!universityId) return;

        try {
            const response = await fetch(`/Identity/Account/Register?handler=Departments&universityId=${universityId}`);

            if (!response.ok) {
                console.error("خطأ في الطلب:", response.status);
                return;
            }

            const departments = await response.json();

            console.log("الأقسام المستلمة:", departments); 

            departments.forEach(dep => {
                const option = document.createElement("option");
                option.value = dep.id;
                option.textContent = dep.name;
                departmentSelect.appendChild(option);
            });

        } catch (error) {
            console.error("Fetch Error:", error);
            alert("حدث خطأ أثناء تحميل الأقسام");
        }
    });

    document.getElementById("departmentSelect").addEventListener("change",async function(){
        const departmentId=this.value;
        const specialtiesSelect = document.getElementById("specialtiesSelect");
        specialtiesSelect.innerHTML='<option value="">اختر التخصص</option>';

        if(!departmentId)
            return;
        try{
            const response = await fetch(`/Identity/Account/Register?handler=Specialties&departmentId=${departmentId}`);
            if (!response.ok) {
                console.error("خطأ في الطلب:", response.status);
                return;

            }

             const specialties = await response.json();

            specialties.forEach(sp => {
                const option = document.createElement("option");
                option.value = sp.id;
                option.textContent = sp.name;
                specialtiesSelect.appendChild(option);
            });


        } catch (error) {
            console.error("Fetch Error:", error);
            alert("حدث خطأ أثناء تحميل الأقسام");
        }
            



    });



</script>