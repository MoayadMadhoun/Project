@model Project.Areas.Identity.Pages.Account.RegisterModel;

<div class="row g-3">

    <div class="col-12">
        <div class="input-icon">
            <i class="fa-solid fa-building-columns field-icon"></i>
            <input asp-for="InistitutionInput.FullName"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="اسم المؤسسة" />
        </div>
        <span class="text-danger" asp-validation-for="InistitutionInput.FullName"></span>
    </div>

    <div class="col-12">
        <select asp-for="InistitutionInput.InstituationType"
                asp-items="Model.InstitutionTypeList"
                class="form-control-s">
            <option value="">نوع المؤسسة</option>
        </select>
        <span class="text-danger" asp-validation-for="InistitutionInput.InstituationType"></span>
    </div>

    <div class="col-12">
        <div class="input-icon">
            <i class="fa-solid fa-envelope field-icon"></i>
            <input asp-for="Input.Email"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="البريد الإلكتروني المؤسسي" />
        </div>
        <span class="text-danger" asp-validation-for="Input.Email"></span>
    </div>

    <div class="col-6">
        <div class="input-icon">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="Input.Password"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="كلمة المرور" />
        </div>
        <span class="text-danger" asp-validation-for="Input.Password"></span>
    </div>

    <div class="col-6">
        <div class="input-icon">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="Input.ConfirmPassword"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="تأكيد كلمة المرور" />
        </div>
        <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
    </div>

    <div class="col-12">
        <div class="input-icon">
            <i class="fa-solid fa-phone field-icon"></i>
            <input asp-for="InistitutionInput.PhoneNumber"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="رقم الهاتف" />
        </div>
        <span class="text-danger" asp-validation-for="InistitutionInput.PhoneNumber"></span>
    </div>

    <div class="col-12">
        <div class="input-icon">
            <i class="fa-solid fa-location-dot field-icon"></i>
            <input asp-for="InistitutionInput.Address"
                   class="form-control-s"
                   style="padding-right:2.4rem"
                   placeholder="عنوان المقر الرئيسي" />
        </div>
        <span class="text-danger" asp-validation-for="InistitutionInput.Address"></span>
    </div>

</div>
