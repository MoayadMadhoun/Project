@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spaceara - منصة إدارة التدريب الميداني</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="../../../../Styles/main.css">
    <link rel="stylesheet" href="../../../../Styles/site.css">
    <!--Link to Swiper-->

  

    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <style>

    </style>
</head>
<body>
    <div class="login-screen row justify-content-center py-5">
        <div class="wave-bottom">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#00B894" fill-opacity="1" d="M0,96L60,80C120,64,240,32,360,26.7C480,21,600,43,720,96C840,149,960,235,1080,272C1200,309,1320,299,1380,293.3L1440,288L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path></svg>
            
        </div>
        <div class="card shadow-md mx-auto ">
            <div class="card-header text-center py-3">
                    
                <img src="../../../../images/Logos/NavBarLogo.svg" alt="logo" class="w-50 mb-1 mt-1">
                <h3 class="mb-0">نظام إدارة التدريب الميداني</h3>
                   
            </div>
            <div class="card-body p-3">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <div class="mb-2">
                        <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                        <div class="input-group">
                            <input asp-for="Input.Email" class="form-control" placeholder="example@university.edu" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                        <div class="input-group">
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <div class="mb-3 form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input"/>
                                <label asp-for="Input.RememberMe" class="form-check-label">تذكرني</label>
                            </div>
                        </div>
                    </div>

                        

                    <button type="submit" class="auth-btn btn w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i> تسجيل الدخول
                    </button>
                    <div class="col-6"><a class="main-color" id="forgot-password" asp-page="./ForgotPassword">نسيت كلمة المرور؟</a></div>

                </form>

                <hr class="my-3" />

                <div class="text-center small text-muted">
                    <p class="mb-1">ليس لديك حساب؟ <a asp-page="/Account/Register" class="main-color text-decroation-none">سجّل الآن</a></p>
                </div>

                    
            </div>
        </div>
    </div>

    
</body>
</html>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
