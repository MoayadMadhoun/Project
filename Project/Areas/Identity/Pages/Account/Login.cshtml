@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spaceara - منصة إدارة التدريب الميداني</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="../../../../Styles/main.css">
    <link rel="stylesheet" href="../../../../Styles/site.css">
    <!--Link to Swiper-->

  

    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <style>
        /* =========================
   PAGE ANIMATION
========================= */

body{
    overflow-x:hidden;
}

/* الكارد الرئيسي */
.login-screen .card{
    opacity:0;
    transform:translateY(50px);
    animation:loginFade 1s ease forwards;
    border:none;
    border-radius:24px;
    backdrop-filter:blur(10px);
    transition:all .35s ease;
}

/* Hover */
.login-screen .card:hover{
    transform:translateY(-6px);
    box-shadow:0 25px 60px rgba(0,0,0,.12);
}

/* ظهور الصفحة */
@@keyframes loginFade{
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* حقول الإدخال */
.form-control{
    border-radius:14px !important;
    padding:.85rem 1rem;
    transition:all .3s ease;
    border:1px solid #dbe3ea;
    box-shadow:none !important;
}

/* Focus Animation */
.form-control:focus{
    border-color:#00B894;
    transform:translateY(-2px);
    box-shadow:0 0 0 4px rgba(0,184,148,.12) !important;
}

/* زر تسجيل الدخول */
.auth-btn{
    background:linear-gradient(135deg,#00B894,#00a884);
    border:none;
    color:white;
    font-weight:700;
    border-radius:14px;
    transition:all .35s ease;
}

/* Hover button */
.auth-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 12px 25px rgba(0,184,148,.25);
}

/* حركة العناصر الداخلية */
.card-body > *{
    opacity:0;
    transform:translateY(20px);
    animation:fadeItem .7s ease forwards;
}

/* تأخير تدريجي */
.card-body > *:nth-child(1){ animation-delay:.2s; }
.card-body > *:nth-child(2){ animation-delay:.4s; }
.card-body > *:nth-child(3){ animation-delay:.6s; }

@@keyframes fadeItem{
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* حركة الخلفية */
.wave-bottom{
    animation:waveMove 3s ease-in-out infinite alternate;
}

@@keyframes waveMove{
    from{
        transform:translateY(0);
    }
    to{
        transform:translateY(12px);
    }
}
    </style>
</head>
<body>
    <div class="login-screen row justify-content-center py-5">
        <div class="wave-bottom">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="#00B894" fill-opacity="1" d="M0,96L60,80C120,64,240,32,360,26.7C480,21,600,43,720,96C840,149,960,235,1080,272C1200,309,1320,299,1380,293.3L1440,288L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path></svg>
            
        </div>
        <div class="card shadow-md mx-auto ">
            <div class="card-header text-center py-3">
                    
                <img src="../../../../images/Logos/NavBarLogo.svg" alt="logo" class="w-50 mb-1 mt-1">
                <h3 class="mb-0">نظام إدارة التدريب الميداني</h3>
                   
            </div>
            <div class="card-body p-3 vw-80">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="{@Model.ErrorMessage == null ? display:none; : display:block;}"></div>

                    <div class="mb-2">
                        <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                        <div class="input-group">
                            <input asp-for="Input.Email" class="form-control" placeholder="example@university.edu" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                        <div class="input-group">
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <div class="mb-3 form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input"/>
                                <label asp-for="Input.RememberMe" class="form-check-label">تذكرني</label>
                            </div>
                        </div>
                    </div>

                        

                    <button type="submit" class="auth-btn btn w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i> تسجيل الدخول
                    </button>
                    <div class="col-6"><a class="main-color" id="forgot-password" asp-page="./ForgotPassword">نسيت كلمة المرور؟</a></div>

                </form>

                <hr class="my-3" />

                <div class="text-center small text-muted">
                    <p class="mb-1">ليس لديك حساب؟ <a asp-page="/Auth/ChooseAccountType" class="main-color text-decroation-none">سجّل الآن</a></p>
                </div>

                    
            </div>
        </div>
    </div>

    
</body>
</html>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
