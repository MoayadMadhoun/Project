@page
@model PersonalDataModel
@{
    ViewData["Title"] = "البيانات الشخصية";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container-fluid">

    <!-- Header -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body text-white p-4"
             style="background:#1ab29a;border-radius:20px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="fw-bold mb-2">
                        البيانات الشخصية
                    </h3>

                    <p class="mb-0">
                        إدارة بياناتك الشخصية وتنزيلها أو حذف الحساب نهائياً
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle
                    d-flex align-items-center
                    justify-content-center"
                     style="width:80px;height:80px;">

                    <i class="bi bi-database-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Main Card -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 pt-4">

            <h5 class="fw-bold mb-0">
                إدارة البيانات
            </h5>

        </div>

        <div class="card-body p-4">

            <div class="alert alert-info">

                <i class="bi bi-info-circle-fill me-2"></i>

                يحتوي حسابك على بيانات شخصية قمت بإدخالها داخل النظام.
                يمكنك تنزيل نسخة من بياناتك أو حذف الحساب بشكل نهائي.

            </div>

            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <strong>
                    حذف الحساب سيؤدي إلى إزالة الحساب بشكل دائم،
                    ولن يكون بالإمكان استرجاعه لاحقاً.
                </strong>

            </div>

            <div class="d-flex gap-2 flex-wrap">

                <form id="download-data"
                      asp-page="DownloadPersonalData"
                      method="post">

                    <button class="btn text-white"
                            style="background:#1ab29a;">

                        <i class="bi bi-download me-2"></i>

                        تنزيل بياناتي

                    </button>

                </form>

                <a id="delete"
                   asp-page="DeletePersonalData"
                   class="btn btn-danger">

                    <i class="bi bi-trash-fill me-2"></i>

                    حذف الحساب

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
