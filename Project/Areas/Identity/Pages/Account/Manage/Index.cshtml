@page
@model IndexModel
@{
    ViewData["Title"] = "الملف الشخصي";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container-fluid">

    <!-- Header -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body text-white p-4"
             style="background:#1ab29a;border-radius:20px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="fw-bold mb-2">
                        الملف الشخصي
                    </h3>

                    <p class="mb-0">
                        إدارة معلومات حسابك الشخصية
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle
                    d-flex align-items-center
                    justify-content-center"
                     style="width:80px;height:80px;">

                    <i class="bi bi-person-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <partial name="_StatusMessage"
             for="StatusMessage" />

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 pt-4">

            <h5 class="fw-bold mb-0">
                معلومات الحساب
            </h5>

        </div>

        <div class="card-body p-4">

            <form id="profile-form" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-4">

                    <label asp-for="Username"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Username"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-4">

                    <label asp-for="Input.PhoneNumber"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           placeholder="أدخل رقم الهاتف" />

                    <span asp-validation-for="Input.PhoneNumber"
                          class="text-danger">
                    </span>

                </div>

                <button id="update-profile-button"
                        type="submit"
                        class="btn text-white px-4"
                        style="background:#1ab29a;">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    حفظ التغييرات

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
