@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body text-white p-4"
             style="background:#1ab29a;border-radius:20px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="fw-bold mb-2">
                        تغيير كلمة المرور
                    </h3>

                    <p class="mb-0">
                        قم بتحديث كلمة المرور الخاصة بحسابك للحفاظ على أمان بياناتك
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle
                    d-flex align-items-center
                    justify-content-center"
                     style="width:80px;height:80px;">

                    <i class="bi bi-shield-lock-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 pt-4">

            <h5 class="fw-bold mb-0">
                بيانات كلمة المرور
            </h5>

        </div>

        <div class="card-body p-4">

            <form id="change-password-form" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-4">

                    <label asp-for="Input.OldPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.OldPassword"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="أدخل كلمة المرور الحالية" />

                    <span asp-validation-for="Input.OldPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Input.NewPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.NewPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="أدخل كلمة المرور الجديدة" />

                    <span asp-validation-for="Input.NewPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Input.ConfirmPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="أعد إدخال كلمة المرور الجديدة" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn text-white px-4"
                        style="background:#1ab29a;">

                    <i class="bi bi-shield-check me-2"></i>

                    تحديث كلمة المرور

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
