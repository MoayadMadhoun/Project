@page
@using Project.Models.Enums;
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_NLayout";
}
@* 
<h1>@ViewData["Title"]</h1> *@


<div class="row justify-content-center align-items-center ">
        
    <div class="col-10 col-md-5 form-body ps-4 pe-4 pt-2 text-center justify-content-center  ">
        <img src="../../../../images/Logos/NavBarLogo.svg" width="120" class="mb-3" />
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @if (Model.AccountType == AccountType.Institution)
            {
                @* <partial name="Partials\_InstitutionRegisterPartial" model="Model" /> *@
                @await Html.PartialAsync(@"Partials\_InstitutionRegisterPartial", Model)

               
            }
            @if (Model.AccountType == AccountType.University)
            {
                @* <partial name="Partials\_UniversityRegisterPartial" model="Model" /> *@
                @await Html.PartialAsync(@"Partials\_UniversityRegisterPartial", Model)

                
            }
            @if (Model.AccountType == AccountType.Student)
            {
                @* <partial name="Partials\_StudentRegisterPartial" model="Model" /> *@
                @await Html.PartialAsync(@"Partials\_StudentRegisterPartial", Model)

                
                       
            }
            <input type="hidden" asp-for="AccountType" />
            <button id="registerSubmit" type="submit" class="w-100 btn btn-register "> انشاء الحساب <i class="bi bi-person-plus"></i> </button>
        </form>
        <div class="text-center m-3">
            لديك حساب بالفعل ؟
            <a asp-area="Identity"
                   asp-page="/Account/Login">
                تسجيل الدخول
                
            </a>
                
        </div>
    </div>
    @* <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>Use another service to register.</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">article
                            about setting up this ASP.NET application to support logging in via external services</a>.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div> *@
</div>




@section RegisterStyle {

    <link href="../../../../css/regester-style.css" rel="stylesheet" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
