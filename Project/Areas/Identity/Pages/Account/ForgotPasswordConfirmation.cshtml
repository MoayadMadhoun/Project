@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "تم إرسال رابط الاسترداد";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style>
            :root {
                --teal: #2ABFB0;
                --teal-dark: #1FA89A;
                --navy: #1B2A4A;
                --bg: #F0F4F8;
                --dot: #C8DDE8;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Tajawal', sans-serif;
                background-color: var(--bg);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
                padding: 10px 20px ;
            }

                /* dot-grid decorations */
                body::before, body::after {
                    content: '';
                    position: fixed;
                    width: 120px;
                    height: 180px;
                    background-image: radial-gradient(circle, var(--dot) 1.5px, transparent 1.5px);
                    background-size: 14px 14px;
                    opacity: .7;
                    pointer-events: none;
                }

                body::before {
                    top: 80px;
                    left: 40px;
                }

                body::after {
                    bottom: 60px;
                    right: 40px;
                }

            /* blobs */
            .blob {
                position: fixed;
                border-radius: 50%;
                opacity: .12;
                pointer-events: none;
            }

            .blob-1 {
                width: 260px;
                height: 260px;
                background: var(--teal);
                top: -60px;
                left: -80px;
            }

            .blob-2 {
                width: 180px;
                height: 180px;
                background: var(--teal);
                bottom: -40px;
                right: 60px;
            }

            /* card */
            .card-wrap {
                background: #fff;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 2px 0px rgba(42,191,176,.3), 0 8px 24px rgba(0,0,0,.07), 0 28px 64px rgba(0,0,0,.11);
                border: 1.5px solid #D8EBF0;
                width: 100%;
                max-width: 580px;
                margin: 40px auto;
            }

            /* teal header */
            .card-header-brand {
                background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
                padding: 8px 12px 28px;
                text-align: center;
            }

            .brand-logo {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

                .brand-logo svg {
                    width: 42px;
                    height: 42px;
                }

            .brand-name {
                font-size: 1.55rem;
                font-weight: 800;
                color: #fff;
            }

            /* wave */
            .wave-divider {
                display: block;
                margin-top: -2px;
                line-height: 0;
            }

                .wave-divider svg {
                    width: 100%;
                    height: 36px;
                    display: block;
                }

            /* body */
            .card-body-inner {
                padding: 10px 34px 34px;
                text-align: center;
            }

            /* success icon circle */
            .success-circle {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: #E6F7F5;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: -40px auto 28px;
                border: 4px solid #fff;
                position: relative;
                z-index: 2;
                animation: popIn .45s cubic-bezier(.34,1.56,.64,1) both;
            }

            @@keyframes popIn {
                from {
                    transform: scale(0);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .success-circle svg {
                width: 36px;
                height: 36px;
                color: var(--teal);
                stroke-dasharray: 60;
                stroke-dashoffset: 60;
                animation: drawCheck .5s .35s ease forwards;
            }

            @@keyframes drawCheck {
                to {
                    stroke-dashoffset: 0;
                }
            }

            .page-title {
                font-size: 1.55rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 8px;
            }

            /* info box */
            .info-box {
                background: #F0FBF9;
                border: 1.5px solid #B8EDE8;
                border-radius: 12px;
                padding: 10px 14px;
                margin-bottom: 18px;
                text-align: center;
            }

                .info-box p {
                    color: #3A7A74;
                    font-size: .95rem;
                    line-height: 1.85;
                    margin: 0;
                }

                .info-box strong {
                    color: var(--teal-dark);
                }

            /* steps */
            .steps {
                list-style: none;
                padding: 0;
                margin: 0 0 20px;
                text-align: right;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

                .steps li {
                    display: flex;
                    align-items: flex-start;
                    gap: 14px;
                    direction: rtl;
                }

            .step-num {
                flex-shrink: 0;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--teal), var(--teal-dark));
                color: #fff;
                font-size: .8rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .step-text {
                font-size: .9rem;
                color: #4A5D70;
                line-height: 1.7;
                padding-top: 4px;
            }

            /* divider */
            .or-divider {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0 0 12px;
                color: #A8B8C8;
                font-size: .85rem;
            }

                .or-divider::before, .or-divider::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: #E4EDF3;
                }

            /* buttons */
            .btn-login {
                background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 10px;
                font-size: 1rem;
                font-weight: 700;
                font-family: 'Tajawal', sans-serif;
                width: 100%;
                text-decoration: none;
                display: block;
                transition: opacity .2s, transform .15s;
                margin-bottom: 8px;
            }

                .btn-login:hover {
                    opacity: .9;
                    transform: translateY(-1px);
                    color: #fff;
                }

            .btn-resend {
                width: 100%;
                border: 1.5px solid #D4E2EC;
                border-radius: 10px;
                padding: 8px;
                font-size: .95rem;
                font-weight: 600;
                font-family: 'Tajawal', sans-serif;
                color: var(--navy);
                background: transparent;
                transition: border-color .2s, background .2s;
            }

                .btn-resend:hover {
                    border-color: var(--teal);
                    background: #F0FBF9;
                    color: var(--teal-dark);
                }

            /* spam note */
            .spam-note {
                margin-top: 18px;
                font-size: .82rem;
                color: #8FA3B1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

                .spam-note svg {
                    width: 14px;
                    height: 14px;
                    flex-shrink: 0;
                    color: #A8B8C8;
                }
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="card-wrap">

        <!-- Teal header -->
        <div class="card-header-brand">
            <a href="/" class="brand-logo">
                
                @* <span class="brand-name">SpaceEra</span> *@
            </a>
        </div>

        <!-- Wave -->
        <div class="wave-divider">
            <svg viewBox="0 0 580 36" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0 Q145 36 290 18 Q435 0 580 18 L580 0 Z" fill="#1FA89A" />
            </svg>
        </div>

        <!-- Body -->
        <div class="card-body-inner">

            <!-- Animated check circle -->
            <div class="success-circle">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>

            <!-- ====== ORIGINAL LOGIC — untouched ====== -->
            <h1 class="page-title">@ViewData["Title"]</h1>

            <div class="info-box">
                <p>
                    Please check your email to reset your password.
                </p>
            </div>
            <!-- ====== END ORIGINAL LOGIC ====== -->
            <!-- Steps guide -->
            <ul class="steps">
                <li>
                    <div class="step-num">١</div>
                    <div class="step-text">افتح بريدك الإلكتروني وابحث عن رسالة من Spaceara</div>
                </li>
                <li>
                    <div class="step-num">٢</div>
                    <div class="step-text">انقر على رابط إعادة تعيين كلمة المرور في الرسالة</div>
                </li>
                <li>
                    <div class="step-num">٣</div>
                    <div class="step-text">أنشئ كلمة مرور جديدة وقوية لحسابك</div>
                </li>
            </ul>

            <div class="or-divider">الخطوات التالية</div>

            <a href="/Identity/Account/Login" class="btn-login">
                العودة إلى تسجيل الدخول
            </a>

            @* <button type="button" class="btn-resend">
                لم تصلني الرسالة — إعادة الإرسال
            </button> *@

            @* <p class="spam-note">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                تحقق من مجلد البريد المزعج إذا لم تجد الرسالة
            </p> *@
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
