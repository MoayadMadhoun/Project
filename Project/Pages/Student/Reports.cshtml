@page
@model Project.Pages.Student.ReportsModel
@using Models.Enums;
@{
    ViewData["Title"] = "التقارير";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "التقارير";
    ViewData["SearchPlaceholder"] = "بحث عن التقارير...";
    ViewData["ActivePage"] = "Reports";
}

<link rel="stylesheet" href="~/css/opportunities.css">


@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right mb-3">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">التقارير</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            إدارة ورفع التقارير الأسبوعية والنهائية ومتابعة مراجعتها من قبل مشرف التدريب
        </p>
    </div>
    @*    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div> *@
    <a asp-page="/Student/Reports/Create" class="inline-block w-full sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors text-center">
        ＋ رفع تقرير جديد
    </a>
</section>
