@page
@model Project.Pages.Student.ReportsModel
@{
    ViewData["Title"] = "التقارير";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "التقارير";
    ViewData["SearchPlaceholder"] = "بحث عن التقارير...";
    ViewData["ActivePage"] = "Reports";
}

<link rel="stylesheet" href="~/css/opportunities.css">


@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right mb-3">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">التقارير</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
          إدارة ورفع التقارير الأسبوعية والنهائية ومتابعة مراجعتها من قبل مشرف التدريب
        </p>
    </div>
 @*    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div> *@
    <button class="w-full py-2 sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors"> ＋ رفع تقرير جديد</button>

</section>
@* Alert *@
<div class="bg-emerald-50  border border-emerald-600 rounded-xl px-5 py-3.5 mb-6 flex items-start gap-3">
    <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <div>
        <p class="text-emerald-600 font-semibold text-sm">آخر موعد لرفع التقرير الأسبوعي القادم: الخميس 15 مايو 2025 - 11:59 مساءً</p>
        <p class="text-slate-700 text-xs mt-0.5">يجب رفع التقرير قبل الموعد المحدد لتجنب التأخير في التقييم.</p>
    </div>
</div>


@* ===== Filters Bar ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div class="flex flex-wrap gap-3 items-end">

        <!-- Search -->
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن تقرير..." type="text" />
        </div>

        <!-- Report Type -->
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">نوع التقرير</label>
            <select dir="rtl" class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option>كل الأنواع</option>
                <option>أسبوعي</option>
                <option>نهائي</option>
            </select>
        </div>

        <!-- Status -->
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">حالة التقرير</label>
            <select class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option>كل الحالات</option>
                <option>مقبول</option>
                <option>قيد المراجعة</option>
                <option>قيد المراجعة (مرفوض)</option>
                <option>لم يتم التسليم</option>
            </select>
        </div>

        <!-- Button -->
        <button class="bg-primary text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
            فلترة التقارير
        </button>

    </div>
</div>

