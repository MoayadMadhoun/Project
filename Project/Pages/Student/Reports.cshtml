@* ===== Filters Bar ===== *@
<form method="get">
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div class="flex flex-wrap gap-3 items-end">

        <!-- Search -->
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input asp-for="@Model.search" class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن تقرير..." type="text" />
        </div>

        <!-- Report Type -->
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">نوع التقرير</label>
            <select asp-for="@Model.ReportType" asp-items="@Html.GetEnumSelectList<Models.StudentReport.ReportType>()" dir="rtl" class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                
                <option value="">كل الأنواع</option>
               
            </select>
        </div>

        <!-- Status -->
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">حالة التقرير</label>
            <select asp-for="@Model.Reportstatus" asp-items="@Html.GetEnumSelectList<Models.StudentReport.StudentReportStatus>()" class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">كل الحالات</option>
               
            </select>
        </div>

        <!-- Button -->
        <button  class="bg-primary text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors" type="submit">
            فلترة التقارير
        </button>

    </div>
</div>
</form>
@* ===== Opportunities Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
    <div class="p-4 md:p-lg border-b border-slate-100  justify-between items-center">
        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">قائمة التقارير</h3>
        <p class="text-slate-500">جميع التقارير التي قمت برفعها خلال فترة التدريب</p>

    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-center align-middle text-right border-collapse min-w-[960px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">#</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">عنوان التقرير</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">نوع التقرير</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الأسبوع/الفلترة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ التسليم</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">ملاحظات المشرف</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الملف</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>

                    
                   
                   
                   
                   
                  
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @{
                    int index = 0;
                }

             
                @foreach (var report in Model.StudentReports)
                
                {
                    index++;
                    <tr class="hover:bg-slate-50 transition-colors">

                        <td class="px-4 py-3 text-sm text-slate-900"> @index</td>

                        <td class="px-4 py-3 text-sm text-slate-900 font-bold"> @report.Title </td>

                        <td class="px-4 py-3 text-sm text-slate-600"> @report.Type.GetDisplayName() </td>

                        <td class="px-4 py-3 text-sm text-slate-600">
                            @{
                                var days = (report.SubmittedAt - report.Placement.StartDate).Days;
                                var week = (days / 7) + 1;
                             }
                            الأسبوع @week

                        </td>

                        <td class="px-4 py-3 text-sm text-slate-600"> @report.SubmittedAt.ToString("dd-MM-yyyy") </td>

                        <td class="px-4 py-3">

                            <span class="@(@report.Status == Models.StudentReport.StudentReportStatus.Approved ? "bg-emerald-50 text-emerald-600" :
                                           @report.Status == Models.StudentReport.StudentReportStatus.Rejected ? "bg-error-container text-error" :
                                          @report.Status == Models.StudentReport.StudentReportStatus.Reviewed ? "bg-blue-100 text-tertiary" :
                                          @report.Status == Models.StudentReport.StudentReportStatus.Submitted ? "bg-orange-50 text-orange-500" : "bg-slate-200 text-slate-700"
                                        )

                               px-3 py-1 rounded text-[11px] font-bold bg-emerald-50 text-emerald-600 d-flex" >

                                @report.Status.GetDisplayName()

                            </span>

                        </td>

                        @*  ملاحظات المشرف  *@

                        <td class="px-4 py-3"> 

                            @if (report.ReviewNotes is not null)
                            {
                               <span>@report.ReviewNotes</span> 
                                @* <button class="border border-slate-200 text-emerald-600 px-4 py-1 rounded hover:bg-emerald-50 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                    </svg>
                                </button> *@
                            }
                            else
                            {
                                <p>-</p>
                            }


                        </td>
                        <td class="px-4 py-3">

                            @if (!string.IsNullOrEmpty(report.FilePath))
                            {
                                <a asp-page-handler="OpenFile"
                                   asp-route-reportId="@report.ReportID"
                                   title="عرض الملف"
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition-all">

                                    <svg class="w-6 h-6"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M7 3h7l5 5v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z" />
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M14 3v5h5" />
                                    </svg>

                                </a>
                            }
                            else
                            {
                                <span class="text-slate-400">-</span>
                            }

                        </td>

                        @* الإجراءات *@

                        <td class="px-4 py-3">

                            @if (report.Status == Models.StudentReport.StudentReportStatus.Rejected ||
                                 report.Status == Models.StudentReport.StudentReportStatus.Approved)
                            {
                                
                                @* <div class="flex items-center gap-2">

                                    <a asp-page="/Student/Reports/View"
                                       asp-route-reportId="@report.ReportID"
                                       class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 transition"
                                       title="عرض">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>

                                </div> *@
                            }

                            @if (report.Status == Models.StudentReport.StudentReportStatus.Submitted)
                            {
                                <div class="flex items-center gap-2">

                                    <a asp-page="/Student/Reports/Edit"
                                       asp-route-reportId="@report.ReportID"
                                       class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition"
                                       title="تعديل">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-page="/Student/Reports/Delete"
                                       asp-route-reportId="@report.ReportID"
                                       class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 transition"
                                       title="حذف">

                                        <i class="bi bi-trash-fill"></i>

                                    </a>

                                </div>
                            }

                            @if (report.Status == Models.StudentReport.StudentReportStatus.NotSubmitted)
                            {
                                <a asp-page="/Student/Reports/Create"
                                   asp-route-id="@report.StudentID"
                                   class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-2 rounded-lg hover:bg-emerald-100 transition text-sm font-medium">

                                    <i class="bi bi-cloud-upload"></i>

                                    <span>رفع التقرير</span>

                                </a>
                            }

                        </td>

                   
                   
                    
                   
                   
                  
                    </tr>

                    
                
                
                
                }
            

            </tbody>
        </table>
    </div>
    @******************************************@

    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">@Model.CurrentQuary</span> من أصل <span class="font-bold text-slate-900">@Model.TotalQuary</span> تقرير
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="pp-s">النتائج:</label>
                <select asp-for="@Model.PageSize" class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer" id="pp-s">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>
        <nav class="flex items-center gap-2">

            @if (Model.StudentReports.HasPrevPage)
            {
                <a 
                asp-route-ReportType="@Model.ReportType" asp-route-search="@Model.search" asp-route-Reportstatus="@Model.Reportstatus"
                asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@(Model.PageIndex - 1)"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_right</span></a>

            }
            @for (int i = 1; i <= Model.StudentReports.TotalPages; i++)
            {
                <a asp-route-ReportType="@Model.ReportType" asp-route-search="@Model.search" asp-route-Reportstatus="@Model.Reportstatus"
                   asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@i"
                   class="w-8 h-8 flex items-center justify-center rounded-lg  text-sm font-bold @(i == Model.PageIndex ? "bg-primary text-white" : "border border-slate-200 text-slate-600  hover:bg-slate-50")">@i</a>

            
            }
            @if (Model.StudentReports.HasNextPage)
            {
                <a asp-route-ReportType="@Model.ReportType" asp-route-search="@Model.search" asp-route-Reportstatus="@Model.Reportstatus"
                   asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@(Model.PageIndex +1 )"
                    class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_left</span></a>

            }
        
        </nav>
    </div>

    <!----------------- Info Box ----------------------------------->
    <div class="bg-emerald-50 border border-emerald-600 rounded-xl px-5 py-4 shadow-sm">
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-emerald-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div>
                <p class="font-semibold text-gray-700 text-sm mb-2">تعليمات التقارير</p>
                <ul class="text-gray-500 text-sm space-y-1 list-disc list-inside">
                    <li>التقرير الأسبوعي يجب أن يتضمن ما تم إنجازه خلال هذا الأسبوع والتحديات التي واجهتك.</li>
                    <li>التقرير النهائي يجب أن يتضمن ملخصاً كاملاً للتدريب والمهارات المكتسبة.</li>
                    <li>سيتم تقييم التقارير من قبل مشرف التدريب في الجامعة.</li>
                </ul>
            </div>
        </div>
    </div>

</div>
