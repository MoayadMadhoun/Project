@page "{reportId:int}"
@using Project.Models
@model Project.Pages.Student.Reports.EditModel

@{
    ViewData["Title"] = "تعديل التقرير";
    ViewData["UserType"] = "Student";
}

<form method="post" enctype="multipart/form-data">

    <input asp-for="VM.ReportID" type="hidden" />
    <input asp-for="VM.StudentId" type="hidden" />

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#f59e0b;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        تعديل التقرير
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        يمكنك تعديل التقرير وإعادة إرساله للمراجعة.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-pencil-square fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Training Info -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">
                معلومات التدريب
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="text-muted">
                        فرصة التدريب
                    </label>

                    <div class="fw-semibold">
                        @Model.VM.OpportunityTitle
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        المؤسسة
                    </label>

                    <div class="fw-semibold">
                        @Model.VM.InstitutionName
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        المشرف الأكاديمي
                    </label>

                    <div class="fw-semibold">
                        @Model.VM.UniversitySupervisorName
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Report Details -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">
                بيانات التقرير
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label asp-for="VM.Type" class="form-label">
                        نوع التقرير
                    </label>

                    <select asp-for="VM.Type"
                            asp-items="Html.GetEnumSelectList<StudentReport.ReportType>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="VM.Type"
                          class="text-danger"></span>

                </div>

                <div class="col-md-8">

                    <label asp-for="VM.Title"
                           class="form-label">
                        عنوان التقرير
                    </label>

                    <input asp-for="VM.Title"
                           class="form-control" />

                    <span asp-validation-for="VM.Title"
                          class="text-danger"></span>

                </div>

                <div class="col-md-12">

                    <label asp-for="VM.Content"
                           class="form-label">
                        محتوى التقرير
                    </label>

                    <textarea asp-for="VM.Content"
                              rows="8"
                              class="form-control"></textarea>

                    <span asp-validation-for="VM.Content"
                          class="text-danger"></span>

                </div>

            </div>

        </div>

    </div>

    <!-- Current File -->
    @if (!string.IsNullOrEmpty(Model.VM.CurrentFilePath))
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white">

                <h5 class="fw-bold mb-0">
                    الملف الحالي
                </h5>

            </div>

            <div class="card-body">

                <a href="@Model.VM.CurrentFilePath"
                   target="_blank"
                   class="btn btn-outline-primary">

                    <i class="bi bi-file-earmark-text"></i>
                    عرض الملف الحالي

                </a>

            </div>

        </div>
    }

    <!-- Replace File -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                استبدال الملف
            </h5>

        </div>

        <div class="card-body">

            <div class="border rounded-4 p-5 text-center">

                <i class="bi bi-cloud-upload fs-1 text-warning"></i>

                <h5 class="mt-3">
                    رفع ملف جديد (اختياري)
                </h5>

                <p class="text-muted">
                    إذا لم تقم باختيار ملف جديد فسيتم الاحتفاظ بالملف الحالي.
                </p>

                <input asp-for="VM.ReportFile"
                       type="file"
                       class="form-control" />

                <span asp-validation-for="VM.ReportFile"
                      class="text-danger"></span>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-warning text-white px-5">

            <i class="bi bi-save me-2"></i>
            حفظ التعديلات

        </button>

        <a asp-page="/Student/Reports"
           class="btn btn-light px-5">

            إلغاء

        </a>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}