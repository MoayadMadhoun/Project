@page "{reportId:int}"
@model Project.Pages.Student.Reports.DeleteModel

@{
    ViewData["Title"] = "حذف التقرير";
}

<div class="max-w-2xl mx-auto">

    <div class="bg-white rounded-xl shadow-sm border p-6">

        <div class="text-center">

            <div class="mx-auto mb-4 w-20 h-20 rounded-full bg-red-100 flex items-center justify-center">
                <i class="bi bi-trash-fill text-danger text-3xl"></i>
            </div>

            <h2 class="text-xl font-bold mb-3">
                حذف التقرير
            </h2>

            <p class="text-slate-600 mb-4">
                هل أنت متأكد من حذف هذا التقرير؟
            </p>

            <div class="bg-slate-50 rounded-lg p-4 mb-4 text-right">

                <p>
                    <strong>العنوان:</strong>
                    @Model.Report.Title
                </p>

                <p>
                    <strong>النوع:</strong>
                    @Model.Report.Type
                </p>

                <p>
                    <strong>الحالة:</strong>
                    @Model.Report.Status
                </p>

            </div>

            <form method="post">

                <button type="submit"
                        class="btn btn-danger px-4">
                    <i class="bi bi-trash-fill"></i>
                    تأكيد الحذف
                </button>

                <a asp-page="/Student/Reports"
                   class="btn btn-secondary px-4">
                    إلغاء
                </a>

            </form>

        </div>

    </div>

</div>