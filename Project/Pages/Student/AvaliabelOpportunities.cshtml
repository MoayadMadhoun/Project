@page
@model Project.Pages.Student.AvaliabelOpportunitiesModel
@using Project.Models;

@{
    ViewData["Title"] = "الفرص التدريبية المتاحة";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "إدارة التدريب الأكاديمي";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
    ViewData["ActivePage"] = "Opportunities";
}

<link rel="stylesheet" href="~/Styles/opportunities.css">


@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">استكشف الفرص التدريبية</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            تصفح الفرص التدريبية المتاحة حسب تخصصاتك ومهاراتك وابدأ التقديم بسهولة.
        </p>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Filters Bar ===== *@

<div class="rounded-xl border border-primary-container/30 shadow-[0_4px_20px_rgba(26,188,156,0.15)] p-4 mb-lg bg-primary-container text-on-primary">
    <form method="get" class="flex flex-col lg:flex-row flex-wrap lg:flex-nowrap gap-3 items-stretch lg:items-center w-full">
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-white/70 text-lg">search</span>
            <input asp-for="search" class="w-full pr-10 pl-4 py-2.5 bg-white/95 border-none rounded-xl text-sm text-slate-800 focus:ring-2 focus:ring-white/40" placeholder="ابحث عن شركة أو تخصص..." type="text" />
        </div>
        <select asp-for="specialtyId" asp-items="@Model.Specialty" dir="rtl" class="flex-1 min-w-[140px] lg:flex-initial bg-white/95 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-white/40 cursor-pointer">
            <option value="">التخصص</option>
        </select>
        <select asp-for="location" asp-items="@Model.Location" class="flex-1 min-w-[140px] lg:flex-initial bg-white/95 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-white/40 cursor-pointer">
            <option value="">المدينة</option>  
        </select>
        <select asp-for="status" asp-items="@Html.GetEnumSelectList<Models.TrainingOpportunity.Opportunity>()" class="flex-1 min-w-[140px] lg:flex-initial bg-white/95 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-white/40 cursor-pointer">
            <option value="">حالة الفرصة</option>
          
        </select>
        <button type="submit" class="w-full lg:w-auto shrink-0 bg-white text-primary font-button px-6 py-2.5 rounded-xl hover:bg-surface-container transition-colors">بحث</button>
    </form>
</div>

@* ===== Opportunities Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
    <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
        <form method="get">
           <button type="submit"  class="text-primary text-sm font-bold hover:underline">عرض الكل</button>
        </form>
       
        <a class="font-h3 text-lg md:text-h3 text-slate-900" asp-page="/Student/AvaliabelOpportunities">الفرص التدريبية المتاحة</a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse min-w-[960px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">عنوان الفرصة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التخصص</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الموقع</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المدة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المقاعد</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">حالة الفرصة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>

                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @if (@Model.Opportunities != null)
                {
                
                 @foreach(var Opportunity in  @Model.Opportunities)
                 {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 text-sm text-slate-900">@Opportunity.TrainingInstitution.Name</td>
                        <td class="px-4 py-3 text-sm text-slate-900 font-bold">@Opportunity.Title</td>
                        <td class="px-4 py-3 text-sm text-slate-600">
                            @foreach (var sp in Opportunity.OpportunitySpecialties)
                            {
                                <span>@sp.Specialty.Name </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-600">@Opportunity.Location</td>
                        <td class="px-4 py-3 text-sm text-slate-600">@Model.GetDateOrMonth(@Opportunity)</td>
                        <td class="px-4 py-3 text-sm text-slate-600">@Opportunity.Capacity</td>
                        <td class="px-4 py-3">
                            @if (@Opportunity.Status == @Models.TrainingOpportunity.Opportunity.Open) { 
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-teal-100 text-primary"> مفتوحة</span> }
                                @if (@Opportunity.Status == @Models.TrainingOpportunity.Opportunity.Cancelled) { 
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-teal-100 text-primary">منتهية</span> }
                                @if (@Opportunity.Status == @Models.TrainingOpportunity.Opportunity.Closed) { 
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-teal-100 text-primary">مغلقة</span> }
                            </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2 items-center">

                             @if(!Model.AppliedIds.Contains(Opportunity.OpportunityID) && 
                             @Opportunity.Status == @Models.TrainingOpportunity.Opportunity.Open )
                                                         
                              {

                              <a asp-page="/Student/Applications/Create" asp-route-OpportunityId="@Opportunity.OpportunityID" 
                              class="bg-primary text-white text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-primary/90">تقديم </a>

                              }                               
                                <a href="#" class="text-primary text-xs font-bold hover:underline whitespace-nowrap">عرض التفاصيل</a>
                             </div>
                        </td>
                    </tr>
                 }
               }
                   
            </tbody>
        </table>
    </div>
    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">@Model.CurrentCount</span> من أصل <span class="font-bold text-slate-900">@Model.TotalCount</span> فرصة
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="pp-s">النتائج:</label>
                <select asp-for="PageSize" onchange="this.form.submit()" class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer" id="pp-s">
                    <option value="10">10</option><option value="25">25</option><option value="50">50</option>
                </select>
            </div>
        </div>
        <nav class="flex items-center gap-2">
            @if(@Model.Opportunities!=null){
            @if(@Model.Opportunities.HasPrevPage)
            {
                <a  asp-route-PageIndex="@(Model.PageIndex-1)"
                    asp-route-PageSize="@Model.PageSize" asp-route-location="@Model.location"  asp-route-specialtyId="@Model.specialtyId"
                   asp-route-status="@Model.status"   asp-route-search="@Model.search"
                      
                       
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_right</span>
                </a>
            }
            @for (int i = 1; i <= @Model.Opportunities.TotalPages; i++)
            {
                <a asp-route-PageIndex="@i"
                    asp-route-PageSize="@Model.PageSize" asp-route-location="@Model.location"  asp-route-specialtyId="@Model.specialtyId"
                   asp-route-status="@Model.status"   asp-route-search="@Model.search"
                    class="w-8 h-8 flex items-center justify-center rounded-lg @(@i == @Model.PageIndex ? "bg-primary" : "") text-white text-sm font-bold">@i</a>
            }
         
             @if(@Model.Opportunities.HasNextPage){
                 <a
                     asp-route-PageIndex="@(Model.PageIndex+1)"
                    asp-route-PageSize="@Model.PageSize" asp-route-location="@Model.location"  asp-route-specialtyId="@Model.specialtyId"
                   asp-route-status="@Model.status" asp-route-search="@Model.search" 
                     class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                  <span class="material-symbols-outlined">chevron_left</span></a>
             }
             }
        </nav>
    </div>
</div>
