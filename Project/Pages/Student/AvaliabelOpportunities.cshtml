@page
@model Project.Pages.Student.AvaliabelOpportunitiesModel
@{
    ViewData["Title"] = "الفرص التدريبية المتاحة";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "إدارة التدريب الأكاديمي";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
    ViewData["ActivePage"] = "Opportunities";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">


@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">استكشف الفرص التدريبية</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            تصفح الفرص التدريبية المتاحة حسب تخصصاتك ومهاراتك وابدأ التقديم بسهولة.
        </p>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Filters Bar ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div class="flex flex-wrap gap-3 items-center justify-end">
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن شركة أو تخصص..." type="text" />
        </div>
        <select dir="rtl" class="border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>التخصص</option>
            <option>هندسة البرمجيات</option>
            <option>نظم المعلومات</option>
            <option>تحليل البيانات</option>
            <option>الذكاء الاصطناعي</option>
            <option>شبكات</option>
        </select>
        <select class="border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>المدينة</option>
            <option>رام الله</option>
            <option>نابلس</option>
            <option>الخليل</option>
            <option>غزة</option>
        </select>
        <select class="border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>نوع التدريب</option>
            <option>تطوير برمجيات</option>
            <option>نظم معلومات</option>
            <option>تحليل بيانات</option>
        </select>
        <select class="border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>حالة الفرصة</option>
            <option>مفتوحة</option>
            <option>مغلقة</option>
            <option>قيد المراجعة</option>
        </select>
        <button class="bg-primary text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">بحث</button>
    </div>
</div>

