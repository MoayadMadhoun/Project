@page
@model Project.Pages.Student.AttendanceModel
@{
    ViewData["Title"] = "الحضور";
    ViewData["UserType"] = "Student";
    ViewData["ActivePage"] = "Attendance";
    Layout = "_Layout";

    string PageUrl(int page)
    {
        var qs = new System.Text.StringBuilder("?CurrentPage=").Append(page);
        if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            qs.Append("&SearchQuery=").Append(Uri.EscapeDataString(Model.SearchQuery));
        if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
            qs.Append("&StatusFilter=").Append(Uri.EscapeDataString(Model.StatusFilter));
        if (Model.TermFilter.HasValue)
            qs.Append("&TermFilter=").Append(Model.TermFilter.Value);
        return Url.Page("Attendance") + qs;
    }
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">الحضور</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90">
                استعراض سجلات حضورك أثناء فترة التدريب
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Filters Bar ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">
            <input type="hidden" name="CurrentPage" value="1" />

            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input type="text"
                       asp-for="SearchQuery"
                       value="@Model.SearchQuery"
                       class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                       placeholder="ابحث عن تدريب..." />
            </div>

            <select name="TermFilter"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer"
                    onchange="this.form.submit()">
                <option value="">جميع التدريبات</option>
                @if (Model.TermList != null && Model.TermList.Any())
                {
                    @foreach (var item in Model.TermList)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>

            <select name="StatusFilter"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer"
                    onchange="this.form.submit()">
                @foreach (var opt in Model.StatusOptions)
                {
                    <option value="@opt.Value" selected="@(opt.Value == Model.StatusFilter)">@opt.Text</option>
                }
            </select>

            <button type="submit"
                    class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
                بحث
            </button>
        </form>
    </div>

    @* ===== Attendance Table ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">

        <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-h3 text-lg md:text-h3 text-slate-900">سجلات الحضور</h3>
            @if (Model.TotalCount > 0)
            {
                <span class="text-sm text-slate-500 font-body-sm">
                    إجمالي <span class="font-bold text-slate-900">@Model.TotalCount</span> سجل
                </span>
            }
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[900px]">
                <thead class="bg-surface-container-low">
                    <tr>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps w-10">#</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التاريخ</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">وقت الدخول</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">وقت الخروج</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التدريب</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">مسجل بواسطة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">ملاحظات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model.Rows is { Count: > 0 })
                    {
                        @foreach (var row in Model.Rows)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">

                                <td class="px-4 py-3 text-sm text-slate-400 font-bold">@row.RowNumber</td>

                                <td class="px-4 py-3">
                                    <div class="text-sm font-bold text-slate-900">
                                        @row.AttendanceDate.ToString("yyyy-MM-dd")
                                    </div>
                                    <div class="text-xs text-slate-400">
                                        @row.AttendanceDate.ToString("dddd", new System.Globalization.CultureInfo("ar-SA"))
                                    </div>
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">@row.CheckInDisplay</td>

                                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">@row.CheckOutDisplay</td>

                                <td class="px-4 md:px-lg py-4 md:py-md">
                                    @{
                                        var (badgeBg, badgeLabel) = row.Status switch
                                        {
                                            "Present" => ("bg-green-100 text-green-700", "حاضر"),
                                            "Late"    => ("bg-amber-100 text-amber-700", "متأخر"),
                                            "Absent"  => ("bg-red-100 text-red-700",    "غائب"),
                                            "Excused" => ("bg-blue-100 text-blue-700",  "معذر"),
                                            _ => ("bg-slate-100 text-slate-600", row.Status)
                                        };
                                    }
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold @badgeBg">@badgeLabel</span>
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600">@row.TrainingTitle</td>

                                <td class="px-4 py-3 text-sm text-slate-600">
                                    @(!string.IsNullOrWhiteSpace(row.RecordedBy) && row.RecordedBy != "—"
                                        ? "أ. " + row.RecordedBy : "—")
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-400">
                                    @(string.IsNullOrWhiteSpace(row.Notes) ? "—" : row.Notes)
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center">
                                <i class="bi bi-calendar-x text-slate-300 text-4xl block mb-3"></i>
                                <p class="text-sm text-slate-400 mb-1">لا توجد سجلات حضور</p>
                                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) ||
                                     !string.IsNullOrWhiteSpace(Model.StatusFilter) ||
                                     Model.TermFilter.HasValue)
                                {
                                    <p class="text-xs text-slate-400">جرّب تغيير معايير التصفية</p>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ===== Pagination ===== *@
        @if (Model.TotalCount > 0)
        {
            <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">

                <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                    عرض
                    <span class="font-bold text-slate-900">@(((Model.CurrentPage - 1) * 8) + 1)</span>
                    إلى
                    <span class="font-bold text-slate-900">@(Math.Min(Model.CurrentPage * 8, Model.TotalCount))</span>
                    من <span class="font-bold text-slate-900">@Model.TotalCount</span> سجل
                </p>

                @if (Model.TotalPages > 1)
                {
                    <nav class="flex items-center gap-2">

                        @if (Model.CurrentPage > 1)
                        {
                            <a href="@PageUrl(Model.CurrentPage - 1)"
                               class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                                <span class="material-symbols-outlined">chevron_right</span>
                            </a>
                        }

                        @{
                            var showPages = Enumerable.Range(1, Model.TotalPages)
                                .Where(p => p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                                .ToList();
                        }

                        @for (int i = 0; i < showPages.Count; i++)
                        {
                            var p = showPages[i];
                            if (i > 0 && showPages[i] - showPages[i - 1] > 1)
                            {
                                <span class="text-slate-400 text-sm px-1">…</span>
                            }
                            <a href="@PageUrl(p)"
                               class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold
                                   @(p == Model.CurrentPage ? "bg-primary-container text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                                @p
                            </a>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a href="@PageUrl(Model.CurrentPage + 1)"
                               class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                                <span class="material-symbols-outlined">chevron_left</span>
                            </a>
                        }

                    </nav>
                }

            </div>
        }

    </div>

</div>