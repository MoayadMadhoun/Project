@page
@model Project.Pages.Student.AttendanceModel
@{
    ViewData["Title"] = "الحضور";
    Layout = "_Layout";

    string PageUrl(int page)
    {
        var qs = new System.Text.StringBuilder("?CurrentPage=").Append(page);
        if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            qs.Append("&SearchQuery=").Append(Uri.EscapeDataString(Model.SearchQuery));
        if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
            qs.Append("&StatusFilter=").Append(Uri.EscapeDataString(Model.StatusFilter));
        if (Model.TermFilter.HasValue)
            qs.Append("&TermFilter=").Append(Model.TermFilter.Value);
        return Url.Page("Attendance") + qs;
    }
}

@* ══════ HERO BANNER ══════ *@
<div class="rounded-4 mb-4 p-4 text-white position-relative overflow-hidden"
     style="background: linear-gradient(135deg, #1bafa4 0%, #1bafa4 100%); min-height: 120px;">

    @* {{-- decorative circles --}} *@
    <div class="position-absolute top-0 start-0 opacity-25"
         style="width:180px;height:180px;background:rgba(255,255,255,.15);border-radius:50%;transform:translate(-60px,-60px);"></div>
    <div class="position-absolute bottom-0 start-0 opacity-10"
         style="width:120px;height:120px;background:rgba(255,255,255,.2);border-radius:50%;transform:translate(-30px,40px);"></div>

    <div class="d-flex align-items-center justify-content-between position-relative">
        <div>
            <h3 class="fw-bold mb-1">الحضور</h3>
            <p class="mb-0 opacity-75 small">استعراض سجلات حضورك أثناء فترة التدريب.</p>
        </div>
        <div class="d-flex align-items-center justify-content-center rounded-3 opacity-75"
             style="width:56px;height:56px;background:rgba(255,255,255,.2);font-size:1.6rem;">
            <i class="bi bi-calendar-check-fill"></i>
        </div>
    </div>
</div>

@* ══════ FILTER BAR ══════ *@
<form method="get" class="mb-4">
    <div class="d-flex flex-wrap align-items-center gap-2">

        @* {{-- Training / Term filter --}} *@
        <div class="input-group shadow-sm" style="width:190px;">
            <select name="TermFilter" class="form-select form-select-sm border-none rounded-3 py-2" onchange="this.form.submit()">
                <option value="">جميع التدريبات</option>
                @if (Model.TermList?.Count() > 0)
                {
                    @foreach (var item in Model.TermList)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                }
            </select>
        </div>

        @* {{-- Status filter --}} *@
        <div class="input-group shadow-sm" style="width:170px;">
            <select name="StatusFilter" class="form-select form-select-sm border-none rounded-3 py-2" onchange="this.form.submit()">
                @foreach (var opt in Model.StatusOptions)
                {
                    <option value="@opt.Value" selected="@(opt.Value == Model.StatusFilter ? "selected" : null)">@opt.Text</option>
                }
            </select>
        </div>

        
        <div class="input-group ms-2 shadow-sm" style="max-width:300px;">
            <input type="text" asp-for="SearchQuery" value="@Model.SearchQuery"
                   class="form-control form-control-sm border-none rounded-3 py-2"
                   placeholder="ابحث عن تدريب..." />
            <button type="submit" class="btn btn-outline-secondary btn-sm border-none rounded-3">
                <i class="bi bi-search"></i>
            </button>
        </div>

        @* {{-- Filter button --}} *@
        <button type="submit" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-funnel-fill"></i>
            تصفية
        </button>

    </div>
    <input type="hidden" name="CurrentPage" value="1" />
</form>

@* ══════ TABLE ══════ *@
<div class="card border rounded-3 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center text-muted fw-semibold small ps-3" style="width:50px">#</th>
                        <th class="text-muted fw-semibold small">التاريخ</th>
                        <th class="text-muted fw-semibold small">وقت الدخول</th>
                        <th class="text-muted fw-semibold small">وقت الخروج</th>
                        <th class="text-muted fw-semibold small">الحالة</th>
                        <th class="text-muted fw-semibold small">التدريب</th>
                        <th class="text-muted fw-semibold small">مسجل بواسطة</th>
                        <th class="text-muted fw-semibold small">ملاحظات</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows is { Count: > 0 })
                    {
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="text-center text-muted fw-semibold small ps-3">@row.RowNumber</td>
                                <td>
                                    <div class="fw-semibold small">@row.AttendanceDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted" style="font-size:.75rem;">
                                        @row.AttendanceDate.ToString("dddd", new System.Globalization.CultureInfo("ar-SA"))
                                    </div>
                                </td>
                                <td class="small">@row.CheckInDisplay</td>
                                <td class="small">@row.CheckOutDisplay</td>
                                <td>
                                    @{
                                        var (bgColor, textColor, label) = row.Status switch
                                        {
                                            "Present" => ("#e6f7f5", "#1a9e8f", "حاضر"),
                                            "Late" => ("#fff8e1", "#e65100", "متأخر"),
                                            "Absent" => ("#fdecea", "#c62828", "غائب"),
                                            "Excused" => ("#e8eaf6", "#3949ab", "معذر"),
                                            _ => ("#f5f5f5", "#555", row.Status)
                                        };
                                    }
                                    <span class="badge rounded-pill fw-semibold px-3 py-2"
                                          style="background-color:@bgColor; color:@textColor; font-size:.78rem;">
                                        @label
                                    </span>
                                </td>
                                <td class="small">@row.TrainingTitle</td>
                                <td class="small">
                                    @(!string.IsNullOrWhiteSpace(row.RecordedBy) && row.RecordedBy != "—"
                                        ? "أ. " + row.RecordedBy : "—")
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrWhiteSpace(row.Notes) ? "—" : row.Notes)
                                </td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-light border rounded-2 p-1 lh-1"
                                            title="المزيد" style="width:28px;height:28px;">
                                        <i class="bi bi-three-dots-vertical small"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x d-block mb-2" style="font-size:2rem;"></i>
                                <span class="small">لا توجد سجلات حضور</span>
                                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) ||
                                     !string.IsNullOrWhiteSpace(Model.StatusFilter) ||
                                     Model.TermFilter.HasValue)
                                {
                                    <div class="small text-muted mt-1">جرّب تغيير معايير التصفية</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══════ FOOTER: count + pagination ══════ *@
@if (Model.TotalCount > 0)
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-3">

        @* {{-- Record count --}} *@
        <div class="text-muted small">
            عرض @(((Model.CurrentPage - 1) * 8) + 1)
            إلى @(Math.Min(Model.CurrentPage * 8, Model.TotalCount))
            من @Model.TotalCount سجل
            <select class="form-select form-select-sm d-inline-block w-auto ms-1" disabled>
                <option>8</option>
            </select>
        </div>

        @* {{-- Pagination --}} *@
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1">

                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-2 border" href="@PageUrl(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                    @{
                        var showPages = Enumerable.Range(1, Model.TotalPages)
                            .Where(p => p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                            .ToList();
                    }
                    @for (int i = 0; i < showPages.Count; i++)
                    {
                        var p = showPages[i];
                        if (i > 0 && showPages[i] - showPages[i - 1] > 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link border-0">…</span>
                            </li>
                        }
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link rounded-2 border" href="@PageUrl(p)">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-2 border" href="@PageUrl(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
}

@section Styles {
    <style>
        /* Active pagination color override to match teal theme */
        .page-item.active .page-link {
            background-color: #1a9e8f;
            border-color: #1a9e8f;
            color: #fff;
        }

        .page-link:hover {
            color: #1a9e8f;
        }

        .form-select:focus, .form-control:focus {
            border-color: #1a9e8f;
            box-shadow: 0 0 0 .2rem rgba(26,158,143,.2);
        }

        .btn-outline-secondary:hover {
            background-color: #f0f7f6;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
