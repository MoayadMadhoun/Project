@page
@model Project.Pages.Student.IndexModel
@{
    ViewData["Title"] = "لوحة تحكم الطالب";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "إدارة التدريب الأكاديمي";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";

}

@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-xxl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">مرحباً بك، أحمد محمد</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg md:mb-xl">
            استعد لرحلة التدريب الميداني، تابع طلباتك التدريبية، ارفع تقاريرك، وتواصل مع المشرفين بسهولة.
        </p>
        <div class="flex flex-col sm:flex-row gap-md">
            <button class="w-full sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors">استعراض الفرص</button>
            <button class="w-full sm:w-auto bg-primary/20 backdrop-blur-md border border-white/30 text-white font-button px-xl py-3 rounded-xl hover:bg-primary/30 transition-colors">إكمال الملف الشخصي</button>
        </div>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Summary Cards ===== *@
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-lg mb-lg md:mb-xl">
    <div class="bg-surface-container-lowest p-lg rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] hover:shadow-[0_8px_30px_rgba(44,62,80,0.08)] transition-all flex flex-col items-center justify-center text-center gap-sm">
        <div class="w-10 h-10 flex items-center justify-center bg-teal-50 rounded-lg"><span class="material-symbols-outlined text-primary">explore</span></div>
        <div><p class="text-slate-500 font-label-caps text-label-caps mb-xs">الفرص المتاحة</p><h3 class="text-slate-900 font-h3 text-h3">12 فرصة</h3></div>
    </div>
    <div class="bg-surface-container-lowest p-lg rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] flex flex-col items-center justify-center text-center gap-sm">
        <div class="w-10 h-10 flex items-center justify-center bg-blue-50 rounded-lg"><span class="material-symbols-outlined text-tertiary">assignment</span></div>
        <div><p class="text-slate-500 font-label-caps text-label-caps mb-xs">الطلبات المرسلة</p><h3 class="text-slate-900 font-h3 text-h3">4 طلبات</h3></div>
    </div>
    <div class="bg-surface-container-lowest p-lg rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] flex flex-col items-center justify-center text-center gap-sm">
        <div class="w-10 h-10 flex items-center justify-center bg-orange-50 rounded-lg"><span class="material-symbols-outlined text-orange-500">event_available</span></div>
        <div><p class="text-slate-500 font-label-caps text-label-caps mb-xs">نسبة الحضور</p><h3 class="text-slate-900 font-h3 text-h3">85%</h3></div>
    </div>
    <div class="bg-surface-container-lowest p-lg rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] flex flex-col items-center justify-center text-center gap-sm relative">
        <div class="w-10 h-10 flex items-center justify-center bg-purple-50 rounded-lg"><span class="material-symbols-outlined text-purple-500">work</span></div>
        <div><p class="text-slate-500 font-label-caps text-label-caps mb-xs">حالة التدريب</p><h3 class="text-slate-900 font-h3 text-h3">نشط</h3></div>
        <span class="absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-600">نشط</span>
    </div>
</div>

@* ===== Training Applications Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
    <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">سجل الطلبات التدريبية</h3>
        <button class="text-primary text-sm font-bold hover:underline">عرض الكل</button>
    </div>
    <div class="p-4 md:px-lg md:py-4 flex flex-col sm:flex-row gap-4 items-center justify-between border-b border-slate-50">
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-64">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input class="w-full pr-10 pl-4 py-2 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="بحث في الطلبات..." type="text" />
            </div>
            <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-sm font-bold">
                <span class="material-symbols-outlined text-lg">filter_list</span>تصفية
            </button>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse min-w-[600px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 md:px-lg py-3 md:py-md text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                    <th class="px-4 md:px-lg py-3 md:py-md text-slate-500 font-label-caps text-label-caps">تاريخ التقديم</th>
                    <th class="px-4 md:px-lg py-3 md:py-md text-slate-500 font-label-caps text-label-caps">حالة الطلب</th>
                    <th class="px-4 md:px-lg py-3 md:py-md text-slate-500 font-label-caps text-label-caps">نوع التدريب</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-900">شركة التقنية المتقدمة</td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">01-09-2024</td>
                    <td class="px-4 md:px-lg py-4 md:py-md"><span class="px-3 py-1 rounded-full text-[11px] font-bold bg-teal-100 text-primary">مقبول</span></td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">تطوير برمجيات</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-900">مستشفى المدينة</td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">15-08-2024</td>
                    <td class="px-4 md:px-lg py-4 md:py-md"><span class="px-3 py-1 rounded-full text-[11px] font-bold bg-blue-100 text-tertiary">قيد المراجعة</span></td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">نظم معلومات</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-900">بنك الاستثمار</td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">01-05-2025</td>
                    <td class="px-4 md:px-lg py-4 md:py-md"><span class="px-3 py-1 rounded-full text-[11px] font-bold bg-error-container text-error">مرفوض</span></td>
                    <td class="px-4 md:px-lg py-4 md:py-md font-body-md text-sm md:text-body-md text-slate-600">تحليل بيانات</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">3</span> من أصل <span class="font-bold text-slate-900">24</span> طلب
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="per-page-student">النتائج:</label>
                <select class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer" id="per-page-student">
                    <option value="10">10</option><option value="25">25</option><option value="50">50</option>
                </select>
            </div>
        </div>
        <nav class="flex items-center gap-2">
            <button class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_right</span></button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-white text-sm font-bold">1</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50">2</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50">3</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_left</span></button>
        </nav>
    </div>
</div>
