@page
@model Project.Pages.Student.MyApplicationsModel
@using Models.Enums;
@{
    ViewData["Title"] = "طلباتي";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "طلباتي التدريبية";
    ViewData["SearchPlaceholder"] = "بحث عن طلباتي...";
    ViewData["ActivePage"] = "MyApplications";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">طلباتي التدريبية</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            تابع حالة جميع طلبات التدريب التي قمت بتقديمها
        </p>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Application Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">

    <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">طلباتي</h3>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse min-w-[960px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الفرصة التدريبية</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ التقديم</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @if (Model.StudentApplications is not null)
                {
                    @foreach (var app in Model.StudentApplications)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">

                            <td class="px-4 py-3 text-sm text-slate-900 font-bold">
                                @(app.TrainingOpportunity?.Title ?? "—")
                            </td>

                            <td class="px-4 py-3 text-sm text-slate-600">
                                @(app.TrainingOpportunity?.TrainingInstitution?.Name ?? "—")
                            </td>

                            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">
                                @app.AppliedAt.ToString("dd-MM-yyyy")
                            </td>

                            <td class="px-4 md:px-lg py-4 md:py-md">
                                @{
                                    var (badgeBg, badgeIcon) = app.Status switch
                                    {
                                        Models.TrainingApplication.ApplicationStatus.Withdrawn =>
                                            ("bg-slate-100 text-slate-600", "remove"),

                                        Models.TrainingApplication.ApplicationStatus.Submitted or
                                        Models.TrainingApplication.ApplicationStatus.DepartmentApproved =>
                                            ("bg-blue-100 text-blue-700", "schedule"),

                                        Models.TrainingApplication.ApplicationStatus.DepartmentRejected or
                                        Models.TrainingApplication.ApplicationStatus.InstitutionRejected or
                                        Models.TrainingApplication.ApplicationStatus.UniversityRejected =>
                                            ("bg-red-100 text-red-700", "close"),

                                        Models.TrainingApplication.ApplicationStatus.Placed =>
                                            ("bg-green-100 text-green-700", "check_circle"),

                                        _ => ("bg-orange-100 text-orange-700", "info")
                                    };
                                }
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-bold @badgeBg">
                                    <span class="material-symbols-outlined text-sm">@badgeIcon</span>
                                    @app.Status.GetDisplayName()
                                </span>
                            </td>

                            <td class="px-4 py-3">
                                <a href="#"
                                   class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1 w-fit">
                                    <i class="bi bi-eye"></i>
                                    عرض التفاصيل
                                </a>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ===== Pagination ===== *@
    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">

        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">@Model.CurrentApplicationCount</span>
                من أصل <span class="font-bold text-slate-900">@Model.TotalApplicationCount</span> طلب
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="pp-s">النتائج:</label>
                <form method="get">
                    <select asp-for="PageSize"
                            onchange="this.form.submit()"
                            id="pp-s"
                            class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </form>
            </div>
        </div>

        <nav class="flex items-center gap-2">
            @if (Model.StudentApplications is not null)
            {
                @if (Model.StudentApplications.HasPrevPage)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                }

                @for (int i = 1; i <= Model.StudentApplications.TotalPages; i++)
                {
                    <a asp-route-PageIndex="@i"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold
                        @(i == Model.PageIndex ? "bg-primary-container text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                        @i
                    </a>
                }

                @if (Model.StudentApplications.HasNextPage)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                }
            }
        </nav>

    </div>

</div>