@page
@model Project.Pages.Student.MyApplicationsModel
@using Models.Enums;
@{
     ViewData["Title"] = "طلباتي";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "طلباتي التدريبية";
    ViewData["SearchPlaceholder"] = "بحث عن طلباتي...";
    ViewData["ActivePage"] = "MyApplications";
}

@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">طلباتي التدريبية</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
           تابع حالة جميع طلبات التدريب التي قمت بتقديمها
        </p>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>



@* ===== Application Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
    <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
       
        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">طلباتي</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse min-w-[960px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الفرصة التدريبية</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ التقديم</th>
                    
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة </th>
                    @*<th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">اخر تحديث</th>*@
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @if (Model.StudentApplications is not null)
                @foreach (var app in Model.StudentApplications)
                {

                   <tr class="hover:bg-slate-50 transition-colors">
                   
                    <td class="px-4 py-3 text-sm text-slate-900">@(app.TrainingOpportunity?.Title ?? "")</td>
                    <td class="px-4 py-3 text-sm text-slate-900">@(app.TrainingOpportunity?.TrainingInstitution?.Name??"")</td>
                    <td class="px-4 py-3 text-sm text-slate-600">@app.AppliedAt.ToString("dd-MM-yyyy")</td>
                    <td class="px-4 py-3">
                        <div class="inline-flex w-fit px-3 py-1 rounded-lg text-[11px] font-bold  
                        @(app.Status == Models.TrainingApplication.ApplicationStatus.Withdrawn ? "bg-slate-200 text-slate-700" : "")
                        @((app.Status == Models.TrainingApplication.ApplicationStatus.DepartmentApproved || app.Status == Models.TrainingApplication.ApplicationStatus.Submitted) ? " bg-blue-100 text-tertiary " : "")
                        @((app.Status == Models.TrainingApplication.ApplicationStatus.DepartmentRejected || app.Status == Models.TrainingApplication.ApplicationStatus.InstitutionRejected ||  app.Status == Models.TrainingApplication.ApplicationStatus.UniversityRejected) ? " bg-error-container text-error " : "")
                        @(app.Status == Models.TrainingApplication.ApplicationStatus.Placed ? "bg-teal-100 text-primary" : "")">
                        @if (app.Status == Models.TrainingApplication.ApplicationStatus.Withdrawn)
                        {
                            <span class="material-symbols-outlined text-sm pl-2 ">Remove</span>             
                        }
                        @if (app.Status == Models.TrainingApplication.ApplicationStatus.DepartmentApproved || app.Status == Models.TrainingApplication.ApplicationStatus.Submitted)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" class="pl-2 text-tertiary fill-current ">
                                <path d="m612-292 56-56-148-148v-184h-80v216l172 172ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-400Zm0 320q133 0 226.5-93.5T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 133 93.5 226.5T480-160Z" />
                            </svg>
                        }
                        @if (app.Status == Models.TrainingApplication.ApplicationStatus.DepartmentRejected || app.Status == Models.TrainingApplication.ApplicationStatus.InstitutionRejected || app.Status == Models.TrainingApplication.ApplicationStatus.UniversityRejected)
                        {
                               <span class="material-symbols-outlined text-sm pl-2 ">Close</span>
                        }
                        @if (app.Status == Models.TrainingApplication.ApplicationStatus.Placed)
                        {
                         <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" class="bg-teal-100 text-primary d-inline pl-2">
                             <path d="m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z" />
                         </svg>
     
                        }

                        <span>@app.Status.GetDisplayName()</span>
                        </div>
                     </td>
                   @*  <td class="px-4 py-3 text-sm">
                        <span class="text-slate-600 block">01-09-2025</span>
                        <span class="text-slate-500 text-xs block">منذ يوم</span>
                    </td> *@
                    <td class="px-4 py-3">
                        <a href="#"
                           class="text-teal-600 border border-teal-600 rounded-md px-3 py-2 hover:bg-teal-600/90 hover:text-white no-underline text-xs font-bold whitespace-nowrap inline-block">
                           <div class="row flex align-items-center">
                                <div class="col"><span class="material-symbols-outlined text-sm pl-2 ">visibility</span></div>
                                <div class="col">عرض التفاصيل</div>
                           </div>
                        </a>
                    </td>
                
                </tr>

                }
 
 
            </tbody>
        </table>
    </div>
    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">@Model.CurrentApplicationCount</span> من أصل <span class="font-bold text-slate-900">@Model.TotalApplicationCount</span> طلبات
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="pp-s">النتائج:</label>
                <form method="get">
                <select asp-for="PageSize"  onchange="this.form.submit()" class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer" id="pp-s">
                    <option value="10" >10</option>
                    <option  value="25">25</option>
                    <option value="50">50</option>
                </select>
                </form>
            </div>
        </div>
        <nav class="flex items-center gap-2">
            @if (Model.StudentApplications is not null){
            @if(Model.StudentApplications.HasPrevPage)
            {
              <a asp-route-PageIndex="@(Model.PageIndex-1)" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_right</span></a>
            }
            @for (int i=1; i<= @Model.StudentApplications.TotalPages; i++) { 
                <a asp-route-PageIndex="@i" class="w-8 h-8 flex items-center justify-center rounded-lg @(i == Model.PageIndex ? "bg-primary text-white" :"")  text-sm font-bold">@i</a>
            }
            @if (Model.StudentApplications.HasNextPage)
            {
                <a asp-route-PageIndex="@(Model.PageIndex + 1)" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_left</span></a>
                }
            }
        </nav>
    </div>
</div> 