@page
@model Project.Pages.Student.EvaluationsModel
@{
    ViewData["Title"] = "التقييمات";
    ViewData["UserType"] = "Student";
    ViewData["UserName"] = "أحمد محمد";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "إدارة التدريب الأكاديمي";
    ViewData["SearchPlaceholder"] = "بحث في المنصة...";
    ViewData["ActivePage"] = "Evaluations";
}
<link rel="stylesheet" href="~/css/Opportunities.css" />

@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right mb-3">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">التقييمات</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            عرض جميع التقييمات التي حصلت عليها خلال فترة التدريب
        </p>
    </div>
    @*    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div> *@
  
</section>



@* ===== Filters Bar ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div class="flex flex-wrap gap-3 items-end">

        <!-- Search -->
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن نقيم..." type="text" />
        </div>

     
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">حالة التقييم</label>
            <select dir="rtl" class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option>الكل</option>
                <option>أسبوعي</option>
                <option>نهائي</option>
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">نوع التقييم</label>
            <select dir="rtl" class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option>الكل</option>
                <option>أسبوعي</option>
                <option>نهائي</option>
            </select>
        </div>

        <!-- Status -->
        <div class="flex flex-col gap-1">
            <label class="text-xs text-gray-500">الجهة المقيمة</label>
            <select class="w-40 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option>الكل</option>
                <option>مقبول</option>
                <option>قيد المراجعة</option>
                <option>قيد المراجعة (مرفوض)</option>
                <option>لم يتم التسليم</option>
            </select>
        </div>

        <!-- Button -->
        <button class="bg-white text-emerald-600 border border-emerald-600 font-button px-6 py-2.5 rounded-xl hover:bg-emerald-50 transition-colors">
            فلترة
            <i class="bi bi-filter"></i>
        </button>

    </div>
</div>

