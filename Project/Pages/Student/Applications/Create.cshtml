@page
@model Project.Pages.Student.Applications.CreateModel

@{
    ViewData["Title"] = "التقديم على فرصة تدريب";
    ViewData["UserType"] = "Student";
    ViewData["PortalTitle"] = "بوابة الطالب";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث...";
}

<form method="post">

    <!-- Hero Section -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        التقديم على فرصة تدريب
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        قم بمراجعة بياناتك وإرسال طلب الالتحاق بالفرصة التدريبية.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-send-check-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Opportunity Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات الفرصة التدريبية
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="text-muted">
                        عنوان الفرصة
                    </label>

                    <div class="fw-semibold">
                        مطور Full Stack
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        المؤسسة
                    </label>

                    <div class="fw-semibold">
                        شركة التقنية المتقدمة
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        فترة التدريب
                    </label>

                    <div class="fw-semibold">
                        الفصل الثاني 2025
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        تاريخ البداية
                    </label>

                    <div class="fw-semibold">
                        01/07/2025
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        تاريخ النهاية
                    </label>

                    <div class="fw-semibold">
                        01/10/2025
                    </div>

                </div>

                <div class="col-md-12">

                    <label class="text-muted">
                        وصف الفرصة
                    </label>

                    <div>
                        تدريب عملي في تطوير تطبيقات الويب باستخدام .NET و Angular
                        مع فريق التطوير في المؤسسة.
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Student Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                بيانات الطالب
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label class="text-muted">
                        الاسم
                    </label>

                    <div class="fw-semibold">
                        محمد أحمد
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        الرقم الجامعي
                    </label>

                    <div class="fw-semibold">
                        20201234
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        المعدل
                    </label>

                    <div class="fw-semibold">
                        88.5
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        القسم
                    </label>

                    <div class="fw-semibold">
                        هندسة الحاسوب
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        التخصص
                    </label>

                    <div class="fw-semibold">
                        هندسة البرمجيات
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Student Notes -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                ملاحظات الطالب
            </h5>

        </div>

        <div class="card-body">

            <textarea class="form-control"
                      rows="6"
                      placeholder="أضف أي معلومات أو ملاحظات ترغب بإرسالها مع طلب التدريب..."></textarea>

        </div>

    </div>

    <!-- Workflow -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                مسار اعتماد الطلب
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4 text-center">

                <div class="col-md-4">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-person-workspace text-primary fs-1"></i>

                        <h6 class="mt-3">
                            رئيس القسم
                        </h6>

                        <p class="text-muted mb-0">
                            مراجعة الطلب والتأكد من أهلية الطالب.
                        </p>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-building-check text-success fs-1"></i>

                        <h6 class="mt-3">
                            مسؤول التدريب العام
                        </h6>

                        <p class="text-muted mb-0">
                            اعتماد الطلب من الجامعة.
                        </p>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-briefcase-fill text-danger fs-1"></i>

                        <h6 class="mt-3">
                            المؤسسة
                        </h6>

                        <p class="text-muted mb-0">
                            القبول النهائي للطالب داخل المؤسسة.
                        </p>

                    </div>

                </div>

            </div>

            <div class="text-center mt-4">

                <i class="bi bi-arrow-left-right fs-3 text-secondary"></i>

            </div>

        </div>

    </div>

    <!-- Important Note -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex align-items-start">

                <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>

                <div>

                    <h6 class="fw-bold">
                        ملاحظة مهمة
                    </h6>

                    <p class="mb-0 text-muted">

                        بعد إرسال الطلب ستصبح حالته
                        <span class="badge bg-warning text-dark">
                            Submitted
                        </span>

                        وسيتم تحويله تلقائياً إلى رئيس القسم لمراجعته.
                        لا يمكن تعديل الطلب بعد إرساله إلا إذا تم رفضه أو سحبه.

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Declaration -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       id="agree" />

                <label class="form-check-label"
                       for="agree">

                    أقر بأن جميع البيانات المقدمة صحيحة وأتحمل مسؤولية أي معلومات غير صحيحة.

                </label>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-send-fill me-1"></i>

            إرسال الطلب

        </button>

        <a href="#"
           class="btn btn-light px-5">

            <i class="bi bi-x-circle me-1"></i>

            إلغاء

        </a>

    </div>

</form>