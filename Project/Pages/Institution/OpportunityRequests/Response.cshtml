@page "{requestId:int}"
@model Project.Pages.Institution.OpportunityRequests.ResponseModel
@{
    ViewData["Title"] = "الاستجابة لطلب جامعة";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["ActivePage"] = "TrainingRequests";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">
    <form method="post">

        <input asp-for="Opportunity.RequestID" hidden />

        @* ===== Hero Section ===== *@
        <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
            <div class="relative z-10 max-w-2xl text-right">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-white/20 text-white mb-3">
                    استجابة لطلب جامعة
                </span>
                <h1 class="font-h1 text-2xl md:text-h1 mb-md">إنشاء فرصة تدريب</h1>
                <p class="font-body-lg text-sm md:text-body-lg opacity-90">
                    سيتم إنشاء فرصة تدريب مرتبطة بطلب الجامعة، وستكون متاحة فقط لطلاب هذه الجامعة.
                </p>
            </div>
            <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
        </section>

        @* ===== Info Alert ===== *@
        <div class="mb-lg px-4 py-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-700 text-sm font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-base">info</span>
            سيتمكن فقط طلاب <strong class="mx-1">@Model.Request.University.Name</strong> من مشاهدة هذه الفرصة والتقديم عليها.
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">

            @* ===== Left Column (Form) ===== *@
            <div class="lg:col-span-2 flex flex-col gap-lg">

                @* معلومات الفرصة *@
                <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
                    <div class="p-4 md:p-lg border-b border-slate-100">
                        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">معلومات الفرصة</h3>
                    </div>
                    <div class="p-4 md:p-lg flex flex-col gap-4">

                        <div class="flex flex-col gap-1">
                            <label asp-for="Opportunity.Title" class="text-sm font-bold text-slate-700"></label>
                            <input asp-for="Opportunity.Title"
                                   class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                            <span asp-validation-for="Opportunity.Title" class="text-xs text-red-500"></span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <label asp-for="Opportunity.Description" class="text-sm font-bold text-slate-700"></label>
                            <textarea asp-for="Opportunity.Description"
                                      rows="6"
                                      class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20 resize-none"></textarea>
                            <span asp-validation-for="Opportunity.Description" class="text-xs text-red-500"></span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <label asp-for="Opportunity.Location" class="text-sm font-bold text-slate-700">موقع التدريب</label>
                            <input asp-for="Opportunity.Location"
                                   class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                            <span asp-validation-for="Opportunity.Location" class="text-xs text-red-500"></span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                            <div class="flex flex-col gap-1">
                                <label asp-for="Opportunity.Capacity" class="text-sm font-bold text-slate-700"></label>
                                <input asp-for="Opportunity.Capacity"
                                       class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                                <span asp-validation-for="Opportunity.Capacity" class="text-xs text-red-500"></span>
                            </div>

                            <div class="flex flex-col gap-1">
                                <label asp-for="Opportunity.StartDate" class="text-sm font-bold text-slate-700">تاريخ البداية</label>
                                <input asp-for="Opportunity.StartDate"
                                       type="date"
                                       class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                                <span asp-validation-for="Opportunity.StartDate" class="text-xs text-red-500"></span>
                            </div>

                            <div class="flex flex-col gap-1">
                                <label asp-for="Opportunity.EndDate" class="text-sm font-bold text-slate-700">تاريخ النهاية</label>
                                <input asp-for="Opportunity.EndDate"
                                       type="date"
                                       class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                                <span asp-validation-for="Opportunity.EndDate" class="text-xs text-red-500"></span>
                            </div>

                        </div>

                        <input asp-for="Opportunity.TermID" hidden />

                    </div>
                </div>

                @* التخصصات المستهدفة *@
                <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
                    <div class="p-4 md:p-lg border-b border-slate-100">
                        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">
                            <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                            التخصصات المستهدفة
                        </h3>
                    </div>
                    <div class="p-4 md:p-lg">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            @for (int i = 0; i < Model.Opportunity.Specialties.Count; i++)
                            {
                                <label class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
                                    <input asp-for="Opportunity.Specialties[i].Selected"
                                           class="w-4 h-4 accent-primary cursor-pointer" />
                                    <input asp-for="Opportunity.Specialties[i].SpecialtyID" type="hidden" />
                                    <input asp-for="Opportunity.Specialties[i].SpecialtyName" type="hidden" />
                                    <span class="text-sm font-bold text-slate-700">
                                        @Model.Opportunity.Specialties[i].SpecialtyName
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                @* المهارات المطلوبة *@
                <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
                    <div class="p-4 md:p-lg border-b border-slate-100">
                        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">
                            <i class="bi bi-stars text-amber-500 me-2"></i>
                            المهارات المطلوبة
                        </h3>
                    </div>
                    <div class="p-4 md:p-lg flex flex-col gap-3">
                        @for (int i = 0; i < Model.Opportunity.Skills.Count; i++)
                        {
                            <div class="flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl">
                                <div class="flex items-center gap-3">
                                    <input asp-for="Opportunity.Skills[i].Selected"
                                           class="w-4 h-4 accent-primary cursor-pointer" />
                                    <input asp-for="Opportunity.Skills[i].SkillID" hidden />
                                    <input asp-for="Opportunity.Skills[i].SkillName" hidden />
                                    <span class="text-sm font-bold text-slate-700">
                                        @Model.Opportunity.Skills[i].SkillName
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input asp-for="Opportunity.Skills[i].IsRequired"
                                           class="w-4 h-4 accent-primary cursor-pointer" />
                                    <label class="text-xs text-slate-600 font-bold">مهارة إلزامية</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            @* ===== Right Column (Request Info) ===== *@
            <div class="lg:col-span-1">
                <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden sticky top-24">

                    <div class="p-4 md:p-lg border-b border-slate-100">
                        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">بيانات الطلب</h3>
                    </div>

                    <div class="p-4 md:p-lg flex flex-col gap-4">

                        <div class="flex flex-col gap-1">
                            <span class="text-xs text-slate-500 font-label-caps">الجامعة</span>
                            <span class="text-sm font-bold text-slate-900">@Model.Request.University.Name</span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <span class="text-xs text-slate-500 font-label-caps">الفترة التدريبية</span>
                            <span class="text-sm font-bold text-slate-900">@Model.Request.TrainingTerm.Name</span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <span class="text-xs text-slate-500 font-label-caps">المقاعد المطلوبة</span>
                            <span class="text-sm font-bold text-slate-900">@Model.Request.RequestedSeats</span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <span class="text-xs text-slate-500 font-label-caps">بداية التدريب</span>
                            <span class="text-sm font-bold text-slate-900">@Model.Request.PreferredStartDate?.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <span class="text-xs text-slate-500 font-label-caps">نهاية التدريب</span>
                            <span class="text-sm font-bold text-slate-900">@Model.Request.PreferredEndDate?.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="h-px bg-slate-100"></div>

                        <div class="px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-xs font-bold flex items-start gap-2">
                            <span class="material-symbols-outlined text-sm mt-0.5 flex-shrink-0">info</span>
                            سيتم نشر هذه الفرصة لطلاب <strong class="mx-1">@Model.Request.University.Name</strong> فقط.
                        </div>

                    </div>

                </div>
            </div>

        </div>

        @* ===== Submit Card ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 md:p-lg mt-lg">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <h3 class="font-h3 text-lg text-slate-900 mb-1">جاهز لنشر الفرصة؟</h3>
                    <p class="text-sm text-slate-500">
                        سيتم إنشاء فرصة تدريب مرتبطة بطلب الجامعة، ولن تظهر إلا لطلاب
                        <strong class="text-slate-700">@Model.Request.University.Name</strong>.
                    </p>
                </div>
                <div class="flex gap-3 flex-shrink-0">
                    <a asp-page="/Institution/OpportunityRequests/Details"
                       asp-route-requestId="@Model.Request.RequestID"
                       class="bg-slate-100 text-slate-600 font-button px-xl py-3 rounded-xl hover:bg-slate-200 transition-colors flex items-center gap-2">
                        <i class="bi bi-arrow-left"></i>
                        رجوع
                    </a>
                    <button type="submit"
                            id="btnCreate"
                            class="bg-primary-container text-white font-button px-xl py-3 rounded-xl hover:bg-primary/90 transition-colors flex items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        إنشاء الفرصة
                    </button>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        document.querySelector("form").addEventListener("submit", function () {
            const btn = document.getElementById("btnCreate");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جاري إنشاء الفرصة...';
        });

        const start = document.getElementById("Opportunity_StartDate");
        const end   = document.getElementById("Opportunity_EndDate");

        end.addEventListener("change", function () {
            if (start.value > end.value) {
                alert("يجب أن يكون تاريخ النهاية بعد البداية.");
                end.value = "";
            }
        });
    </script>
}