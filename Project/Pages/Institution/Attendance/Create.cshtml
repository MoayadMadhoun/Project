@page "{placementId:int}"
@model Project.Pages.Institution.Attendance.CreateModel

<div class="card shadow-sm border-0">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="{@Model.ErrorMessage == null ? display:none; : display:block;}"></div>

    <div class="card-header bg-success text-white">
        <h4 class="mb-0">تسجيل حضور الطالب</h4>
    </div>

    <div class="card-body">

        <form method="post">

            <input asp-for="Input.PlacementID" type="hidden" />

            <div class="mb-3">
                <label class="form-label">تاريخ الحضور</label>
                <input asp-for="Input.AttendanceDate"
                       type="date"
                       class="form-control" />

                <span class="text-danger" asp-validation-for="Input.AttendanceDate"></span>

            </div>

            <div class="mb-3">
                <label class="form-label">وقت الدخول</label>
                <input asp-for="Input.CheckInTime"
                       type="time"
                       class="form-control" />
                <span class="text-danger" asp-validation-for="Input.CheckInTime"></span>

            </div>

            <div class="mb-3">
                <label class="form-label">وقت الخروج</label>
                <input asp-for="Input.CheckOutTime"
                       type="time"
                       class="form-control" />

                <span class="text-danger" asp-validation-for="Input.CheckOutTime"></span>

            </div>

            <div class="mb-3">
                <label class="form-label">الحالة</label>

                <select asp-for="Input.Status"
                        class="form-select">

                    <option value="Present">حاضر</option>
                    <option value="Absent">غائب</option>
                    <option value="Late">متأخر</option>
                    <option value="Excused">بعذر</option>

                </select>

            </div>

            <div class="mb-3">
                <label class="form-label">ملاحظات</label>

                <textarea asp-for="Input.Notes"
                          rows="4"
                          class="form-control">
                </textarea>
                <span class="text-danger" asp-validation-for="Input.Notes"></span>

            </div>

            <button type="submit"
                    class="btn btn-success">

                حفظ الحضور

            </button>

        </form>

    </div>

</div>