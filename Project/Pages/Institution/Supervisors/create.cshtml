@page
@model Project.Pages.Institution.Supervisors.createModel
@{
    ViewData["Title"] = "إضافة مشرف مؤسسة";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث...";
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="{@Model.ErrorMessage == null ? display:none; : display:block;}"></div>
    <!-- Hero Section -->

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-5 text-white" style="background:#1ab29a;border-radius:24px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold mb-3">إضافة مشرف مؤسسة</h1>
                    <p class="mb-0 fs-5 opacity-75">
                        إضافة مشرف جديد للإشراف على الطلبة المتدربين داخل المؤسسة.
                    </p>
                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">
                    <i class="bi bi-person-plus-fill fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Supervisor Information -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">
                بيانات المشرف
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        الاسم الكامل
                    </label>
                    <input type="text"
                           asp-for="Input.FullName"
                           class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="أدخل الاسم الكامل" />

                    <span class="text-danger" asp-validation-for="Input.FullName"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        البريد الإلكتروني
                    </label>
                    <input type="email"
                           asp-for="Input.Email"
                           class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="example@company.com" />

                    <span class="text-danger" asp-validation-for="Input.Email"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        رقم الهاتف
                    </label>
                    <input type="text"
                           asp-for="Input.PhoneNumber"
                           class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="059xxxxxxx" />
                    <span class="text-danger" asp-validation-for="Input.PhoneNumber"></span>
                </div>

                @* <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        حالة الحساب
                    </label>

                    <select class="form-select shadow-sm rounded-3 bg-light border-0" asp-for="@Model.Input.IsActive">

                        <option selected>
                            فعال
                        </option>

                        <option>
                            غير فعال
                        </option>

                    </select>

                </div> *@

            </div>

        </div>

    </div>

    <!-- Account Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات الحساب
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="text-muted">
                        الدور
                    </label>

                    <div class="fw-semibold">
                        مشرف مؤسسة
                    </div>

                </div>

                @* <div class="col-md-4">

                    <label class="text-muted">
                        المؤسسة
                    </label>

                    <div class="fw-semibold">
                        @Model.
                    </div>

                </div> *@

                <div class="col-md-4">

                    <label class="text-muted">
                        طريقة الدخول
                    </label>

                    <div class="fw-semibold">
                        البريد الإلكتروني وكلمة المرور
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Process Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                إجراءات إنشاء الحساب
            </h5>

        </div>

        <div class="card-body">

            <div class="row text-center g-3">

                <div class="col-md-3">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-person-plus text-success fs-1"></i>

                        <h6 class="mt-3">
                            إنشاء المستخدم
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-shield-check text-primary fs-1"></i>

                        <h6 class="mt-3">
                            ربط الدور
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-key text-warning fs-1"></i>

                        <h6 class="mt-3">
                            إنشاء كلمة مرور
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4 h-100">

                        <i class="bi bi-envelope-check text-danger fs-1"></i>

                        <h6 class="mt-3">
                            إرسال التفعيل
                        </h6>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Notification Card -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex align-items-start">

                <i class="bi bi-info-circle-fill text-primary fs-2 me-3"></i>

                <div>

                    <h6 class="fw-bold mb-2">
                        ماذا سيحدث بعد الحفظ؟
                    </h6>

                    <ul class="mb-0">

                        <li>
                            إنشاء حساب جديد للمشرف.
                        </li>

                        <li>
                            ربط الحساب بالمؤسسة الحالية تلقائياً.
                        </li>

                        <li>
                            إسناد صلاحية مشرف مؤسسة.
                        </li>

                        <li>
                            توليد كلمة مرور عشوائية مكونة من 8 أرقام.
                        </li>

                        <li>
                            توليد كود تفعيل للحساب.
                        </li>

                        <li>
                            إرسال بيانات الدخول إلى البريد الإلكتروني.
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

    <!-- Email Preview -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معاينة البريد الإلكتروني
            </h5>

        </div>

        <div class="card-body">

            <div class="border rounded-4 p-4 bg-light">

                <p>
                    مرحباً أحمد محمد
                </p>

                <p>
                    تم إنشاء حسابك بنجاح على منصة التدريب الميداني.
                </p>

                <p>
                    البريد الإلكتروني:
                    ahmad@company.com
                </p>

                <p>
                    كلمة المرور:
                    ********
                </p>

                <p>
                    كود التفعيل:
                    ****** 
                </p>

                <p class="mb-0">
                    يرجى تسجيل الدخول وإدخال كود التفعيل لتفعيل الحساب.
                </p>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-person-check-fill me-1"></i>

            إنشاء المشرف

        </button>

        <a asp-page="/Institution/Supervisors"
           class="btn btn-light px-5">

            <i class="bi bi-x-circle me-1"></i>

            إلغاء

        </a>

    </div>

</form>