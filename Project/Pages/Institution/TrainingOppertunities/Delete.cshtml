@page "{id:int}"
@model Project.Pages.Institution.TrainingOppertunities.DeleteModel

@{
    ViewData["Title"] = "إلغاء فرصة تدريبية";
}

<form method="post">

    <input type="hidden" asp-for="OpportunityId" />

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#dc3545;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        إلغاء فرصة تدريبية
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        سيتم إلغاء الفرصة وإخفاؤها من قائمة الفرص المتاحة للطلاب.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle
                    d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-trash-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Warning -->

    <div class="alert alert-danger shadow-sm border-0 mb-4">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        هل أنت متأكد من إلغاء هذه الفرصة التدريبية؟

    </div>

    <!-- Opportunity Details -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                بيانات الفرصة
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="text-muted">
                        عنوان الفرصة
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.Title
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        المؤسسة
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.TrainingInstitution?.Name
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        عدد المقاعد
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.Capacity
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        مكان التدريب
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.Location
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        تاريخ البداية
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.StartDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="text-muted">
                        تاريخ النهاية
                    </label>

                    <div class="fw-semibold">
                        @Model.Opportunity?.EndDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Notes -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <ul class="mb-0">

                <li>
                    لن يتم حذف الفرصة من قاعدة البيانات.
                </li>

                <li>
                    سيتم تغيير الحالة إلى "ملغاة".
                </li>

                <li>
                    لن تظهر للطلاب بعد الآن.
                </li>

                <li>
                    ستبقى جميع الطلبات المرتبطة بها محفوظة.
                </li>

            </ul>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-danger px-5">

            <i class="bi bi-trash-fill me-1"></i>

            إلغاء الفرصة

        </button>

        <a asp-page="Index"
           class="btn btn-light px-5">

            رجوع

        </a>

    </div>

</form>