@page
@model CreateModel
@{
    ViewData["Title"] = "إضافة فرصة تدريبية";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة المتدربين والفرص";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، طلبات...";
    ViewData["ActivePage"] = "Opportunities";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">
    <form method="post">

        @* ===== Hero Section ===== *@
        <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
            <div class="relative z-10 max-w-2xl text-right">
                <h1 class="font-h1 text-2xl md:text-h1 mb-md">إضافة فرصة تدريبية</h1>
                <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
                    إنشاء فرصة تدريب جديدة وإتاحتها للطلبة خلال فترة التدريب المحددة.
                </p>
            </div>
            <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
        </section>

        @* ===== معلومات المؤسسة ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">معلومات المؤسسة</h3>
            </div>
            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="flex flex-col gap-1">
                        <span class="text-xs text-slate-500 font-label-caps">المؤسسة</span>
                        <span class="text-sm font-bold text-slate-900">@Model.CurrentInstitution?.Name</span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs text-slate-500 font-label-caps">مسؤول التدريب</span>
                        <span class="text-sm font-bold text-slate-900">@User.Identity?.Name</span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs text-slate-500 font-label-caps">فترة التدريب الحالية</span>
                        <span class="text-sm font-bold text-slate-900">الفصل الأول 2026</span>
                    </div>
                </div>
            </div>
        </div>

        @* ===== تفاصيل الفرصة ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">تفاصيل الفرصة</h3>
            </div>
            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

                    <div class="flex flex-col gap-1 md:col-span-8">
                        <label asp-for="Input.Title" class="text-sm font-bold text-slate-700"></label>
                        <input asp-for="Input.Title"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                        <span asp-validation-for="Input.Title" class="text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-1 md:col-span-4">
                        <label asp-for="Input.Capacity" class="text-sm font-bold text-slate-700"></label>
                        <input asp-for="Input.Capacity"
                               type="number"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                        <span asp-validation-for="Input.Capacity" class="text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-1 md:col-span-12">
                        <label asp-for="Input.Location" class="text-sm font-bold text-slate-700"></label>
                        <input asp-for="Input.Location"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                        <span asp-validation-for="Input.Location" class="text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-1 md:col-span-12">
                        <label asp-for="Input.Description" class="text-sm font-bold text-slate-700"></label>
                        <textarea asp-for="Input.Description"
                                  rows="5"
                                  class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20 resize-none"></textarea>
                        <span asp-validation-for="Input.Description" class="text-xs text-red-500"></span>
                    </div>

                </div>
            </div>
        </div>

        @* ===== التخصصات المستهدفة ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">التخصصات المستهدفة</h3>
            </div>
            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    @foreach (var item in Model.Specialties)
                    {
                        <label for="specialty_@item.Value"
                               class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
                            <input class="w-4 h-4 accent-primary cursor-pointer"
                                   type="checkbox"
                                   name="Input.SelectedSpecialties"
                                   value="@item.Value"
                                   id="specialty_@item.Value" />
                            <span class="text-sm font-bold text-slate-700">@item.Text</span>
                        </label>
                    }
                </div>
            </div>
        </div>
        <span asp-validation-for="Input.SelectedSpecialties"
              class="text-danger text-sm mt-2 d-block"></span>

        @* ===== المهارات المطلوبة ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">المهارات المطلوبة</h3>
            </div>
            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var skill in Model.Skills)
                    {
                        <div class="flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl">
                            <div class="flex items-center gap-3">
                                <input type="checkbox"
                                       name="Input.SelectedSkills"
                                       value="@skill.SkillID"
                                       class="w-4 h-4 accent-primary cursor-pointer" />
                                <span class="text-sm font-bold text-slate-700">@skill.Name</span>
                            </div>
                            <select name="Input.SkillTypes[@skill.SkillID]"
                                    class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 px-3 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                                <option value="true">أساسية</option>
                                <option value="false">مفضلة</option>
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>
        <span asp-validation-for="Input.SelectedSkills"
              class="text-danger text-sm mt-2 d-block"></span>

        @* ===== فترة التدريب ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">فترة التدريب</h3>
            </div>
            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-bold text-slate-700">فترة التدريب</label>
                        <select asp-for="Input.TermId"
                                asp-items="Model.Terms"
                                class="w-full bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                            <option value="">اختر الفترة</option>
                        </select>
                        <a asp-page="/CommonPages/TrainingTerm/Create"
                           class="btn border border-primary text-primary text-xs font-bold px-3 py-2 rounded hover:bg-blue-50 flex items-center gap-1 w-fit mt-1">
                            <i class="bi bi-plus-lg"></i> إنشاء فترة
                        </a>
                        <span asp-validation-for="Input.TermId" class="text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label asp-for="Input.StartDate" class="text-sm font-bold text-slate-700"></label>
                        <input asp-for="Input.StartDate"
                               type="date"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.StartDate" class="text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label asp-for="Input.EndDate" class="text-sm font-bold text-slate-700"></label>
                        <input asp-for="Input.EndDate"
                               type="date"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.EndDate" class="text-xs text-red-500"></span>
                    </div>

                </div>
            </div>
        </div>

        @* ===== نوع الفرصة ===== *@
        @* <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">نوع الفرصة</h3>
            </div>
            <div class="p-4 md:p-lg flex flex-col gap-4">

                <label class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
                    <input class="w-4 h-4 accent-primary cursor-pointer"
                           type="radio"
                           name="OpportunityType"
                           id="Direct"
                           checked />
                    <div>
                        <div class="text-sm font-bold text-slate-700">فرصة مباشرة من المؤسسة</div>
                    </div>
                </label>

                <label class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
                    <input class="w-4 h-4 accent-primary cursor-pointer"
                           type="radio"
                           name="OpportunityType"
                           id="RequestBased" />
                    <div>
                        <div class="text-sm font-bold text-slate-700">استجابة لطلب جامعة أو قسم</div>
                    </div>
                </label>

                <div class="flex flex-col gap-1">
                    <label class="text-sm font-bold text-slate-700">الطلب المرتبط</label>
                    <select asp-for="Input.RequestId"
                            class="w-full md:w-1/2 bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                        <option value="">اختر الطلب</option>
                    </select>
                </div>

            </div>
        </div> *@

        @* ===== حالة الفرصة ===== *@
        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">
            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">حالة الفرصة</h3>
            </div>
            <div class="p-4 md:p-lg">
                <select asp-for="Input.Status"
                        class="w-full md:w-1/3 bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                    @foreach (var item in Html.GetEnumSelectList<ViewModels.AddTrainingOpportunityVM.Opportunity>())
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="Input.Status" class="text-xs text-red-500 block mt-1"></span>
            </div>
        </div>

        @* ===== Buttons ===== *@
        <div class="flex gap-3 mb-lg">
            <button type="submit"
                    class="bg-primary-container text-white font-button px-xl py-3 rounded-xl hover:bg-primary/90 transition-colors flex items-center gap-2">
                <i class="bi bi-check-circle"></i>
                حفظ الفرصة
            </button>
            <a asp-page="/Institution/AvailableOpportunities"
               class="bg-slate-100 text-slate-600 font-button px-xl py-3 rounded-xl hover:bg-slate-200 transition-colors flex items-center gap-2">
                <i class="bi bi-x-circle"></i>
                إلغاء
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}