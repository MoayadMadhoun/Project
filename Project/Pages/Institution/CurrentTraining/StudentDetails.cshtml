@page
@model Project.Pages.Institution.CurrentTraining.StudentDetailsModel

@{
    ViewData["Title"] = "متابعة الطالب";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "متابعة المتدربين";
}

<div class="mb-4">
    <a asp-page="/Institution/CurrentTraining"
       class="text-decoration-none text-success fw-semibold">

        <i class="bi bi-arrow-right"></i>
        الرجوع للتدريبات الحالية

    </a>
</div>

<!-- Hero -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-5 text-white"
         style="background:#1ab29a;border-radius:24px;">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>

                <h1 class="fw-bold mb-2">
                    @Model.StudentName
                </h1>

                <p class="fs-5 mb-2 opacity-75">
                    @Model.OpportunityTitle
                </p>

                <p class="mb-0 opacity-75">
                    @Model.InstitutionName
                </p>

            </div>

            <div class="text-center">

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-person-workspace fs-1"></i>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Student Info -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            معلومات الطالب
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-4">
                <label class="text-muted">الاسم</label>
                <div class="fw-semibold">@Model.StudentName</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">الرقم الجامعي</label>
                <div class="fw-semibold">@Model.StudentNumber</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">التخصص</label>
                <div class="fw-semibold">@Model.Specialty</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">المعدل</label>
                <div class="fw-semibold">@Model.GPA</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">البريد الإلكتروني</label>
                <div class="fw-semibold">@Model.Email</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">رقم الهاتف</label>
                <div class="fw-semibold">@Model.PhoneNumber</div>
            </div>

        </div>

    </div>

</div>

<!-- Training Info -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            معلومات التدريب
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-4">
                <label class="text-muted">الفرصة التدريبية</label>
                <div class="fw-semibold">@Model.OpportunityTitle</div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">تاريخ البداية</label>
                <div class="fw-semibold">
                    @Model.StartDate.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">تاريخ النهاية</label>
                <div class="fw-semibold">
                    @Model.EndDate.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">المشرف المؤسسي</label>
                <div class="fw-semibold">
                    @Model.InstitutionSupervisor
                </div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">المشرف الجامعي</label>
                <div class="fw-semibold">
                    @Model.UniversitySupervisor
                </div>
            </div>

            <div class="col-md-4">
                <label class="text-muted">حالة التدريب</label>
                <div class="fw-semibold text-success">
                    نشط
                </div>
            </div>

        </div>

    </div>

</div>

<!-- Statistics -->

<div class="row g-4 mb-4">

    <div class="col-md-3">

        <div class="card border-0 shadow-sm text-center h-100">

            <div class="card-body">

                <i class="bi bi-file-earmark-text fs-1 text-success"></i>

                <h3 class="mt-3">
                    @Model.ReportsCount
                </h3>

                <div class="text-muted">
                    التقارير
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm text-center h-100">

            <div class="card-body">

                <i class="bi bi-star-fill fs-1 text-warning"></i>

                <h3 class="mt-3">
                    @Model.EvaluationsCount
                </h3>

                <div class="text-muted">
                    التقييمات
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm text-center h-100">

            <div class="card-body">

                <i class="bi bi-calendar-check fs-1 text-primary"></i>

                <h3 class="mt-3">
                    @Model.AttendanceCount
                </h3>

                <div class="text-muted">
                    أيام الحضور
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm text-center h-100">

            <div class="card-body">

                <i class="bi bi-calendar-x fs-1 text-danger"></i>

                <h3 class="mt-3">
                    @Model.AbsentCount
                </h3>

                <div class="text-muted">
                    أيام الغياب
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Quick Actions -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            الإجراءات السريعة
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-4">

                <a asp-page="/Institution/Attendance/Create"
                   asp-route-placementId="@Model.PlacementID"
                   class="btn btn-success w-100 py-3">

                    <i class="bi bi-calendar-check me-2"></i>

                    تسجيل حضور

                </a>

            </div>

            <div class="col-md-4">

                <a asp-page="/Institution/Reports/Create"
                   asp-route-placementId="@Model.PlacementID"
                   class="btn btn-primary w-100 py-3">

                    <i class="bi bi-file-earmark-arrow-up me-2"></i>

                    رفع تقرير

                </a>

            </div>

            <div class="col-md-4">

                <a asp-page="/Institution/Evaluations/Create"
                   asp-route-placementId="@Model.PlacementID"
                   class="btn btn-warning w-100 py-3">

                    <i class="bi bi-star-fill me-2"></i>

                    تقييم الطالب

                </a>

            </div>

        </div>

    </div>

</div>

<!-- Records -->

<div class="row g-4">

    <div class="col-md-4">

        <a asp-page="/Institution/Reports/Index"
           asp-route-studentId="@Model.StudentID"
           class="card text-center text-decoration-none border-0 shadow-sm h-100">

            <div class="card-body py-5">

                <i class="bi bi-file-earmark-text fs-1 text-success"></i>

                <h5 class="mt-3 text-dark">
                    عرض التقارير
                </h5>

                <p class="text-muted mb-0">
                    مراجعة جميع تقارير الطالب
                </p>

            </div>

        </a>

    </div>

    <div class="col-md-4">

        <a asp-page="/Institution/Attendance/Index"
           asp-route-studentId="@Model.StudentID"
           class="card text-center text-decoration-none border-0 shadow-sm h-100">

            <div class="card-body py-5">

                <i class="bi bi-calendar-check fs-1 text-primary"></i>

                <h5 class="mt-3 text-dark">
                    عرض الحضور
                </h5>

                <p class="text-muted mb-0">
                    مراجعة سجلات الحضور والغياب
                </p>

            </div>

        </a>

    </div>

    <div class="col-md-4">

        <a asp-page="/Institution/Evaluations/Index"
           asp-route-studentId="@Model.StudentID"
           class="card text-center text-decoration-none border-0 shadow-sm h-100">

            <div class="card-body py-5">

                <i class="bi bi-star-fill fs-1 text-warning"></i>

                <h5 class="mt-3 text-dark">
                    عرض التقييمات
                </h5>

                <p class="text-muted mb-0">
                    مراجعة جميع تقييمات الطالب
                </p>

            </div>

        </a>

    </div>

</div>