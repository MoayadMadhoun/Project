@page
@using Microsoft.AspNetCore.Html
@model Project.Pages.Institution.ReportsModel
@{
    ViewData["Title"] = "لوحة تحكم المؤسسة";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة المتدربين والفرص";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، طلبات...";
    int RIndex = 1;
}
@functions {
    public IHtmlContent SortingIcon(string column, string currentSort)
    {
        if (currentSort == column)
            return new HtmlString("<span><i class=\"bi bi-caret-up-fill\"></i></span>");

        if (currentSort == column + "_desc")
            return new HtmlString("<span><i class=\"bi bi-caret-down-fill\"></i></span>");

        return new HtmlString("<span><i class=\"bi bi-arrow-down-up\"></i></span>");
    }

}
<link rel="stylesheet" href="~/Styles/Reports.css" />
<main class="main-content">

    <!-- Hero Banner -->
    <!-- Hero Banner -->
    <div class="hero-banner">
        <div class="hero-text">
            <div class="hero-title">التقارير</div>
            <div class="hero-subtitle">
                متابعة التقارير التي تطلبها الجامعة من مؤسستكم<br />
                وتعبئتها وإرسالها للجامعة.
            </div>
        </div>
        <div class="hero-illustration">
            <div class="hero-doc-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="clip-wrap" style="position:relative;">
                <div class="clip-board">
                    <div class="clip-top"></div>
                    <div class="clip-line"></div>
                    <div class="clip-line short"></div>
                    <div class="clip-line"></div>
                    <div class="clip-line short"></div>
                </div>
                <div class="check-badge"><i class="bi bi-check-lg"></i></div>
            </div>
            <div class="folder-icon"></div>
        </div>

       
    </div>  <!-- ← closing tag was here before, now moved to end -->
    <!-- Filter Bar -->
   <form method="get">
        <div class="filter-bar">

    
            <div class="filter-search">
                <input asp-for="SearchTerm" type="text" placeholder="ابحث عن طالب أو تقرير..." />
                <i class="bi bi-search"></i>
            </div>

            <select asp-for="SelectedReportStatus" asp-items="Model.ReportStatusList" class="filter-select" style="max-width:200px;">
                <option value="-1"></option>
            </select>

            <select asp-for="SelectedReportType" class="filter-select" style="max-width:200px;">
                <option value="0">جميع أنواع التقارير</option>
                <option value="1">تقرير اسبوعي</option>
                <option value="2">تقرير نهائي</option>
            </select>
            <button type="submit" class="filter-btn">
                <i class="bi bi-funnel"></i>
                تصفية
            </button>
        </div>

   </form>
    <!-- Table Card -->
    <div class="table-card">
        <div class="table-card-header">
            <div style="flex:1; text-align:right;">
                <div class="table-card-title">التقارير المطلوبة من الجامعة</div>
            </div>
            <div class="table-header-icon"><i class="bi bi-building-fill-check"></i></div>
        </div>
        <div class="table-card-subtitle">
            هذه هي التقارير التي تطلبها الجامعة منكم خلال فترة التدريب.
        </div>

        <div class="table-responsive">
            <table class="reports-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>
                            <a class="text-decoration-none"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-PageIndex="@(Model.PageIndex)"
                                   asp-route-SortOrder="@(Model.SortOrder == "Name" ? "Name_desc" : "Name")">
                                الطالب @SortingIcon("Name", Model.SortOrder)
                            </a>
                        </th>
                        <th>نوع التقرير</th>
                        <th>التدريب</th>
                        <th>تاريخ الارسال </th>
                        <th>حالة التقرير</th>
                        <th>ملف مرفق</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    
                        @if (!Model.Reports.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-6 text-center text-slate-500">
                                    لا توجد تقارير لعرضها.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach(var report in Model.Reports)
                            {
                            <tr>
                                <td>@RIndex</td>
                                <td class="td-name">@(report.Student.Name??"_")</td>
                                <td>@report.Type</td>
                                <td class="td-link"> @(report.Placement.TrainingOpportunity.Title??"_")</td>
                                <td>@report.SubmittedAt</td>
                                <td><span class="badge-waiting">@report.Status</span></td>
                                <td><span style="color:#ccc;">@report.FilePath</span></td>
                                <td><span class="three-dots">⋮</span></td>
                            </tr>
                            @(RIndex+1)
                            }
                        }
                    
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination-bar">
            <div class="pagination-info">
                عرض @((Model.Reports.PageSize * (Model.Reports.PageIndex - 1)) + 1) إلى @Model.Reports.Count() من @Model.Reports.TotalCount تقرير
                <form>
                    <select asp-for="PageSize"
                            onchange="this.form.submit()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </form>
                <i class="bi bi-chevron-down" style="font-size:11px;"></i>
            </div>
            <div class="pagination-pages">
                
                    @if (Model.Reports.HasPrevPage)
                    {
                        <a asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageIndex="@(Model.PageIndex - 1)"
                       class="page-btn page-arrow"><i class="bi bi-chevron-right"></i></a>
                    }
           
                    @for (int i = 1; i <= Model.Reports.TotalPages; i++)
                    {

                        <a asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageIndex="@i"
                       class="page-btn  @(Model.PageIndex == i ? "Active" : " ")  text-white text-sm font-bold">@i</a>
                }

                    @if (Model.Reports.HasNextPage)
                    {
                        <a asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageIndex="@(Model.PageIndex + 1)"
                       class="page-btn page-arrow"><i class="bi bi-chevron-left"></i></a>
                    }
              
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div>جميع الحقوق محفوظة © 2024 • بوابة التدريب الميداني</div>
        <div style="display:flex; gap:18px;">
            <a href="#">Technical Support</a>
            <a href="#">Terms of Service</a>
            <a href="#">Privacy Policy</a>
        </div>
    </footer>

</main>

