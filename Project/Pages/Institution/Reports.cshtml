@page
@using Microsoft.AspNetCore.Html
@model Project.Pages.Institution.ReportsModel
@{
    ViewData["Title"] = "التقارير";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة المتدربين والفرص";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، طلبات...";
    ViewData["ActivePage"] = "Reports";
    int RIndex = 1;
}
@functions {
    public IHtmlContent SortingIcon(string column, string currentSort)
    {
        if (currentSort == column)
            return new HtmlString("<i class=\"bi bi-caret-up-fill text-primary text-xs\"></i>");
        if (currentSort == column + "_desc")
            return new HtmlString("<i class=\"bi bi-caret-down-fill text-primary text-xs\"></i>");
        return new HtmlString("<i class=\"bi bi-arrow-down-up text-slate-400 text-xs\"></i>");
    }
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">التقارير</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
                متابعة التقارير التي تطلبها الجامعة من مؤسستكم وتعبئتها وإرسالها للجامعة.
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Filters Bar ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">

            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input asp-for="SearchTerm"
                       type="text"
                       placeholder="ابحث عن طالب أو تقرير..."
                       class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
            </div>

            <select asp-for="SelectedReportStatus"
                    asp-items="Model.ReportStatusList"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">كل الحالات</option>
            </select>

            <select asp-for="SelectedReportType"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">جميع الأنواع</option>
                <option value="1">تقرير أسبوعي</option>
                <option value="2">تقرير نهائي</option>
            </select>

            <button type="submit"
                    class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
                بحث
            </button>

        </form>
    </div>

    @* ===== Reports Table ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">

        <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-h3 text-lg md:text-h3 text-slate-900">التقارير المطلوبة من الجامعة</h3>
            <span class="text-sm text-slate-500 font-body-sm">
                إجمالي <span class="font-bold text-slate-900">@Model.Reports.TotalCount</span> تقرير
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[960px]">
                <thead class="bg-surface-container-low">
                    <tr>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">#</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">
                            <a class="flex items-center gap-1 text-slate-500 hover:text-primary transition-colors no-underline"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-studentId="@Model.StudentId"
                               asp-route-placementId="@Model.PlacementId"
                               asp-route-PageIndex="@Model.PageIndex"
                               asp-route-SortOrder="@(Model.SortOrder == "Name" ? "Name_desc" : "Name")">
                                الطالب @SortingIcon("Name", Model.SortOrder)
                            </a>
                        </th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">نوع التقرير</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التدريب</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ الإرسال</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">حالة التقرير</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">ملف مرفق</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">

                    @if (!Model.Reports.Any())
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-400">
                                لا توجد تقارير لعرضها
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var report in Model.Reports)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">

                                <td class="px-4 py-3 text-sm text-slate-400 font-bold">@RIndex</td>

                                <td class="px-4 py-3 text-sm text-slate-900 font-bold">
                                    @(report.Student?.Name ?? "—")
                                </td>

                                <td class="px-4 py-3 text-sm">
                                    @if (report.Type == Models.StudentReport.ReportType.Weekly)
                                    {
                                        <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-blue-100 text-blue-700">أسبوعي</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-orange-100 text-orange-700">نهائي</span>
                                    }
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600">
                                    @(report.Placement?.TrainingOpportunity?.Title ?? "—")
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">
                                    @report.SubmittedAt.ToString("yyyy/MM/dd")
                                </td>

                                <td class="px-4 md:px-lg py-4 md:py-md">
                                    @{
                                        var (badgeBg, badgeLabel) = report.Status switch
                                        {
                                            Models.StudentReport.StudentReportStatus.Submitted => ("bg-amber-100 text-amber-700", "قيد المراجعة"),
                                            Models.StudentReport.StudentReportStatus.Approved => ("bg-green-100 text-green-700", "مقبول"),
                                            Models.StudentReport.StudentReportStatus.Rejected => ("bg-red-100 text-red-700", "مرفوض"),
                                            Models.StudentReport.StudentReportStatus.Reviewed => ("bg-blue-100 text-blue-700", "تمت المراجعة"),
                                            _ => ("bg-slate-100 text-slate-600", "غير مسلّم")
                                        };
                                    }
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold @badgeBg">@badgeLabel</span>
                                </td>

                                <td class="px-4 py-3">
                                    @if (!string.IsNullOrEmpty(report.FilePath))
                                    {
                                        <a asp-page-handler="OpenFile"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1 w-fit"
                                           title="عرض الملف">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-sm">—</span>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex gap-1">
                                        <a asp-page="/Institution/Reports/Details"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1"
                                           title="التفاصيل">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-page="/Institution/Reports/Edit"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-warning text-warning text-xs font-bold px-2 py-2 rounded hover:bg-amber-50 flex items-center gap-1"
                                           title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-page="/Institution/Reports/Delete"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-danger text-danger text-xs font-bold px-2 py-2 rounded hover:bg-rose-50 flex items-center gap-1"
                                           title="حذف">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                            RIndex++;
                        }
                    }

                </tbody>
            </table>
        </div>

        @* ===== Pagination ===== *@
        <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">

            <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
                <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                    عرض
                    <span class="font-bold text-slate-900">@((Model.Reports.PageSize * (Model.Reports.PageIndex - 1)) + 1)</span>
                    إلى
                    <span class="font-bold text-slate-900">@Model.Reports.Count()</span>
                    من <span class="font-bold text-slate-900">@Model.Reports.TotalCount</span> تقرير
                </p>
                <div class="flex items-center gap-2">
                    <label class="text-xs text-slate-500 font-label-caps" for="per-page-rep">النتائج:</label>
                    <form>
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="studentId" value="@Model.StudentId" />
                        <input type="hidden" name="placementId" value="@Model.PlacementId" />
                        <input type="hidden" name="SelectedReportStatus" value="@Model.SelectedReportStatus" />
                        <input type="hidden" name="SelectedReportType" value="@Model.SelectedReportType" />
                        <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                        <select asp-for="PageSize"
                                onchange="this.form.submit()"
                                id="per-page-rep"
                                class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </form>
                </div>
            </div>

            <nav class="flex items-center gap-2">
                @if (Model.Reports.HasPrevPage)
                {
                    <a asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-studentId="@Model.StudentId"
                       asp-route-placementId="@Model.PlacementId"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageIndex="@(Model.PageIndex - 1)"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                }

                @for (int i = 1; i <= Model.Reports.TotalPages; i++)
                {
                    <a asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-studentId="@Model.StudentId"
                       asp-route-placementId="@Model.PlacementId"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageIndex="@i"
                       class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold
                        @(Model.PageIndex == i ? "bg-primary-container text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                        @i
                    </a>
                }

                @if (Model.Reports.HasNextPage)
                {
                    <a asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-studentId="@Model.StudentId"
                       asp-route-placementId="@Model.PlacementId"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageIndex="@(Model.PageIndex + 1)"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                }
            </nav>

        </div>

    </div>

</div>