        <div class="bg-red-50 rounded-xl p-3">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#dc2626" stroke-width="1.8"><circle cx="12" cy="12" r="10" /><path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round" /></svg>
