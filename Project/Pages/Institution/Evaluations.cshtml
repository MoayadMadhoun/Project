    <!-- Pending -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-orange-50 rounded-xl p-3">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#d97706" stroke-width="1.8"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" stroke-linecap="round" /></svg>
