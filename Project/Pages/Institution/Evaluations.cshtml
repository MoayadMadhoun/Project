@page
@using Project.Models
@model Project.Pages.Institution.EvaluationsModel

@{
    ViewData["Title"] = "التقييمات";
    ViewData["UserType"] = "Institution";

    int index =
        ((Model.PageIndex - 1) * Model.PageSize) + 1;

    var total = Model.Evaluations?.Count() ?? 0;

    var approvedCount =
        Model.Evaluations?.Count(x =>
            x.Status ==
            StudentEvaluation.StudentEvaluationStatus.Approved) ?? 0;

    var rejectedCount =
        Model.Evaluations?.Count(x =>
            x.Status ==
            StudentEvaluation.StudentEvaluationStatus.Rejected) ?? 0;

    var submittedCount =
        Model.Evaluations?.Count(x =>
            x.Status ==
            StudentEvaluation.StudentEvaluationStatus.Submitted) ?? 0;

    var average =
        total > 0
        ? Model.Evaluations.Average(x =>
            (double)(x.Score * 100 / x.MaxScore))
        : 0;
}

<div class="space-y-6">

    <!-- Header -->

    <div class="bg-white rounded-2xl shadow-sm p-6">

        <div class="flex items-center justify-between">

            <div>
                @if (!string.IsNullOrEmpty(Model.CurrentStudentName))
                {
                    <div class="alert alert-info">

                        عرض تقييمات الطالب:
                        <strong>@Model.CurrentStudentName</strong>

                    </div>
                }
                else
                {
                    <h1 class="text-2xl font-bold text-slate-800">
                        تقييمات الطلاب
                    </h1>
                }
               

                <p class="text-slate-500 mt-1">
                    متابعة تقييمات المتدربين داخل المؤسسة
                </p>

            </div>

        </div>

    </div>

    <!-- Statistics -->

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div class="bg-white rounded-xl p-5 shadow-sm">
            <div class="text-slate-500 text-sm">
                إجمالي التقييمات
            </div>

            <div class="text-3xl font-bold mt-2">
                @total
            </div>
        </div>

        <div class="bg-white rounded-xl p-5 shadow-sm">

            <div class="text-slate-500 text-sm">
                مقبولة
            </div>

            <div class="text-3xl font-bold text-green-600 mt-2">
                @approvedCount
            </div>

        </div>

        <div class="bg-white rounded-xl p-5 shadow-sm">

            <div class="text-slate-500 text-sm">
                مرفوضة
            </div>

            <div class="text-3xl font-bold text-red-600 mt-2">
                @rejectedCount
            </div>

        </div>

        <div class="bg-white rounded-xl p-5 shadow-sm">

            <div class="text-slate-500 text-sm">
                متوسط الدرجات
            </div>

            <div class="text-3xl font-bold text-blue-600 mt-2">
                @average.ToString("0.0")%
            </div>

        </div>

    </div>

    <!-- Filters -->

    <div class="bg-white rounded-2xl shadow-sm p-6">

        <form method="get">

            <div class="grid md:grid-cols-4 gap-4">

                <input asp-for="SearchTerm"
                       class="border rounded-lg px-4 py-2"
                       placeholder="بحث باسم الطالب" />

                <select asp-for="SelectedEvaluationTypeId"
                        class="border rounded-lg px-4 py-2">

                    <option value="0">كل الأنواع</option>

                    <option value="0">University Mid</option>
                    <option value="1">University Final</option>
                    <option value="2">Institution Mid</option>
                    <option value="3">Institution Final</option>

                </select>

                <select asp-for="SelectedEvaluationStatusId"
                        class="border rounded-lg px-4 py-2">

                    <option value="0">
                        كل الحالات
                    </option>

                    <option value="1">
                        Submitted
                    </option>

                    <option value="2">
                        Approved
                    </option>

                    <option value="3">
                        Rejected
                    </option>

                </select>

                <button type="submit"
                        class="bg-emerald-600 text-white rounded-lg px-4 py-2">

                    بحث

                </button>

            </div>

        </form>

    </div>

    <!-- Table -->

    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">

        <table class="w-full">

            <thead class="bg-slate-50">

                <tr>

                    <th class="text-right px-4 py-3">#</th>
                    <th class="text-right px-4 py-3">الطالب</th>
                    <th class="text-right px-4 py-3">التدريب</th>
                    <th class="text-right px-4 py-3">النوع</th>
                    <th class="text-right px-4 py-3">الدرجة</th>
                    <th class="text-right px-4 py-3">التاريخ</th>
                    <th class="text-right px-4 py-3">الحالة</th>
                    <th class="text-right px-4 py-3">الملف</th>
                    <th class="text-right px-4 py-3">الإجراءات</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Evaluations)
                {
                    <tr class="border-t">

                        <td class="px-4 py-3">
                            @(index++)
                        </td>

                        <td class="px-4 py-3">
                            @item.TrainingPlacement.Student.Name
                        </td>

                        <td class="px-4 py-3">
                            @item.TrainingPlacement.TrainingOpportunity.Title
                        </td>

                        <td class="px-4 py-3">
                            @item.Type
                        </td>

                        <td class="px-4 py-3">

                            @item.Score /
                            @item.MaxScore

                            <span class="text-xs text-slate-500">

                                (@(((item.Score * 100)
                                                                    / item.MaxScore)
                                                                    .ToString("0.0"))%)

                            </span>

                        </td>

                        <td class="px-4 py-3">
                            @item.EvaluationDate.ToString("yyyy-MM-dd")
                        </td>

                        <td class="px-4 py-3">

                            @switch (item.Status)
                            {
                                case StudentEvaluation.StudentEvaluationStatus.Approved:
                                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                                        مقبول
                                    </span>
                                    break;

                                case StudentEvaluation.StudentEvaluationStatus.Rejected:
                                    <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs">
                                        مرفوض
                                    </span>
                                    break;

                                default:
                                    <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs">
                                        قيد المراجعة
                                    </span>
                                    break;
                            }

                        </td>

                        <td class="px-4 py-3">

                            @if (!string.IsNullOrEmpty(item.EvaluationPdfPath))
                            {
                                <a asp-page-handler="OpenFile"
                                   asp-route-id="@item.EvaluationID"
                                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-blue-200 text-blue-600 hover:bg-blue-50 transition">

                                    <svg class="w-5 h-5"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>

                                </a>
                            }

                        </td>

                        <td class="px-4 py-3">

                            <div class="flex gap-2">

                                <a asp-page="/Institution/Evaluations/Edit"
                                   asp-route-id="@item.EvaluationID"
                                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-amber-200 text-amber-600 hover:bg-amber-50 transition">

                                    <svg class="w-5 h-5"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5" />

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z" />

                                    </svg>

                                </a>

                                <a asp-page="/Institution/Evaluations/Delete"
                                   asp-route-id="@item.EvaluationID"
                                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition">

                                    <svg class="w-5 h-5"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M19 7L18.132 19.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.994-1.858L5 7" />

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M10 11v6M14 11v6M4 7h16" />

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3" />

                                    </svg>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>