@{
}
<Link rel="stylesheet" href="~/Styles/Evaluations.css"/>
<a href="#" class="inline-flex items-center gap-2 text-gray-500 hover:text-teal-600 text-sm font-semibold mb-6 transition-colors">
    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 12H5M12 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" /></svg>
    رجوع
</a>

<!-- Hero Banner -->
<div class="bg-primary-container rounded-2xl mb-7 overflow-hidden shadow-card" style="min-height:180px;">
    <div class="flex items-center justify-between px-8 py-6 h-full">
        <!-- Text -->
        <div class="text-right">
            <div class="flex items-center justify-start gap-3 mb-2">
                <div class="bg-white/20 rounded-xl p-2.5 border border-white/30">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="1.8">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h1 class="text-3xl font-extrabold text-white tracking-wide">التقييمات</h1>

            </div>
            <p class="text-white/80 text-sm leading-relaxed">سجل جميع التقييمات التي تم إنشاؤها للطلاب داخل المؤسسة.</p>
        </div>

        <!-- Illustration -->
        <div class="hidden md:flex items-center gap-4">
            <!-- Clipboard -->
            <div class="relative">
                <div class="w-20 h-24 bg-white/15 rounded-xl border-2 border-white/30 flex flex-col items-center pt-5 gap-1.5 relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-7 h-3.5 bg-white/30 rounded-md"></div>
                    <!-- Stars -->
                    <div class="flex gap-0.5 mb-1">
                        <span class="text-yellow-300 text-xs">★★★★★</span>
                    </div>
                    <div class="w-12 h-1.5 bg-white/40 rounded"></div>
                    <div class="w-10 h-1.5 bg-white/30 rounded"></div>
                    <div class="w-12 h-1.5 bg-white/40 rounded"></div>
                </div>
                <!-- Check badge -->
                <div class="absolute -bottom-3 -left-3 w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
            </div>
            <!-- Person -->
            <div class="w-16 h-16 bg-white/15 rounded-full border-2 border-white/30 flex items-center justify-center">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke-linecap="round" />
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="flex items-center gap-3 mb-5 flex-wrap">
    <!-- Search -->
    <div class="flex-1 min-w-[200px] relative">
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8" stroke-width="2" /><path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" /></svg>
        <input type="text" placeholder="ابحث عن طالب..." class="w-full border border-gray-200 bg-white rounded-xl py-2.5 pr-9 pl-4 text-sm text-gray-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300" />
    </div>
    <!-- Selects -->
    <select class="filter-select border border-gray-200 bg-white rounded-xl py-2.5 pr-4 pl-8 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300 appearance-none">
        <option>جميع الحالات</option>
        <option>منجزة</option>
        <option>قيد المراجعة</option>
        <option>مرفوضة</option>
    </select>
    <select class="filter-select border border-gray-200 bg-white rounded-xl py-2.5 pr-4 pl-8 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300 appearance-none">
        <option>جميع أنواع التقييمات</option>
        <option>تقييم نهائي</option>
        <option>تقييم منتصف التدريب</option>
    </select>
    <select class="filter-select border border-gray-200 bg-white rounded-xl py-2.5 pr-4 pl-8 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300 appearance-none">
        <option>جميع البرامج التدريبية</option>
        <option>تطوير ويب</option>
        <option>تحليل البيانات</option>
        <option>تصميم جرافيك</option>
    </select>
    <!-- Filter btn -->
    <button class="flex items-center gap-2 border border-gray-200 bg-white rounded-xl px-4 py-2.5 text-sm text-gray-600 shadow-sm font-medium hover:bg-teal-50 hover:border-teal-300 transition-colors">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M3 6h18M7 12h10M11 18h2" stroke-width="2" stroke-linecap="round" /></svg>
        تصفية
    </button>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <!-- Total -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-teal-50 rounded-xl p-3">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f" stroke-width="1.8"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">إجمالي التقييمات</p>
            <p class="text-2xl font-extrabold text-gray-800">116</p>
        </div>
    </div>
    <!-- Completed -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-green-50 rounded-xl p-3">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#059669" stroke-width="1.8"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" /></svg>
