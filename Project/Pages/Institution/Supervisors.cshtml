@page
@using Microsoft.AspNetCore.Html
@model Project.Pages.Institution.SupervisorsModel
@{
    int supervisorIndex = 1;
    ViewData["ActivePage"] = "Supervisors";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
}
@functions {
    public IHtmlContent SortingIcon(string column, string currentSort)
    {
        if (currentSort == column)
            return new HtmlString("<i class=\"bi bi-caret-up-fill text-primary text-xs\"></i>");
        if (currentSort == column + "_desc")
            return new HtmlString("<i class=\"bi bi-caret-down-fill text-primary text-xs\"></i>");
        return new HtmlString("<i class=\"bi bi-arrow-down-up text-slate-400 text-xs\"></i>");
    }
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">المشرفون</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
                إدارة مشرفي التدريب داخل المؤسسة ومتابعة المتدربين المرتبطين بكل مشرف.
            </p>
            <a asp-page="/Institution/Supervisors/create"
               class="w-full sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors inline-block text-center">
                + إضافة مشرف
            </a>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Filters Bar ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <input type="hidden" name="PageIndex" value="1" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />

            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input asp-for="SearchTerm"
                       type="text"
                       placeholder="ابحث عن مشرف..."
                       class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
            </div>

            <select asp-for="IsActive"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">الحالة</option>
                <option value="true">نشط</option>
                <option value="false">غير نشط</option>
            </select>

            <button type="submit"
                    class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
                بحث
            </button>
        </form>
    </div>

    @* ===== Supervisors Table ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">

        <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-h3 text-lg md:text-h3 text-slate-900">قائمة المشرفين</h3>
            <span class="text-sm text-slate-500 font-body-sm">
                إجمالي <span class="font-bold text-slate-900">@Model.Supervisors.TotalCount</span> مشرف
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[900px]">
                <thead class="bg-surface-container-low">
                    <tr>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">#</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">
                            <a class="flex items-center gap-1 text-slate-500 hover:text-primary transition-colors no-underline"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-IsActive="@Model.IsActive"
                               asp-route-PageIndex="@Model.PageIndex"
                               asp-route-SortOrder="@(Model.SortOrder == "Name" ? "Name_desc" : "Name")">
                                اسم المشرف @SortingIcon("Name", Model.SortOrder)
                            </a>
                        </th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">البريد الإلكتروني</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">القسم / الإدارة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">عدد المتدربين</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ الإضافة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model.Supervisors.TotalCount == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-400">
                                لا يوجد مشرفين لعرضهم
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var supervisor in Model.Supervisors)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">

                                <td class="px-4 py-3 text-sm text-slate-400 font-bold">@supervisorIndex</td>

                                <td class="px-4 py-3 text-sm text-slate-900 font-bold">
                                    أ. @(supervisor.FullName ?? "—")
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600">@supervisor.Email</td>

                                <td class="px-4 py-3 text-sm text-slate-600">
                                    @(supervisor.RoleScope?.Department?.Name ?? "—")
                                </td>

                                <td class="px-4 py-3 text-sm font-bold text-primary text-center">
                                    @Model.TrainingPlacements.Where(tp => tp.InstitutionSupervisorID == supervisor.Id).Count()
                                </td>

                                <td class="px-4 md:px-lg py-4 md:py-md">
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold
                                        @(supervisor.IsActive ? "bg-green-100 text-green-700" : "bg-slate-100 text-slate-500")">
                                        @(supervisor.IsActive ? "نشط" : "غير نشط")
                                    </span>
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">
                                    @supervisor.CreatedAt.ToString("yyyy-MM-dd")
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex gap-1">
                                        <a asp-page="/Institution/Supervisors/Details"
                                           asp-route-id="@supervisor.Id"
                                           class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1"
                                           title="التفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="/Institution/Supervisors/Edit"
                                           asp-route-id="@supervisor.Id"
                                           class="btn border border-warning text-warning text-xs font-bold px-2 py-2 rounded hover:bg-amber-50 flex items-center gap-1"
                                           title="تعديل">
                                            <i class="bi bi-pen"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                            @(supervisorIndex++)
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ===== Pagination ===== *@
        <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">

            <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
                <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                    عرض <span class="font-bold text-slate-900">@Model.Supervisors.Count</span>
                    من أصل <span class="font-bold text-slate-900">@Model.Supervisors.TotalCount</span> مشرف
                </p>
                <div class="flex items-center gap-2">
                    <label class="text-xs text-slate-500 font-label-caps" for="per-page-sup">النتائج:</label>
                    <form method="get">
                        <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                        <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="IsActive" value="@Model.IsActive" />
                        <select asp-for="PageSize"
                                onchange="this.form.submit()"
                                id="per-page-sup"
                                class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </form>
                </div>
            </div>

            <nav class="flex items-center gap-2">
                @if (Model.Supervisors?.HasPrevPage ?? false)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex - 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-IsActive="@Model.IsActive"
                       asp-route-SortOrder="@Model.SortOrder"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                }

                @for (int i = 1; i <= Model.Supervisors?.TotalPages; i++)
                {
                    <a asp-route-PageIndex="@i"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-IsActive="@Model.IsActive"
                       asp-route-SortOrder="@Model.SortOrder"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold
                        @(Model.PageIndex == i ? "bg-primary-container text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                        @i
                    </a>
                }

                @if (Model.Supervisors?.HasNextPage ?? false)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex + 1)"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-IsActive="@Model.IsActive"
                       asp-route-SortOrder="@Model.SortOrder"
                       asp-route-PageSize="@Model.PageSize"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                }
            </nav>

        </div>

    </div>

    @* ===== Supervisor Permissions ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden mb-lg">

        <div class="p-4 md:p-lg border-b border-slate-100">
            <h3 class="font-h3 text-lg md:text-h3 text-slate-900">صلاحيات المشرف</h3>
            <p class="text-sm text-slate-500 mt-1">يمكن للمشرف إجراء العمليات التالية:</p>
        </div>

        <div class="p-4 md:p-lg">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

                <div class="flex flex-col items-center text-center p-4 bg-slate-50 border border-slate-200 rounded-xl hover:border-primary hover:bg-teal-50 transition-colors">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">group</span>
                    </div>
                    <h4 class="text-sm font-bold text-slate-900 mb-1">متابعة المتدربين</h4>
                    <p class="text-xs text-slate-500">متابعة أداء المتدربين وتوجيههم</p>
                </div>

                <div class="flex flex-col items-center text-center p-4 bg-slate-50 border border-slate-200 rounded-xl hover:border-primary hover:bg-teal-50 transition-colors">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">assignment</span>
                    </div>
                    <h4 class="text-sm font-bold text-slate-900 mb-1">إدارة التدريب</h4>
                    <p class="text-xs text-slate-500">تحديد خطط التدريب والمهام المطلوبة</p>
                </div>

                <div class="flex flex-col items-center text-center p-4 bg-slate-50 border border-slate-200 rounded-xl hover:border-primary hover:bg-teal-50 transition-colors">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">star</span>
                    </div>
                    <h4 class="text-sm font-bold text-slate-900 mb-1">تقييم المتدربين</h4>
                    <p class="text-xs text-slate-500">إجراء التقييمات ورفع التقارير النهائية</p>
                </div>

                <div class="flex flex-col items-center text-center p-4 bg-slate-50 border border-slate-200 rounded-xl hover:border-primary hover:bg-teal-50 transition-colors">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">chat</span>
                    </div>
                    <h4 class="text-sm font-bold text-slate-900 mb-1">التواصل</h4>
                    <p class="text-xs text-slate-500">التواصل مع المتدربين والإدارة</p>
                </div>

            </div>
        </div>

    </div>

</div>