@page
@using Microsoft.AspNetCore.Html
@model Project.Pages.Institution.SupervisorsModel
@{
    int supervisorIndex = 1;
}
@functions {
    public IHtmlContent SortingIcon(string column, string currentSort)
    {
        if (currentSort == column)
            return new HtmlString("<span><i class=\"bi bi-caret-up-fill\"></i></span>");

        if (currentSort == column + "_desc")
            return new HtmlString("<span><i class=\"bi bi-caret-down-fill\"></i></span>");

        return new HtmlString("<span><i class=\"bi bi-arrow-down-up\"></i></span>");
    }

}
<div class="header-gradient rounded-2xl text-white p-7 mb-7 flex items-center gap-5 shadow-card min-h-[200px]">
    <div class="bg-white/20 rounded-full p-4 flex items-center justify-center">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
            <circle cx="22" cy="14" r="8" fill="white" fill-opacity="0.9" />
            <ellipse cx="22" cy="32" rx="13" ry="7" fill="white" fill-opacity="0.6" />
            <circle cx="34" cy="12" r="5" fill="white" fill-opacity="0.7" />
            <path d="M31 18c2.5 0.5 5 2 6 5" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none" />
            <circle cx="29" cy="28" r="7" fill="#f59e0b" fill-opacity="0.85" />
            <path d="M29 24v4l2.5 2.5" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none" />
            <path d="M25 31a7 7 0 0 1 8 0" stroke="white" stroke-width="1.2" stroke-linecap="round" fill="none" />
        </svg>
    </div>
    <div class="text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">المشرفون</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90">
            إدارة مشرفي التدريب داخل المؤسسة ومتابعة<br />المتدربين المرتبطين بكل مشرف.
        </p>

    </div>
    <!-- Add Button -->
    <button class="btn-add flex items-center gap-2 text-white rounded-xl px-5 py-2.5 text-sm font-bold shadow">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 5v14M5 12h14" stroke-width="2.5" stroke-linecap="round" /></svg>
        إضافة مشرف
    </button>
</div>
<form method="get">
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
    <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
<!-- Actions Bar -->
<div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
    <!-- Search -->
    <div class="flex-1 min-w-[200px] relative">
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <circle cx="11" cy="11" r="8" stroke-width="2" />
            <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input asp-for="SearchTerm" type="text" placeholder="ابحث عن مشرف..." class="w-full border border-gray-200 bg-white rounded-xl py-2.5 pr-10 pl-4 text-sm text-gray-700 shadow-sm focus:ring-2 focus:ring-teal-300 focus:border-teal-400" />
    </div>

    <!-- Filter -->
        <div class="relative flex-1 min-w-[200px]">
            <select asp-for="IsActive" class="form-select flex items-center gap-2 px-5 py-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-sm font-bold">

                <option value="">الحالة</option>
                <option value="true">نشط</option>
                <option value="false">غير نشط</option>
            </select>
        </div>
    <button type="submit" class="filter-btn flex items-center gap-2 border border-gray-200 bg-white rounded-xl px-4 py-2.5 text-sm text-gray-600 shadow-sm font-medium">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M3 6h18M7 12h10M11 18h2" stroke-width="2" stroke-linecap="round" /></svg>
        تصفية
    </button>

    <!-- Add Button -->
    <a class="btn-add flex items-center gap-2 text-white rounded-xl px-5 py-2.5 text-sm font-bold shadow" asp-page="/Institution/Supervisors/create">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 5v14M5 12h14" stroke-width="2.5" stroke-linecap="round" /></svg>
        إضافة مشرف
    </a>
</div>
</form>

<!-- Table Card -->
<div class="bg-white rounded-2xl shadow-card overflow-hidden mb-7">
    <table class="w-full text-right text-sm">
        <thead>
            <tr class="border-b border-gray-100 bg-gray-50/60">
                <th class="py-4 px-4 font-bold text-gray-500 text-xs">#</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">
                    <a class="text-decoration-none"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-PageIndex="@(Model.PageIndex)"
                           asp-route-SortOrder="@(Model.SortOrder == "Name" ? "Name_desc" : "Name")">
                        اسم المشرف @SortingIcon("Name", Model.SortOrder)
                    </a>
                </th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">البريد الإلكتروني</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">القسم/الإدارة</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">عدد المتدربين</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">الحالة</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">تاريخ الإضافة</th>
                <th class="py-4 px-3 font-bold text-gray-500 text-xs">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Supervisors.TotalCount == 0)
            {
                <tr>
                    <td colspan="12" class="px-4 py-6 text-center text-slate-500">
                        لا يوجد مشرفين لعرضهم
                    </td>
                </tr>
            }
            else
            {
            @foreach (var supervisor in Model.Supervisors)
            {
            <!-- Row 1 -->
            <tr class="table-row-hover border-b border-gray-50">
                <td class="py-4 px-4 text-gray-400 font-semibold">@supervisorIndex</td>
                <td class="py-4 px-3 text-left">
                    <div class="flex items-center gap-2 justify-start">
                        <div class="avatar-circle"><svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="8" r="4" stroke-width="2" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke-width="2" stroke-linecap="round" /></svg></div>
                        <span class="font-semibold text-gray-800">أ. @(supervisor.User.FullName??"-") </span>

                    </div>
                </td>
                <td class="py-4 px-3 text-gray-500 text-xs">@supervisor.User.Email</td>
                <td class="py-4 px-3 text-gray-700">@supervisor.Department</td>
                <td class="py-4 px-3 text-center font-bold text-teal-600">@(Model.TrainingPlacements.Where(tp=>tp.InstitutionSupervisorID == supervisor.UserID).Count())  </td>
                        <td class="py-4 px-3"><span class="badge-active text-xs font-bold px-3 py-1 rounded-full">@(supervisor.IsActive? "نشط":"غير نشط")</span></td>
                        <td class="py-4 px-3 text-gray-400 text-xs">@supervisor.User.CreatedAt</td>
                <td class="py-4 px-3"><button class="dots-btn px-2 py-1 text-gray-400 font-bold text-lg tracking-widest">•••</button></td>
            </tr>
            @(supervisorIndex++)
            }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-5 py-4 border-t border-gray-100 bg-gray-50/40">
        <div class="flex items-center gap-2">
            <label class="text-xs text-slate-500 font-label-caps" for="per-page-inst">النتائج:</label>
            <form method="get">
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        
                <select asp-for="PageSize"
                        onchange="this.form.submit()"
                        class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer"
                        id="per-page-inst">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </form>
            <span class="text-xs text-gray-400">عرض  @((Model.Supervisors?.PageSize * (Model.Supervisors?.PageIndex - 1))) - @(Model.Supervisors?.PageSize * Model.Supervisors?.PageIndex) من @Model.Supervisors?.TotalCount مشرف</span>
        </div>
        <div class="flex items-center gap-1.5">
            <!-- Prev -->
            @if (Model.Supervisors?.HasPrevPage??false)
            {

                <a asp-route-PageIndex="@(Model.PageIndex - 1)"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-SortOrder="@Model.SortOrder"
                   asp-route-PageSize="@Model.PageSize"
                   class="page-btn w-8 h-8 flex items-center justify-center rounded-lg border border-gray-200 text-gray-400 text-sm"><span class="material-symbols-outlined">chevron_right</span></a>
            }
           
           
            @for (int i = 1; i <= Model.Supervisors?.TotalPages; i++)
            {

                <a asp-route-PageIndex="@i"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-SortOrder="@Model.SortOrder"
                   asp-route-PageSize="@Model.PageSize"
                   class="page-btn w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold@(Model.PageIndex == i ? "active shadow-sm " : "border border-gray-200 text-gray-500 text-sm font-medium")  text-white text-sm font-bold">
                   @i
                </a>
            }
            
            <!-- Next -->
            @if (Model.Supervisors?.HasNextPage??false)
            {
                <a asp-route-PageIndex="@(Model.PageIndex + 1)"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-SortOrder="@Model.SortOrder"
                   asp-route-PageSize="@Model.PageSize"
                   class="page-btn w-8 h-8 flex items-center justify-center rounded-lg border border-gray-200 text-gray-400 text-sm">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 18l6-6-6-6" stroke-width="2" stroke-linecap="round" /></svg>
               </a>
            }

        </div>
        
    </div>
</div>

<!-- Supervisor Permissions Section -->
<div class="bg-white rounded-2xl shadow-card px-7 py-6 mb-8">
    <div class="flex items-center gap-3 justify-end mb-5">
        <h2 class="text-base font-bold text-gray-800">صلاحيات المشرف</h2>
        <div class="bg-teal-50 rounded-lg p-2">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z" stroke-width="1.8" /></svg>
        </div>
    </div>
    <p class="text-sm text-gray-500 text-right mb-6">يمكن للمشرف إجراء العمليات التالية:</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Perm 1 -->
        <div class="perm-card border border-teal-100 rounded-xl p-4 text-center bg-teal-50/40">
            <div class="flex justify-center mb-3">
                <div class="bg-teal-100 rounded-full p-2.5">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f"><path d="M17 20h5v-1a3 3 0 00-5.356-1.857M17 20H7m10 0v-1c0-.656-.126-1.283-.356-1.857M7 20H2v-1a3 3 0 015.356-1.857M7 20v-1c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="1.8" stroke-linecap="round" /></svg>
                </div>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">متابعة المتدربين</h3>
            <p class="text-xs text-gray-500">متابعة أداء المتدربين وتوجيههم</p>
        </div>
        <!-- Perm 2 -->
        <div class="perm-card border border-teal-100 rounded-xl p-4 text-center bg-teal-50/40">
            <div class="flex justify-center mb-3">
                <div class="bg-teal-100 rounded-full p-2.5">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke-width="1.8" stroke-linecap="round" /></svg>
                </div>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">إدارة التدريب</h3>
            <p class="text-xs text-gray-500">تحديد خطط التدريب والمهام المطلوبة</p>
        </div>
        <!-- Perm 3 -->
        <div class="perm-card border border-teal-100 rounded-xl p-4 text-center bg-teal-50/40">
            <div class="flex justify-center mb-3">
                <div class="bg-teal-100 rounded-full p-2.5">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" stroke-width="1.8" stroke-linecap="round" /></svg>
                </div>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">تقييم المتدربين</h3>
            <p class="text-xs text-gray-500">إجراء التقييمات ورفع التقارير النهائية</p>
        </div>
        <!-- Perm 4 -->
        <div class="perm-card border border-teal-100 rounded-xl p-4 text-center bg-teal-50/40">
            <div class="flex justify-center mb-3">
                <div class="bg-teal-100 rounded-full p-2.5">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-width="1.8" stroke-linecap="round" /></svg>
                </div>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">التواصل</h3>
            <p class="text-xs text-gray-500">التواصل مع المتدربين والإدارة</p>
        </div>
    </div>
</div>



