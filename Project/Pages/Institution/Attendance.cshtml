@page
@model Project.Pages.Institution.AttendanceModel
@{
    ViewData["Title"] = "الحضور";
    Layout = "_Layout";
    int TrainingRecordIndex = 1;

    var total = Model.AttendanceRecords?.Count() ?? 0;

    var presentCount = Model.AttendanceRecords?.Count(x =>
        x.Status == Models.AttendanceRecord.AttendanceStatus.Present) ?? 0;

    var lateCount = Model.AttendanceRecords?.Count(x =>
        x.Status == Models.AttendanceRecord.AttendanceStatus.Late) ?? 0;

    var absentCount = Model.AttendanceRecords?.Count(x =>
        x.Status == Models.AttendanceRecord.AttendanceStatus.Absent) ?? 0;

    var excusedCount = Model.AttendanceRecords?.Count(x =>
        x.Status == Models.AttendanceRecord.AttendanceStatus.Excused) ?? 0;

}
<Link rel="stylesheet" href="~/Styles/Evaluations.css"/>
<a href="#" class="inline-flex items-center gap-2 text-gray-500 hover:text-teal-600 text-sm font-semibold mb-6 transition-colors">
    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 12H5M12 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" /></svg>
    رجوع
</a>

<!-- Hero Banner -->
<div class="bg-primary-container rounded-2xl mb-7 overflow-hidden shadow-card" style="min-height:180px;">
    <div class="flex items-center justify-between px-8 py-6 h-full">
        <!-- Text -->
        <div class="text-right">
            <div class="flex items-center justify-start gap-3 mb-2">
                <div class="bg-white/20 text-white rounded-xl p-2.5 border border-white/30">
                    <div class="hero-icon">
                <i class="bi bi-calendar-check"></i>
            </div>
                </div>
                <h1 class="text-3xl font-extrabold text-white tracking-wide">الحضور</h1>

            </div>
            <p class="text-white/80 text-sm leading-relaxed">تسجيل وإدارة حضور الطلاب أثناء فترة التدريب.</p>
        </div>

        <!-- Illustration -->
        <div class="hidden md:flex items-center gap-4">
            <!-- Clipboard -->
            <div class="relative">
                <div class="w-20 h-24 bg-white/15 rounded-xl border-2 border-white/30 flex flex-col items-center pt-5 gap-1.5 relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-7 h-3.5 bg-white/30 rounded-md"></div>
                    <!-- Stars -->
                    <div class="flex gap-0.5 mb-1">
                        <span class="text-yellow-300 text-xs">★★★★★</span>
                    </div>
                    <div class="w-12 h-1.5 bg-white/40 rounded"></div>
                    <div class="w-10 h-1.5 bg-white/30 rounded"></div>
                    <div class="w-12 h-1.5 bg-white/40 rounded"></div>
                </div>
                <!-- Check badge -->
                <div class="absolute -bottom-3 -left-3 w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#1a9e8f" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
            </div>
            <!-- Person -->
            <div class="w-16 h-16 bg-white/15 rounded-full border-2 border-white/30 flex items-center justify-center">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke-linecap="round" />
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<form method="get" class="mb-4"> 
<div class="flex items-center gap-3 mb-5 flex-wrap">
    <!-- Search -->
    <div class="flex-1 min-w-[200px] relative">
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8" stroke-width="2" /><path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" /></svg>
            <input asp-for="SearchTerm" type="text" placeholder="ابحث عن طالب..." class="w-full border border-gray-200 bg-white rounded-xl py-2.5 pr-9 pl-4 text-sm text-gray-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300" />
    </div>
    <!-- Selects -->
 
    <select asp-for="SelectedAttendanceStatusId" class="filter-select border border-gray-200 bg-white rounded-xl py-2.5 pr-4 pl-8 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300 appearance-none">
        
        <option value="0">جميع حالات الحضور</option>
                <option value="1">حاضر</option>
                <option value="2">متأخر</option>
                <option value="3">غائب</option>
                <option value="4">معذور</option>
    </select>
     <select asp-for="@Model.SelectedTrainig" asp-items="@Model.Trainings" class="filter-select border border-gray-200 bg-white rounded-xl py-2.5 pr-4 pl-8 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300 appearance-none">
        <option>جميع البرامج التدريبية</option>
       
    </select>
       

   
    <!-- Filter btn -->
    <button class="flex items-center gap-2 border border-gray-200 bg-white rounded-xl px-4 py-2.5 text-sm text-gray-600 shadow-sm font-medium hover:bg-teal-50 hover:border-teal-300 transition-colors">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M3 6h18M7 12h10M11 18h2" stroke-width="2" stroke-linecap="round" /></svg>
        تصفية
    </button>
</div>
</form>

<!-- Stats Cards -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
    
    <!-- Completed -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-green-50 rounded-xl p-3">
            <i class="bi bi-check-circle"></i>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">حاضر</p>
            <p class="text-2xl font-extrabold text-gray-800">@presentCount</p>
            <p class="text-xs text-green-600 font-bold">@(total > 0 ? presentCount * 100 / total : 0)%</p>
        </div>
    </div>
    <!-- Pending -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-orange-50 rounded-xl p-3">
            <i class="bi bi-clock"></i>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">متأخرة</p>
            <p class="text-2xl font-extrabold text-gray-800">@lateCount</p>
            <p class="text-xs text-orange-500 font-bold">@(total > 0 ? lateCount * 100 / total : 0)%</p>
        </div>
    </div>
    <!-- Rejected -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-red-50 rounded-xl p-3">
            <i class="bi bi-x-circle"></i>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">غائب</p>
            <p class="text-2xl font-extrabold text-gray-800">@absentCount</p>
            <p class="text-xs text-red-500 font-bold">@(total > 0 ? absentCount * 100 / total : 0)%</p>
        </div>
    </div>
    <!--with excuse-->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-red-50 rounded-xl p-3">
           <i class="bi bi-person"></i>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">معذر</p>
            <p class="text-2xl font-extrabold text-gray-800">@excusedCount</p>
            <p class="text-xs text-red-500 font-bold">@(total > 0 ? excusedCount * 100 / total : 0)%</p>
        </div>
    </div>
    <!-- Total -->
    <div class="stat-card bg-white rounded-2xl shadow-card p-5 flex items-center gap-4">
        <div class="bg-teal-50 rounded-xl p-3">
            <i class="bi bi-people"></i>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-400 font-medium">إجمالي الطلاب</p>
            <p class="text-2xl font-extrabold text-gray-800">@total</p>
        </div>
    </div>

</div>

<!-- Table -->
<div class="bg-white rounded-2xl shadow-card overflow-hidden mb-6">
    <table class="w-full text-right text-sm">
        <thead>
            <tr class="bg-gray-50/70 border-b border-gray-100">
                <th class="py-4 px-4 text-xs font-bold text-gray-400">#</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">الطالب</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">البرنامج التدريبي</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">التاريخ</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">وقت الدخول</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">وقت الخروج</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400 text-center">حالة الحضور</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">الملاحظات</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400 text-center">سجل بواسطة</th>
                <th class="py-4 px-3 text-xs font-bold text-gray-400">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            <!-- Row 1 -->
            @foreach(var i in Model.AttendanceRecords )
            {
                <tr class="table-row border-b border-gray-50">
                <td class="py-4 px-4 text-gray-400 font-semibold text-xs">@TrainingRecordIndex</td>
                <td class="py-4 px-3 font-bold text-gray-800">@i.TrainingPlacement.Student.Name</td>
                <td class="py-4 px-3 text-gray-600">@i.TrainingPlacement.TrainingOpportunity.Title</td>
                    <td class="py-4 px-3">
                        @i.AttendanceDate.ToString("yyyy-MM-dd")
                    </td>
                <td class="py-4 px-3 text-gray-400 text-xs">@i.CheckInTime</td>
                 <td class="py-4 px-3 text-gray-400 text-xs">@i.CheckOutTime</td>
                 <td class="py-4 px-3 text-gray-400 text-xs"><span class="status-badge status-present">
                            <span class="badge  @(i.Status == Models.AttendanceRecord.AttendanceStatus.Present ? "bg-green-100 text-green-700"
                                                                                                        : i.Status == Models.AttendanceRecord.AttendanceStatus.Absent ? "bg-amber-100 text-amber-700"
                                                                                                                                          : i.Status == Models.AttendanceRecord.AttendanceStatus.Late ? "bg-red-100 text-red-700" : "bg-orange-100 text-orange-700")">
                                    @(i.Status == Models.AttendanceRecord.AttendanceStatus.Present ? "حاضر"
                                    : i.Status == Models.AttendanceRecord.AttendanceStatus.Absent ? "غائب"
                                    : i.Status == Models.AttendanceRecord.AttendanceStatus.Late ? "متأخر" : "معذور")
                                    
                     </span>

                 </span></td>
                <td class="py-4 px-3 text-gray-400 text-xs">@(i.Notes ?? "_")</td>
                <td class="py-4 px-3 text-gray-400 text-xs">أ. @i.InstitutionSupervisor.FullName
                     <button class="dots-btn text-gray-400 font-bold text-lg transition-colors px-2"></button>
                </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2">

                            <!-- تعديل -->
                            <a asp-page="/Institution/Attendance/Edit"
                               asp-route-attendanceId="@i.AttendanceID"
                               class="inline-flex items-center gap-1 px-3 py-2 text-xs font-medium text-amber-600 border border-amber-200 rounded-lg hover:bg-amber-50 transition">

                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M16.586 3.586a2 2 0 112.828 2.828L12 13.828 8 14l.172-4L16.586 3.586z" />
                                </svg>

                                تعديل
                            </a>

                            <!-- حذف -->
                            <a asp-page="/Institution/Attendance/Delete"
                               asp-route-id="@i.AttendanceID"
                               class="inline-flex items-center gap-1 px-3 py-2 text-xs font-medium text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition">

                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M19 7L5 7M10 11V17M14 11V17M6 7L7 19A2 2 0 009 21H15A2 2 0 0017 19L18 7M9 7V4A1 1 0 0110 3H14A1 1 0 0115 4V7" />
                                </svg>

                                حذف
                            </a>

                        </div>
                    </td>
                    @(TrainingRecordIndex++)
            </tr>
            
                
            }
            
          
          
        </tbody>
    </table>

    <!-- Pagination -->
    @if (Model.AttendanceRecords.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4">

            <div class="text-muted small">
                عرض
                @((Model.AttendanceRecords.PageIndex - 1) * Model.PageSize + 1)
                إلى
                @(Math.Min(Model.AttendanceRecords.PageIndex * Model.PageSize,
                    Model.AttendanceRecords.TotalCount))
                من
                @Model.AttendanceRecords.TotalCount
                سجل
            </div>

            <nav>
                <ul class="pagination mb-0">

                    <!-- السابق -->

                    <li class="page-item @(Model.AttendanceRecords.HasPrevPage ? "" : "disabled")">

                        <a class="page-link"
                           asp-page="./Attendance"
                           asp-route-studentId="@Model.StudentId"
                           asp-route-placementId="@Model.PlacementId"
                           asp-route-PageIndex="@(Model.AttendanceRecords.PageIndex - 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-SelectedAttendanceStatusId="@Model.SelectedAttendanceStatusId"
                           asp-route-SelectedTrainig="@Model.SelectedTrainig">

                            السابق

                        </a>

                    </li>

                    @for (int i = 1; i <= Model.AttendanceRecords.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.AttendanceRecords.PageIndex ? "active" : "")">

                            <a class="page-link"
                               asp-page="./Attendance"
                               asp-route-PageIndex="@i"
                               asp-route-studentId="@Model.StudentId"
                               asp-route-placementId="@Model.PlacementId"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-SelectedAttendanceStatusId="@Model.SelectedAttendanceStatusId"
                               asp-route-SelectedTrainig="@Model.SelectedTrainig">

                                @i

                            </a>

                        </li>
                    }

                    <!-- التالي -->

                    <li class="page-item @(Model.AttendanceRecords.HasNextPage ? "" : "disabled")">

                        <a class="page-link"
                           asp-page="./Attendance"
                           asp-route-PageIndex="@(Model.AttendanceRecords.PageIndex + 1)"
                           asp-route-studentId="@Model.StudentId"
                           asp-route-placementId="@Model.PlacementId"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-SelectedAttendanceStatusId="@Model.SelectedAttendanceStatusId"
                           asp-route-SelectedTrainig="@Model.SelectedTrainig">

                            التالي

                        </a>

                    </li>

                </ul>
            </nav>

        </div>
    }

</div>


