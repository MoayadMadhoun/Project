@page
@using Project.Pages.Institution.ViewModels
@model Project.Pages.Institution.CurrentTrainingModel
@{
    ViewData["Title"] = "التدريب الحالي";
    ViewData["UserType"] = "Institution";
    ViewData["PortalTitle"] = "بوابة المؤسسة";
    ViewData["PortalSubtitle"] = "إدارة المتدربين والفرص";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، طلبات...";
    ViewData["ActivePage"] = "CurrentTraining";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">التدريبات الحالية</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90">
                استعرض جميع الفرص التدريبية التي أنشأتها مؤسستك وتابع حالة كل تدريب والمتدربين الملتحقين به
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Filters Bar ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />

            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input name="SearchTerm"
                       value="@Model.SearchTerm"
                       class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                       placeholder="ابحث عن تدريب..."
                       type="text" />
            </div>

            <button type="submit"
                    class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
                بحث
            </button>
        </form>
    </div>

    @* ===== Training Cards ===== *@
    <div class="space-y-4">
        @if (!Model.CurrentTrainings.Any())
        {
            <div class="bg-surface-container-lowest border border-slate-100 rounded-xl p-12 text-center shadow-[0_4px_20px_rgba(44,62,80,0.05)]">
                <span class="material-symbols-outlined text-slate-300 text-5xl block mb-3">work_off</span>
                <p class="text-sm text-slate-400">لا يوجد تدريبات حالية لعرضها</p>
            </div>
        }
        else
        {
            @foreach (var ct in Model.CurrentTrainings)
            {
                <div class="bg-surface-container-lowest border border-slate-100 rounded-xl p-6 md:p-lg shadow-[0_4px_20px_rgba(44,62,80,0.05)] hover:shadow-[0_8px_30px_rgba(44,62,80,0.08)] transition-all">

                    @* Header *@
                    <div class="flex items-center gap-3 mb-3">
                        <h2 class="text-lg font-bold text-slate-900">@ct.Title</h2>
                        <span class="px-3 py-1 rounded-full text-[11px] font-bold @CurrentTrainingModel.GetTrainingStatusClass(ct)">
                            @CurrentTrainingModel.GetTrainingStatus(ct)
                        </span>
                    </div>

                    @* Description *@
                    <p class="text-sm text-slate-500 mb-6 leading-relaxed">
                        @(ct.Description ?? "—")
                    </p>

                    @* Footer *@
                    <div class="flex items-center justify-between flex-wrap gap-3 pt-4 border-t border-slate-100">
                        <div class="flex items-center gap-5 flex-wrap text-slate-500 text-sm">

                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base text-slate-400">schedule</span>
                                مدة التدريب: @CurrentTrainingModel.GetDurationText(ct.StartDate, ct.EndDate)
                            </span>

                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base text-slate-400">group</span>
                                @CurrentTrainingModel.GetTraineeCount(ct) متدرب
                            </span>

                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base text-slate-400">calendar_today</span>
                                تاريخ البداية: @ct.StartDate.ToString("dd-MM-yyyy")
                            </span>

                        </div>

                        <a asp-page="/Institution/CurrentTraining/Details"
                           asp-route-id="@ct.OpportunityID"
                           class="btn border border-primary text-primary text-xs font-bold px-3 py-2 rounded hover:bg-blue-50 flex items-center gap-1 no-underline">
                            <i class="bi bi-eye"></i>
                            عرض التفاصيل
                        </a>
                    </div>

                </div>
            }
        }
    </div>

</div>