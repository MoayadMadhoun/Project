@page
@model Project.Pages.Institution.Reports.DeleteModel

<div class="card border-0 shadow-sm">

    <div class="card-body text-center p-5">

        <i class="bi bi-trash-fill
            text-danger fs-1">
        </i>

        <h3 class="mt-3">

            حذف التقرير

        </h3>

        <p class="text-muted">

            هل أنت متأكد من حذف تقرير

            <strong>
                @Model.Report.Title
            </strong>

            ؟

        </p>

        <form method="post">

            <input type="hidden"
                   name="reportId"
                   value="@Model.Report.ReportID" />

            <button type="submit"
                    class="btn btn-danger">

                حذف

            </button>

            <a asp-page="/Institution/Reports"
               class="btn btn-secondary">

                إلغاء

            </a>

        </form>

    </div>

</div>