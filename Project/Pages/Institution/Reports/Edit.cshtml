@page
@model Project.Pages.Institution.Reports.EditModel

@{
    ViewData["Title"] = "تعديل التقرير";
}

<form method="post"
      enctype="multipart/form-data">

    <input asp-for="Input.ReportID" type="hidden" />

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <h2 class="fw-bold">

                تعديل التقرير

            </h2>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body">

            <div class="mb-3">

                <label class="form-label">

                    نوع التقرير

                </label>

                <select asp-for="Input.Type"
                        class="form-select">

                    <option value="Weekly">
                        أسبوعي
                    </option>

                    <option value="Final">
                        نهائي
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">

                    عنوان التقرير

                </label>

                <input asp-for="Input.Title"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">

                    محتوى التقرير

                </label>

                <textarea asp-for="Input.Content"
                          rows="8"
                          class="form-control">
                </textarea>

            </div>

            @if (!string.IsNullOrEmpty(
            Model.Input.ExistingFile))
            {
                <div class="alert alert-info">

                    يوجد ملف مرفق حالياً

                </div>
            }

            <div class="mb-4">

                <label class="form-label">

                    استبدال الملف

                </label>

                <input asp-for="Input.ReportFile"
                       type="file"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle"></i>

                حفظ التعديلات

            </button>

        </div>

    </div>

</form>