@model Project.DTO.NotificationDto

<div id="page-notif-item-@Model.Id" 
     class="p-4 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-all duration-200 relative overflow-hidden @(Model.IsRead ? "" : "bg-teal-50/20 dark:bg-teal-950/20 border-l-4 border-l-primary")">
    
    <div class="flex items-start gap-4">
        @* Checkbox for bulk actions *@
        <div class="pt-1">
            <input type="checkbox" 
                   value="@Model.Id" 
                   class="notif-select-checkbox w-4 h-4 text-primary bg-slate-100 border-slate-300 rounded focus:ring-primary dark:focus:ring-primary dark:ring-offset-slate-800 focus:ring-2 dark:bg-slate-700 dark:border-slate-600" />
        </div>

        @* Icon Badge *@
        <div class="w-12 h-12 rounded-2xl @Model.ColorClass flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-2xl">@Html.Raw(@Model.IconClass)</span>
        </div>

        @* Content *@
        <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">@Model.Title</h3>
                    <span class="px-2.5 py-0.5 text-[11px] font-bold rounded-full @Model.BadgeColorClass">
                        @Model.TypeName
                    </span>
                    @if (!Model.IsRead)
                    {
                        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                    }
                </div>
                <span class="relative-time text-xs text-slate-400 font-medium" data-created-at="@Model.CreatedAt.ToUniversalTime().ToString("O")">@Model.RelativeTime</span>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
                @Model.Message
            </p>

            @* Card Actions *@
            <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
                <div>
                    @if (!string.IsNullOrEmpty(Model.Url))
                    {
                        <a href="@Model.Url" 
                           onclick="SpacearaNotification.markAsRead(@Model.Id)"
                           class="inline-flex items-center gap-1 font-bold text-primary hover:text-teal-700 transition-colors">
                            <span>عرض التفاصيل والإجراء</span>
                            <span class="material-symbols-outlined text-sm">open_in_new</span>
                        </a>
                    }
                </div>

                <div class="flex items-center gap-3">
                    @if (!Model.IsRead)
                    {
                        <button type="button" 
                                onclick="SpacearaNotificationPage.markAsRead(@Model.Id)"
                                class="text-xs font-bold text-primary hover:underline">
                            تحديد كمقروء
                        </button>
                    }
                    else
                    {
                        <span class="text-xs text-slate-400 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm text-emerald-500">done_all</span>
                            تم القراءة
                        </span>
                    }

                    <button type="button" 
                            onclick="SpacearaNotificationPage.deleteSingle(@Model.Id)"
                            class="text-slate-400 hover:text-rose-500 transition-colors p-1 rounded-lg">
                        <span class="material-symbols-outlined text-base">delete</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
