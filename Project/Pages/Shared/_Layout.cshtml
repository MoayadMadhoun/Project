                    <span class="material-symbols-outlined">event_available</span>الحضور
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Student/Reports">
                    <span class="material-symbols-outlined">description</span>التقارير
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Student/Evaluations">
                    <span class="material-symbols-outlined">grading</span>التقييمات
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" href="#">
                    <span class="material-symbols-outlined">person</span>الملف الشخصي
                </a>
            }

            <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-area="Identity" asp-page="/Account/Settings">
                    <span class="material-symbols-outlined">settings</span>الإعدادات
             </a>
        </nav>

        <div class="p-4 border-t border-slate-100">
            <a class="flex items-center gap-md px-4 py-3 rounded-xl text-error hover:bg-error-container/10 transition-transform hover:translate-x-1 font-body-md text-body-md" asp-page="/Index">
                <span class="material-symbols-outlined">logout</span>تسجيل الخروج
            </a>
        </div>
    </aside>

    @* ===== Main Content (RenderBody) ===== *@
    <main class="lg:mr-[280px] pt-20 md:pt-24 pb-24 lg:pb-12 px-4 md:px-6 min-h-screen stat-card scroll-animate zoom-in">
        @RenderBody()
    </main>

    @* ===== Mobile Bottom Navigation ===== *@
    <nav class="fixed bottom-0 left-0 w-full z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-lg flex justify-around items-center px-4 py-3 pb-safe border-t border-slate-100 dark:border-slate-800 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] rounded-t-2xl hidden">
        <a class="flex flex-col items-center justify-center text-teal-600 bg-teal-50 rounded-xl px-4 py-1 scale-110 duration-300" href="#">
            <span class="material-symbols-outlined">home</span>
            <span class="text-[10px] font-bold uppercase tracking-wider mt-1">الرئيسية</span>
        </a>
        <a class="flex flex-col items-center justify-center text-slate-400 active:bg-slate-100 px-4" href="#">
            <span class="material-symbols-outlined">work_outline</span>
            <span class="text-[10px] font-bold uppercase tracking-wider mt-1">الميدان</span>
        </a>
        <a class="flex flex-col items-center justify-center text-slate-400 active:bg-slate-100 px-4" href="#">
            <span class="material-symbols-outlined">notifications_none</span>
            <span class="text-[10px] font-bold uppercase tracking-wider mt-1">تنبيهات</span>
        </a>
        <a class="flex flex-col items-center justify-center text-slate-400 active:bg-slate-100 px-4" href="#">
            <span class="material-symbols-outlined">account_circle</span>
            <span class="text-[10px] font-bold uppercase tracking-wider mt-1">الملف</span>
