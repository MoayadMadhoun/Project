@using Project.Models
@inject UserManager<AspNetUser> UserManager

@{
    AspNetUser user = null;

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        user = await UserManager.GetUserAsync(User);
    }
}

<!DOCTYPE html>
<html class="light" dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة التدريب الميداني</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body { font-family: 'Almarai', sans-serif; background-color: #f8f9fa; }
        #mobile-overlay.active { display: block; }
        #sidebar.active { transform: translateX(0); }



    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    body {
        font-family: 'Almarai', sans-serif;
        background-color: #f8f9fa;
    }

    #mobile-overlay.active {
        display: block;
    }

    #sidebar.active {
        transform: translateX(0);
    }

    /* ===================================
       SCROLL ANIMATION
    =================================== */

    .scroll-animate {
        opacity: 0;
        transform: translateY(50px);
        transition: all .8s ease;
        will-change: transform, opacity;
    }

    .scroll-animate.show {
        opacity: 1;
        transform: translateY(0);
    }

    .fade-right {
        transform: translateX(60px);
    }

    .scroll-animate.show.fade-right {
        transform: translateX(0);
    }

    .fade-left {
        transform: translateX(-60px);
    }

    .scroll-animate.show.fade-left {
        transform: translateX(0);
    }

    .zoom-in {
        transform: scale(.85);
    }

    .scroll-animate.show.zoom-in {
        transform: scale(1);
    }

    /* ===================================
       FIRST LOAD ANIMATION
    =================================== */

    header {
        animation: topFade .8s ease forwards;
    }

    main {
        animation: mainFade 1s ease forwards;
    }

    footer {
        animation: footerFade 1.2s ease forwards;
    }

    @@keyframes topFade {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes sidebarFade {
        from {
            opacity: 0;
            transform: translateX(80px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes mainFade {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes footerFade {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===================================
       NAV ITEMS HOVER
    =================================== */

    nav a {
        transition: all .3s ease;
    }

    nav a:hover {
        transform: translateX(-5px);
    }


    </style>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                "secondary-fixed-dim":"#b5c8df","surface-container":"#edeeef","background":"#f8f9fa",
                "surface-bright":"#f8f9fa","tertiary-fixed":"#cce5ff","on-background":"#191c1d",
                "surface-container-lowest":"#ffffff","surface":"#f8f9fa","surface-container-high":"#e7e8e9",
                "on-primary-fixed-variant":"#005141","on-secondary-fixed-variant":"#36485b",
                "on-tertiary-fixed-variant":"#004b73","on-tertiary-fixed":"#001d31",
                "surface-container-highest":"#e1e3e4","on-tertiary-container":"#004063",
                "on-surface-variant":"#3c4a45","primary-container":"#1abc9c","on-primary":"#ffffff",
                "secondary-fixed":"#d1e4fb","primary-fixed":"#6ff9d6","surface-dim":"#d9dadb",
                "surface-variant":"#e1e3e4","surface-tint":"#006b58","surface-container-low":"#f3f4f5",
                "tertiary-fixed-dim":"#92ccff","on-secondary-fixed":"#091d2e","inverse-surface":"#2e3132",
                "secondary":"#4e6073","tertiary":"#006397","on-error":"#ffffff","primary-fixed-dim":"#4eddbb",
                "on-secondary":"#ffffff","on-tertiary":"#ffffff","outline-variant":"#bbcac3",
                "on-primary-fixed":"#002019","outline":"#6c7a75","on-secondary-container":"#526478",
                "on-surface":"#191c1d","error-container":"#ffdad6","on-error-container":"#93000a",
                "inverse-on-surface":"#f0f1f2","on-primary-container":"#004538","inverse-primary":"#4eddbb",
                "tertiary-container":"#51aef2","secondary-container":"#cfe2f9","error":"#ba1a1a","primary":"#006b58"
              },
              "borderRadius": { "DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px" },
              "spacing": {
                "lg":"24px","xs":"4px","unit":"8px","md":"16px","xl":"32px",
                "gutter":"20px","xxl":"48px","container-max":"1440px","sm":"8px"
              },
              "fontFamily": {
                "body-md":["Almarai"],"button":["Almarai"],"h3":["Almarai"],
                "label-caps":["Almarai"],"body-sm":["Almarai"],"h2":["Almarai"],
                "body-lg":["Almarai"],"h1":["Almarai"]
              },
              "fontSize": {
                "body-md":["16px",{"lineHeight":"1.5","fontWeight":"400"}],
                "button":["16px",{"lineHeight":"1","fontWeight":"700"}],
                "h3":["20px",{"lineHeight":"1.4","fontWeight":"700"}],
                "label-caps":["12px",{"lineHeight":"1","letterSpacing":"0.05em","fontWeight":"700"}],
                "body-sm":["14px",{"lineHeight":"1.5","fontWeight":"400"}],
                "h2":["24px",{"lineHeight":"1.3","fontWeight":"700"}],
                "body-lg":["18px",{"lineHeight":"1.6","fontWeight":"400"}],
                "h1":["32px",{"lineHeight":"1.2","fontWeight":"800"}]
              }
            }
          }
        }
    </script>
    @RenderSection("Styles", required: false)
</head>
<body class="bg-surface text-on-surface">

    @* Mobile Overlay *@
    <div class="hidden fixed inset-0 bg-black/50 z-40 transition-opacity duration-300 lg:hidden" id="mobile-overlay"></div>

    @* ===== TopNavBar ===== *@
    <header class="fixed top-0 left-0 z-50 flex items-center h-16 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md shadow-sm border-b border-slate-100 dark:border-slate-800 lg:right-[280px] right-0 px-4 md:px-6 justify-between">
        <div class="flex items-center gap-sm lg:hidden">
            <button class="p-2 text-slate-600 hover:bg-slate-100 rounded-lg" id="menu-toggle">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <div class="flex items-center gap-xs">
                <div class="w-8 h-8 rounded bg-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-white text-lg">school</span>
                </div>
                <span class="font-bold text-slate-900 text-sm hidden sm:block">@ViewData["PortalTitle"]</span>
            </div>
        </div>
        <div class="flex-1 max-w-md mx-4 lg:mx-0">
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute right-3 text-slate-400">search</span>
                <input class="w-full pr-10 pl-4 py-2 bg-slate-100 dark:bg-slate-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                       placeholder="@(ViewData["SearchPlaceholder"]?.ToString())" type="text" />
            </div>
        </div>
        <div class="flex items-center gap-md">
            <span class="text-slate-700 dark:text-slate-200 font-bold text-sm hidden sm:block">@user?.FullName</span>
            <div class="w-8 h-8 rounded-full overflow-hidden border-2 border-primary-container">
                <img alt="User Profile"
                     src="./images/Logos/logoBottomnavbar" />
            </div>
        </div>
    </header>

    @* ===== SideNavBar ===== *@
    <aside class="fixed top-0 right-0 h-full w-[280px] z-[60] bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-xl transition-transform duration-300 translate-x-full lg:translate-x-0 flex flex-col" id="sidebar">
       
        <div class="px-6 mb-8 pt-4">
            <div class="flex justify-center mb-6">
                <img alt="Spaceara Logo" class="w-auto object-contain h-24"
                     src="../../../../images/Logos/NavBarLogo.svg"/>
            </div>
            <div class="flex items-center justify-between lg:justify-start gap-md mb-4 mt-4">
                <div class="flex items-center gap-md">
                    <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">school</span>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
                            @if (User.IsInRole("UniversityTrainingAdmin") || User.IsInRole("DepartmentHead") || User.IsInRole("UniversitySupervisor"))
                            {
                                 @:بوابة الجامعة 
                            }
                            @if (User.IsInRole("InstitutionTrainingOfficer") || User.IsInRole("InstitutionSupervisor"))
                            {
                                @:بوابة المؤسسة
                            }
                            @if (User.IsInRole("Student"))
                            {
                                @:بوابة الطالب
                            }

                            @* @(ViewData["PortalTitle"]?.ToString()) *@
                        </h2>
                        <p class="text-xs text-slate-500">@(ViewData["PortalSubtitle"]?.ToString())</p>
                    </div>
                </div>
                <button class="lg:hidden p-2 text-slate-400 hover:bg-slate-100 rounded-lg" id="close-menu">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>

        <nav class="flex-1 px-4 space-y-1 overflow-y-auto">
            @if(User.IsInRole("InstitutionTrainingOfficer") || User.IsInRole("InstitutionSupervisor"))
            {
                @* ===== قائمة بوابة المؤسسة ===== *@
                <a class="flex items-center gap-md px-4 py-3 rounded-xl font-body-md text-body-md" asp-page="/Institution/Index">
                    <span class="material-symbols-outlined">dashboard</span>الرئيسية
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/AvailableOpportunities">
                    <span class="material-symbols-outlined">explore</span>الفرص التدريبية
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/TrainingRequests">
                    <span class="material-symbols-outlined">group</span>طلبات الطلبة
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/CurrentTraining">
                    <span class="material-symbols-outlined">work</span>التدريب الحالي
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/Supervisors">
                    <span class="material-symbols-outlined">manage_accounts</span>المشرفون
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/Reports">
                    <span class="material-symbols-outlined">description</span>التقارير
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/index">
                    <span class="material-symbols-outlined">grading</span>التقييمات
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Institution/Profile">
                    <span class="material-symbols-outlined">person</span>ملف المؤسسة
                </a>
            }
            else if (User.IsInRole("UniversityTrainingAdmin") || User.IsInRole("DepartmentHead") || User.IsInRole("UniversitySupervisor"))
            {
                @* ===== قائمة بوابة الجامعة ===== *@
                <a class="flex items-center gap-md px-4 py-3 rounded-xl font-body-md text-body-md" asp-page="/University/Index">
                    <span class="material-symbols-outlined">dashboard</span>الرئيسية
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/AvailabelOpportunities">
                    <span class="material-symbols-outlined">explore</span>الفرص التدريبية
                </a>
                @if (User.IsInRole("UniversityTrainingAdmin") || User.IsInRole("DepartmentHead"))
                {
                    <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="@(User.IsInRole("UniversityTrainingAdmin") ? "/University/UniAdminTrainigRequests" : User.IsInRole("DepartmentHead") ? "/University/DepartmentHeadTrainingRequests" : "")">
                        <span class="material-symbols-outlined">group</span>طلبات الطلبة
                    </a>
                }
               
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/Students">
                    <span class="material-symbols-outlined">school</span>الطلاب
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/Attendance">
                    <span class="material-symbols-outlined">event_available</span>الحضور
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" href="#">
                    <span class="material-symbols-outlined">business</span>المؤسسات
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/Departments">
                    <span class="material-symbols-outlined">apartment</span>الأقسام
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/Specialties/index">
                    <span class="material-symbols-outlined">school</span>التخصصات
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/DepartmentsHeads">
                    <span class="material-symbols-outlined">manage_accounts</span>رؤساء الأقسام
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/University/Supervisors">
                    <span class="material-symbols-outlined">manage_accounts</span>المشرفون
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" href="#">
                    <span class="material-symbols-outlined">description</span>التقارير
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" href="#">
                    <span class="material-symbols-outlined">grading</span>التقييمات
                </a>

            }
            else if(User.IsInRole("Student"))
            {
                @* ===== قائمة بوابة الطالب (الافتراضية) ===== *@
                <a class="flex items-center gap-md px-4 py-3 rounded-xl font-body-md text-body-md" asp-page="/Student/Index">
                    <span class="material-symbols-outlined">dashboard</span>الرئيسية
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Student/AvaliabelOpportunities">
                    <span class="material-symbols-outlined">explore</span>الفرص التدريبية
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Student/MyApplications">
                    <span class="material-symbols-outlined">assignment</span>طلباتي
                </a>
                <a class="flex items-center gap-md px-4 py-3 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-r-4 border-transparent hover:border-slate-200 transition-all hover:translate-x-1 font-body-md text-body-md" asp-page="/Student/CurrentTraining">
                    <span class="material-symbols-outlined">work</span>التدريب الحالي
                </a>
