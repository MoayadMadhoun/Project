<div dir="rtl">

<!-- ===== FILTERS ===== -->
<form method="get"
      class="bg-surface-container-lowest rounded-xl border p-4 mb-lg">

    <div class="flex flex-wrap gap-3 items-center justify-end">

        <input name="Search"
               value="@Model.Search"
               class="bg-slate-100 rounded-xl px-4 py-2 text-right"
               placeholder="بحث..." />

        <select name="DepartmentId" asp-items="Model.DepartmentList"
                class="bg-slate-100 rounded-xl px-4 py-2 text-right">
            <option value="">كل الأقسام</option>
        </select>

        <select name="StatusFilter" asp-items="Model.StatusList"
                class="bg-slate-100 rounded-xl px-4 py-2 text-right">
            <option value="">الحالة</option>
        </select>

        <select name="DepartmentDecisionFilter" asp-items="Model.DecisionList"
                class="bg-slate-100 rounded-xl px-4 py-2 text-right">
            <option value="">قرار القسم</option>
        </select>

        <select name="UniversityDecisionFilter" asp-items="Model.DecisionList"
                class="bg-slate-100 rounded-xl px-4 py-2 text-right">
            <option value="">قرار الجامعة</option>
        </select>

        <button class="bg-primary text-white px-6 py-2 rounded-xl">
            بحث
        </button>

    </div>
</form>

<!-- ===== TABLE ===== -->
<div class="bg-white rounded-xl border overflow-hidden">

<table class="w-full text-right">
    <thead class="bg-gray-100">
        <tr>
            <th>الطالب</th>
            <th>الرقم</th>
            <th>القسم</th>
            <th>المؤسسة</th>
            <th>الفرصة</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model.Applications)
    {
        <tr class="border-t">

            <td>@item.StudentName</td>
            <td>@item.StudentNumber</td>
            <td>@item.DepartmentName</td>
            <td>@item.InstitutionName</td>
            <td>@item.OpportunityTitle</td>
            @* <td>@item.Status.GetDisplayName()</td> *@

            <td>
                @if (item.Status == Project.Models.TrainingApplication.ApplicationStatus.DepartmentApproved)
                {
                    <form method="post" asp-page-handler="Approve" asp-route-id="@item.ApplicationID">
                        <button class="text-green-600">اعتماد</button>
                    </form>

                    <form method="post" asp-page-handler="Reject" asp-route-id="@item.ApplicationID">
                        <button class="text-red-600">رفض</button>
                    </form>
                }
                else
                {
                    <span>—</span>
                }
            </td>

        </tr>
    }
    </tbody>

</table>

</div>

<!-- ===== PAGINATION ===== -->
<div class="flex gap-2 mt-4 justify-center">

    <a asp-route-PageIndex="@(Model.Applications.PageIndex - 1)"
       class="px-3 py-1 border @(Model.Applications.HasPrevPage ? "" : "opacity-50 pointer-events-none")">
        السابق
    </a>

    @for (int i = 1; i <= Model.Applications.TotalPages; i++)
    {
        <a asp-route-PageIndex="@i"
           class="px-3 py-1 border @(i == Model.Applications.PageIndex ? "bg-primary text-white" : "")">
            @i
        </a>
    }

    <a asp-route-PageIndex="@(Model.Applications.PageIndex + 1)"
       class="px-3 py-1 border @(Model.Applications.HasNextPage ? "" : "opacity-50 pointer-events-none")">
        التالي
    </a>

</div>

</div>