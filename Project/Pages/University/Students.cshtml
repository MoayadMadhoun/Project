                </p>
            </div>
            @* <div class="hero-icon-wrap flex-shrink-0">
                <!-- graduation cap icon -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/>
                </svg>
            </div> *@
        </div>
    </div>

    <!-- ===== FILTER BAR ===== -->
    <div class="filter-bar mb-4">
        <div class="row g-2 align-items-center">
            <!-- Search -->
            <div class="col-12 col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0" style="border-color:#d1faf4;border-radius:var(--radius-md) 0 0 var(--radius-md);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#0d9488" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                        </svg>
                    </span>
                    <input type="text" class="form-control form-control-sm border-start-0 ps-0"
                           placeholder="ابحث عن طالب..."
                           style="border-color:#d1faf4;border-radius:0 var(--radius-md) var(--radius-md) 0;" />
                </div>
            </div>
            <!-- Specialty -->
            <div class="col-6 col-md-2">
                <select class="form-select form-select-sm">
                    <option>التخصص - الكل</option>
                    <option>هندسة البرمجيات</option>
                    <option>تحليل البيانات</option>
                    <option>أمن سيبراني</option>
                    <option>علوم الحاسب</option>
                    <option>شبكات الحاسب</option>
                    <option>تقنية المعلومات</option>
                    <option>الذكاء الاصطناعي</option>
                    <option>تصميم جرافيك</option>
                </select>
            </div>
            <!-- Department -->
            <div class="col-6 col-md-2">
                <select class="form-select form-select-sm">
                    <option>القسم - الكل</option>
                    <option>تقنية المعلومات</option>
                    <option>الحاسوب</option>
                    <option>الأدب الرقمي</option>
                </select>
            </div>
            <!-- Current Training -->
            <div class="col-6 col-md-2">
                <select class="form-select form-select-sm">
                    <option>التدريب الحالي - الكل</option>
                    <option>لديه تدريب</option>
