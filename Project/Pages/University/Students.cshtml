                        <th>التدريب الحالي</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @* -------- Row 1 -------- *@
                    <tr>
                        <td class="col-num" data-label="#">1</td>
                        <td class="col-name" data-label="الطالب">محمد أحمد البدوي</td>
                        <td class="col-id" data-label="الرقم الجامعي">20201234</td>
                        <td class="col-spec" data-label="التخصص"><span>هندسة البرمجيات</span></td>
                        <td class="col-dept" data-label="القسم"><span>تقنية المعلومات</span></td>
                        <td class="col-gpa gpa-high" data-label="المعدل">3.45</td>
                        <td data-label="التدريب الحالي">
                            <span class="training-badge training-active">
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="#15803d"><circle cx="12" cy="12" r="6"/></svg>
                                تدريب Full Stack
                            </span>
                        </td>
