                    </svg>
                    بحث
                </button>
            </div>
        </div>
    </div>

    <!-- ===== TABLE CARD ===== -->
    <div class="table-card">
        <!-- Header -->
        <div class="table-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="table-title">الطلبة المسجلون</span>
                <span class="count-badge">128</span>
            </div>
            <span class="table-count">إجمالي 128 طالب وطالبة</span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
