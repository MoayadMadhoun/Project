@page "{RequestId}"
@model Project.Pages.University.TrainingRequests.EditModel

@{
    ViewData["Title"] = "تعديل طلب فرصة تدريب";
    ViewData["UserType"] = "University";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
}

<form method="post">

    <!-- Hero Section -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        تعديل طلب فرصة تدريب
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        تحديث بيانات طلب الفرص التدريبية وإدارة حالة الطلب.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-pencil-square fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Request Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات الطلب
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">

                    <label class="text-muted">
                        رقم الطلب
                    </label>

                    <div class="fw-semibold">
                        @Model.OpportunityRequest?.RequestID
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="text-muted">
                        تاريخ الإنشاء
                    </label>

                    <div class="fw-semibold">
                        @Model.OpportunityRequest?.CreatedAt
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="text-muted">
                        الجهة المنشئة
                    </label>

                    <div class="fw-semibold">
                        @(Model.OpportunityRequest?.UniversityAdmin?.FullName ?? Model.OpportunityRequest?.DepartmentHead?.FullName)
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="text-muted">
                        الحالة الحالية
                    </label>

                    <div>
                        <span class="badge bg-success">
                            @Model.TrainingRequest?.Status
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Request Details -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                بيانات الطلب
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-8">

                    <label class="form-label fw-semibold">
                        عنوان الطلب
                    </label>

                    <input asp-for="TrainingRequest.Title" type="text"
                           class="form-control shadow-sm rounded-3 bg-light border-0" />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        عدد المقاعد المطلوبة
                    </label>

                    <input type="number" asp-for="TrainingRequest.RequestedSeats"
                           class="form-control shadow-sm rounded-3 bg-light border-0" />

                </div>

                
                <div class="col-md-12">

                    <label class="form-label fw-semibold">
                        وصف الطلب
                    </label>

                    <textarea asp-for="TrainingRequest.Description" rows="5"
                              class="form-control shadow-sm rounded-3 bg-light border-0"></textarea>

                </div>

            </div>

        </div>

    </div>

    <!-- Training Period -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                فترة التدريب
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        فترة التدريب
                    </label>

                    
                    <select asp-items="Model.TrainingTermsList" asp-for="TrainingRequest.TermID" class="form-select shadow-sm rounded-3 bg-light border-0">
                        <option value="">
                            اختر الفصل
                        </option>
                    </select>
                    <span class="text-danger" asp-validation-for="TrainingRequest.TermID"></span>

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        تاريخ البداية المفضل
                    </label>

                    <input type="date"
                           asp-for="TrainingRequest.PreferredStartDate"
                           class="form-control shadow-sm rounded-3 bg-light border-0" />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        تاريخ النهاية المفضل
                    </label>

                    <input type="date"
                           asp-for="TrainingRequest.PreferredEndDate"
                           class="form-control shadow-sm rounded-3 bg-light border-0" />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        آخر موعد لتقديم الطلبة
                    </label>

                    <input asp-for="TrainingRequest.ApplicationDeadline" type="date"
                           class="form-control shadow-sm rounded-3 bg-light border-0" />

                </div>

            </div>

        </div>

    </div>

    <!-- Request Scope -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                نطاق الطلب
            </h5>

        </div>

        <div class="card-body">

            <div class="alert alert-light border rounded-4 mb-0">

                <div class="d-flex align-items-center">

                    <i class="bi bi-building text-success fs-3 me-3"></i>

                    <div>

                        <div class="fw-bold">
                            الجامعة الحالية
                        </div>

                        <div class="text-muted">
                            تم إنشاء الطلب باسم الجامعة الحالية وفقاً لصلاحيات المستخدم.
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Status -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                حالة الطلب
            </h5>

        </div>

        <div class="card-body">

            <select asp-for="TrainingRequest.Status" class="form-select shadow-sm rounded-3 bg-light border-0">

                <option value="0">
                    مسودة
                </option>

                <option value="1">
                    منشور
                </option>

                <option value="2">
                    مغلق
                </option>

                <option value="3">
                    ملغى
                </option>

            </select>

        </div>

    </div>

    <!-- Notes -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                ملاحظات إضافية
            </h5>

        </div>

        <div class="card-body">

            <textarea asp-for="TrainingRequest.Notes" rows="4"
                      class="form-control shadow-sm rounded-3 bg-light border-0">يفضل أن تكون الفرص التدريبية داخل المحافظة وأن تشمل إشرافاً مباشراً على الطلبة.</textarea>

        </div>

    </div>

    <!-- Warning -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-exclamation-circle-fill text-warning fs-3"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        تنبيه
                    </h6>

                    <p class="text-muted mb-0">
                        قد يؤثر تعديل عدد المقاعد المطلوبة أو فترة التدريب على المؤسسات التي ستستجيب لهذا الطلب لاحقاً.
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        
        <button type="submit"
                class="btn btn-outline-success px-5">

            <i class="bi bi-send me-1"></i>

            تحديث ونشر

        </button>

        <a asp-page="/University/AvailabelOpportunities"
               class="btn btn-light px-5">

            <i class="bi bi-arrow-right-circle me-1"></i>

            رجوع

        </a>

    </div>

</form>