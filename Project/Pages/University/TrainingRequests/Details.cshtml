@page "{RequestId}"
@model Project.Pages.University.TrainingRequests.DetailsModel

@{
    ViewData["Title"] = "تفاصيل طلب فرصة تدريب";
    ViewData["UserType"] = "University";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
}

<!-- Hero Section -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-5 text-white"
         style="background:#1ab29a;border-radius:24px;">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h1 class="fw-bold mb-3">
                    تفاصيل طلب فرصة تدريب
                </h1>

                <p class="mb-0 fs-5 opacity-75">
                    عرض كافة المعلومات المرتبطة بطلب الفرص التدريبية.
                </p>

            </div>

            <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                 style="width:90px;height:90px;">

                <i class="bi bi-file-earmark-text fs-1"></i>

            </div>

        </div>

    </div>

</div>

<!-- Request Information -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            معلومات الطلب
        </h5>

    </div>

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-3">

                <label class="text-muted">
                    رقم الطلب
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.RequestID
                </div>

            </div>

            <div class="col-md-5">

                <label class="text-muted">
                    عنوان الطلب
                </label>

                <div class="fw-semibold">
                    @(Model.TrainingOpportunityRequest?.Title ?? "_")
                </div>

            </div>

            <div class="col-md-2">

                <label class="text-muted">
                    الحالة
                </label>

                <div>
                    <span class="badge bg-success">
                        @Model.TrainingOpportunityRequest?.Status
                    </span>
                </div>

            </div>

            <div class="col-md-2">

                <label class="text-muted">
                    عدد المقاعد
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.RequestedSeats
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Creator Information -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            الجهة المنشئة للطلب
        </h5>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4">

                <label class="text-muted">
                    الجامعة
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.University.Name
                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    المنشئ
                </label>

                <div class="fw-semibold">
                    @(Model.TrainingOpportunityRequest?.UniversityAdmin?.FullName ?? Model.TrainingOpportunityRequest?.DepartmentHead?.FullName)
                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    القسم
                </label>

                <div class="fw-semibold">
                    @(Model.TrainingOpportunityRequest?.Department?.Name ?? "-")
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Request Description -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            وصف الطلب
        </h5>

    </div>

    <div class="card-body">

        <p class="mb-0 text-muted">

            @(Model.TrainingOpportunityRequest?.Description ?? "_")

        </p>

    </div>

</div>

<!-- Training Period -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            فترة التدريب
        </h5>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-3">

                <label class="text-muted">
                    الفترة التدريبية
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.TrainingTerm.Name
                </div>

            </div>

            <div class="col-md-3">

                <label class="text-muted">
                    تاريخ البداية
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.PreferredStartDate
                </div>

            </div>

            <div class="col-md-3">

                <label class="text-muted">
                    تاريخ النهاية
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.PreferredEndDate
                </div>

            </div>

            <div class="col-md-3">

                <label class="text-muted">
                    آخر موعد للتقديم
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.ApplicationDeadline
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Additional Notes -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            ملاحظات إضافية
        </h5>

    </div>

    <div class="card-body">

        <p class="mb-0 text-muted">

            @(Model.TrainingOpportunityRequest?.Notes ?? "_")

        </p>

    </div>

</div>

<!-- Timeline -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header bg-white">

        <h5 class="fw-bold mb-0">
            معلومات التتبع
        </h5>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <label class="text-muted">
                    تاريخ إنشاء الطلب
                </label>

                <div class="fw-semibold">
                    @Model.TrainingOpportunityRequest?.CreatedAt
                </div>

            </div>

            
        </div>

    </div>

</div>

<!-- Actions -->

<div class="d-flex gap-2 mb-5">

    <a asp-route-RequestId="@Model.TrainingOpportunityRequest?.RequestID" asp-page="Edit"
           class="btn btn-success px-5">
        <i class="bi bi-pencil-square me-1"></i>
        تعديل الطلب
    </a>

    <a href="#"
           class="btn btn-light px-5">

        <i class="bi bi-arrow-right-circle me-1"></i>

        رجوع

    </a>

</div>