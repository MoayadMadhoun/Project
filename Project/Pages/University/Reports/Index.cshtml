@page
@using Project.Models
@model Project.Pages.University.Reports.IndexModel
@{
    ViewData["Title"] = "تقارير الطلاب";
    ViewData["UserType"] = "University";
    ViewData["ActivePage"] = "Reports";
    int rowNumber = ((Model.PageIndex - 1) * Model.PageSize) + 1;
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">تقارير الطلاب</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
                متابعة جميع التقارير المرسلة من الطلاب والمؤسسات التدريبية
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Filters Bar ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">

            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input asp-for="SearchTerm"
                       class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20"
                       placeholder="بحث باسم الطالب أو عنوان التقرير"
                       type="text" />
            </div>

            <select asp-for="SelectedReportType"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">جميع الأنواع</option>
                <option value="0">أسبوعي</option>
                <option value="1">نهائي</option>
            </select>

            <select asp-for="SelectedReportStatus"
                    asp-items="Model.ReportStatusList"
                    class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">جميع الحالات</option>
            </select>

            <button type="submit"
                    class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">
                بحث
            </button>

        </form>
    </div>

    @* ===== Reports Table ===== *@
    <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">

        <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-h3 text-lg md:text-h3 text-slate-900">قائمة التقارير</h3>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[1100px]">
                <thead class="bg-surface-container-low">
                    <tr>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">#</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الطالب</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">القسم</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التدريب</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">نوع التقرير</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">العنوان</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ الإرسال</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الحالة</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الملف</th>
                        <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (!Model.Reports.Any())
                    {
                        <tr>
                            <td colspan="11" class="px-4 py-12 text-center text-sm text-slate-400">
                                لا توجد تقارير
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var report in Model.Reports)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">

                                <td class="px-4 py-3 text-sm text-slate-400 font-bold">@rowNumber</td>

                                <td class="px-4 py-3 text-sm text-slate-900 font-bold">@report.Student.Name</td>

                                <td class="px-4 py-3 text-sm text-slate-600">@report.Student.Department?.Name</td>

                                <td class="px-4 py-3 text-sm text-slate-600">@report.Placement.TrainingInstitution.Name</td>

                                <td class="px-4 py-3 text-sm text-slate-600">@report.Placement.TrainingOpportunity.Title</td>

                                <td class="px-4 py-3 text-sm">
                                    @if (report.Type == StudentReport.ReportType.Weekly)
                                    {
                                        <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-blue-100 text-blue-700">أسبوعي</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-orange-100 text-orange-700">نهائي</span>
                                    }
                                </td>

                                <td class="px-4 py-3 text-sm text-slate-600">@report.Title</td>

                                <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">
                                    @report.SubmittedAt.ToString("yyyy/MM/dd")
                                </td>

                                <td class="px-1 md:px-lg py-4 md:py-md">
                                    @{
                                        var (badgeBg, badgeLabel) = report.Status switch
                                        {
                                            StudentReport.StudentReportStatus.Submitted => ("bg-amber-100 text-amber-700", "قيد المراجعة"),
                                            StudentReport.StudentReportStatus.Approved => ("bg-green-100 text-green-700", "مقبول"),
                                            StudentReport.StudentReportStatus.Rejected => ("bg-red-100 text-red-700", "مرفوض"),
                                            _ => ("bg-slate-100 text-slate-600", "أخرى")
                                        };
                                    }
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold @badgeBg">@badgeLabel</span>
                                </td>

                                <td class="px-4 py-3">
                                    @if (!string.IsNullOrEmpty(report.FilePath))
                                    {
                                        <a asp-page-handler="OpenFile"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-sm">—</span>
                                    }
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex gap-1">
                                        <a asp-page="/University/Reports/Details"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-primary text-primary text-xs font-bold px-2 py-2 rounded hover:bg-blue-50 flex items-center gap-1"
                                           title="عرض التفاصيل">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-page="/University/Reports/Review"
                                           asp-route-reportId="@report.ReportID"
                                           class="btn border border-warning text-warning text-xs font-bold px-2 py-2 rounded hover:bg-amber-50 flex items-center gap-1"
                                           title="مراجعة التقرير">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                            rowNumber++;
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ===== Pagination ===== *@
        <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">

            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                إجمالي التقارير: <span class="font-bold text-slate-900">@Model.Reports.TotalCount</span>
            </p>

            <nav class="flex items-center gap-2">
                @if (Model.Reports.HasPrevPage)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                }

                @for (int i = 1; i <= Model.Reports.TotalPages; i++)
                {
                    <a asp-route-PageIndex="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold
                        @(Model.PageIndex == i ? "bg-primary-container text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                        @i
                    </a>
                }

                @if (Model.Reports.HasNextPage)
                {
                    <a asp-route-PageIndex="@(Model.PageIndex + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-SelectedReportType="@Model.SelectedReportType"
                       asp-route-SelectedReportStatus="@Model.SelectedReportStatus"
                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </a>
                }
            </nav>

        </div>

    </div>

</div>