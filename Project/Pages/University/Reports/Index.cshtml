@page
@using Project.Models
@model Project.Pages.University.Reports.IndexModel

@{
    ViewData["Title"] = "تقارير الطلاب";
    ViewData["UserType"] = "University";

    int rowNumber =
        ((Model.PageIndex - 1) * Model.PageSize) + 1;
}

<div class="container-fluid">

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>

                    <h1 class="fw-bold mb-3">

                        تقارير الطلاب

                    </h1>

                    <p class="mb-0 fs-5 opacity-75">

                        متابعة جميع التقارير المرسلة من الطلاب والمؤسسات التدريبية

                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-file-earmark-text fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Filters -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-4">

                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="بحث باسم الطالب أو عنوان التقرير" />

                    </div>

                    <div class="col-md-3">

                        <select asp-for="SelectedReportType"
                                class="form-select">

                            <option value="">
                                جميع الأنواع
                            </option>

                            <option value="0">
                                أسبوعي
                            </option>

                            <option value="1">
                                نهائي
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <select asp-for="SelectedReportStatus"
                                asp-items="Model.ReportStatusList"
                                class="form-select">

                            <option value="">
                                جميع الحالات
                            </option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-funnel"></i>

                            تصفية

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Table -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                قائمة التقارير

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>

                            <th>الطالب</th>

                            <th>القسم</th>

                            <th>المؤسسة</th>

                            <th>التدريب</th>

                            <th>نوع التقرير</th>

                            <th>العنوان</th>

                            <th>تاريخ الإرسال</th>

                            <th>الحالة</th>

                            <th>الملف</th>

                            <th>الإجراءات</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Reports.Any())
                        {
                            <tr>

                                <td colspan="11"
                                    class="text-center py-5">

                                    لا توجد تقارير

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var report in Model.Reports)
                            {
                                <tr>

                                    <td>
                                        @rowNumber
                                    </td>

                                    <td>
                                        @report.Student.Name
                                    </td>

                                    <td>
                                        @report.Student.Department?.Name
                                    </td>

                                    <td>
                                        @report.Placement.TrainingInstitution.Name
                                        
                                        
                                    </td>

                                    <td>
                                        @report.Placement.TrainingOpportunity.Title
                                        
                                        
                                    </td>

                                    <td>

                                        @if (report.Type ==
                                       StudentReport.ReportType.Weekly)
                                        {
                                            <span class="badge bg-info">

                                                أسبوعي

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">

                                                نهائي

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @report.Title

                                    </td>

                                    <td>

                                        @report.SubmittedAt.ToString("yyyy/MM/dd")

                                        

                                    </td>

                                    <td>

                                        @switch (report.Status)
                                        {
                                            case StudentReport
                                            .StudentReportStatus
                                            .Submitted:

                                                <span class="badge bg-warning text-dark">
                                                    قيد المراجعة
                                                </span>
                                                break;

                                            case StudentReport
                                            .StudentReportStatus
                                            .Approved:

                                                <span class="badge bg-success">
                                                    مقبول
                                                </span>
                                                break;

                                            case StudentReport
                                            .StudentReportStatus
                                            .Rejected:

                                                <span class="badge bg-danger">
                                                    مرفوض
                                                </span>
                                                break;

                                            default:

                                                <span class="badge bg-secondary">
                                                    أخرى
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <!-- File -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(
                                       report.FilePath))
                                        {
                                            <a asp-page-handler="OpenFile"
                                               asp-route-reportId="@report.ReportID"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-file-earmark-pdf-fill"></i>

                                            </a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }

                                    </td>

                                    <!-- Actions -->

                                    <td>

                                        <div class="d-flex gap-2">

                                            <a asp-page="/University/Reports/Details"
                                               asp-route-reportId="@report.ReportID"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <a asp-page="/University/Reports/Review"
                                               asp-route-reportId="@report.ReportID"
                                               class="btn btn-sm btn-outline-success">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                rowNumber++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Pagination -->

        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    إجمالي التقارير:

                    <strong>

                        @Model.Reports.TotalCount

                    </strong>

                </div>

                <div>

                    @if (Model.Reports.HasPrevPage)
                    {
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-route-PageIndex="@(Model.PageIndex - 1)"
                           asp-route-PageSize="@Model.PageSize">

                            السابق

                        </a>
                    }

                    <span class="mx-2">

                        صفحة

                        @Model.PageIndex

                        من

                        @Model.Reports.TotalPages

                    </span>

                    @if (Model.Reports.HasNextPage)
                    {
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-route-PageIndex="@(Model.PageIndex + 1)"
                           asp-route-PageSize="@Model.PageSize">

                            التالي

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>