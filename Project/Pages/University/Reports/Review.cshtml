@page
@using Project.Models
@model Project.Pages.University.Reports.ReviewModel

@{
    ViewData["Title"] = "مراجعة التقرير";
}

<form method="post">

    <input asp-for="Report.ReportID" type="hidden" />

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold">

                        مراجعة التقرير

                    </h2>

                    <div>

                        @Model.Report.Student.Name

                    </div>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-clipboard-check fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- معلومات التقرير -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                بيانات التقرير

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label class="text-muted">
                        الطالب
                    </label>

                    <div class="fw-semibold">
                        @Model.Report.Student.Name
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        المؤسسة
                    </label>

                    <div class="fw-semibold">
                        @Model.Report.Placement.TrainingInstitution.Name
                        
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        التدريب
                    </label>

                    <div class="fw-semibold">
                        @Model.Report.Placement.TrainingOpportunity.Title
                        
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        نوع التقرير
                    </label>

                    <div class="fw-semibold">
                        @Model.Report.Type
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        تاريخ الإرسال
                    </label>

                    <div class="fw-semibold">
                        @Model.Report.SubmittedAt.ToString("yyyy/MM/dd")
                        
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- المحتوى -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                محتوى التقرير

            </h5>

        </div>

        <div class="card-body">

            <div style="white-space:pre-wrap">

                @Model.Report.Content

            </div>

        </div>

    </div>

    <!-- الملف -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                الملف المرفق

            </h5>

        </div>

        <div class="card-body">

            @if (!string.IsNullOrEmpty(Model.Report.FilePath))
            {
                <a asp-page="/University/Reports/Index"
                   asp-page-handler="OpenFile"
                   asp-route-reportId="@Model.Report.ReportID"
                   class="btn btn-primary">

                    <i class="bi bi-download"></i>

                    فتح الملف

                </a>
            }
            else
            {
                <span class="text-muted">
                    لا يوجد ملف مرفق
                </span>
            }

        </div>

    </div>

    <!-- قرار المراجعة -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                قرار المراجعة

            </h5>

        </div>

        <div class="card-body">

            <select asp-for="Report.Status"
                    class="form-select">

                <option value="Approved">
                    مقبول
                </option>

                <option value="Rejected">
                    مرفوض
                </option>

            </select>

        </div>

    </div>

    <div class="d-flex gap-2">

        <button type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-check-circle"></i>

            حفظ القرار

        </button>

        <a asp-page="/University/Reports/Index"
           class="btn btn-light px-5">

            إلغاء

        </a>

    </div>

</form>