@page
@model Project.Pages.University.Reports.DetailsModel

@{
    ViewData["Title"] = "تفاصيل التقرير";
}

<div class="container-fluid">

    <div class="mb-4">

        <a asp-page="/University/Reports/Index"
           class="text-decoration-none text-success fw-semibold">

            <i class="bi bi-arrow-right"></i>

            العودة للتقارير

        </a>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-3">

                        @Model.Report.Title

                    </h2>

                    <div>

                        @Model.Report.Student.Name

                    </div>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-file-earmark-text fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                معلومات التقرير

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">
                    <label class="text-muted">الطالب</label>
                    <div class="fw-semibold">
                        @Model.Report.Student.Name
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted">القسم</label>
                    <div class="fw-semibold">
                        @Model.Report.Student.Department?.Name
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted">المؤسسة</label>
                    <div class="fw-semibold">
                        @Model.Report.Placement.TrainingInstitution.Name
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted">التدريب</label>
                    <div class="fw-semibold">
                        @Model.Report.Placement.TrainingOpportunity.Title
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted">نوع التقرير</label>
                    <div class="fw-semibold">
                        @Model.Report.Type
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted">تاريخ الإرسال</label>
                    <div class="fw-semibold">
                        @Model.Report.SubmittedAt.ToString("yyyy/MM/dd")
                    </div>
                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                محتوى التقرير

            </h5>

        </div>

        <div class="card-body">

            <div style="white-space:pre-wrap">

                @Model.Report.Content

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">

                الملف المرفق

            </h5>

        </div>

        <div class="card-body">

            @if (!string.IsNullOrEmpty(Model.Report.FilePath))
            {
                <a asp-page="/University/Reports/Index"
                   asp-page-handler="OpenFile"
                   asp-route-reportId="@Model.Report.ReportID"
                   class="btn btn-primary">

                    <i class="bi bi-download"></i>

                    فتح الملف

                </a>
            }
            else
            {
                <span class="text-muted">

                    لا يوجد ملف مرفق

                </span>
            }

        </div>

    </div>

</div>