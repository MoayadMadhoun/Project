@page
@model Project.Pages.University.Supervisors.EditModel

@{
    ViewData["Title"] = "تعديل مشرف جامعة";
}

<form method="post">

    @* <input type="hidden" asp-for="Input.UserId" /> *@

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        تعديل مشرف جامعة
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        تحديث بيانات مشرف الجامعة وإدارة حالة حسابه.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-pencil-square fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Personal Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                البيانات الشخصية
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        الاسم الكامل
                    </label>

                    @* asp-for="Input.FullName" *@
                    <input class="form-control shadow-sm rounded-3 bg-light border-0" />

                    @* asp-validation-for="Input.FullName" *@
                    <span class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        البريد الإلكتروني
                    </label>

                   @* asp-for="Input.Email" *@
                    <input class="form-control shadow-sm rounded-3 bg-light border-0" />

                 @* asp-validation-for="Input.Email" *@
                    <span class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        رقم الهاتف
                    </label>

                   @* asp-for="Input.PhoneNumber" *@
                    <input class="form-control shadow-sm rounded-3 bg-light border-0" />

                   @* asp-validation-for="Input.PhoneNumber" *@
                    <span class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        حالة الحساب
                    </label>

                   @* asp-for="Input.IsActive" *@
                    <select class="form-select shadow-sm rounded-3 bg-light border-0">

                        <option value="true">
                            فعال
                        </option>

                        <option value="false">
                            غير فعال
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- Account Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات الحساب
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="text-muted">
                        الدور
                    </label>

                    <div class="fw-semibold">
                        مشرف جامعة
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        الجامعة
                    </label>

                    <div class="fw-semibold">
                        جامعة النجاح الوطنية
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        تاريخ الإنشاء
                    </label>

                    <div class="fw-semibold">
                        01/01/2026
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Permissions -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                الصلاحيات الحالية
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="border rounded-4 p-3">
                        <i class="bi bi-building-check text-success me-2"></i>
                        متابعة فرص التدريب
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3">
                        <i class="bi bi-person-check text-primary me-2"></i>
                        متابعة الطلبات
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3">
                        <i class="bi bi-file-earmark-text text-warning me-2"></i>
                        مراجعة التقارير
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-4 p-3">
                        <i class="bi bi-bar-chart-line text-danger me-2"></i>
                        الاطلاع على الإحصائيات
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Security -->

    <div class="alert alert-warning border-0 shadow-sm mb-4">

        <i class="bi bi-shield-lock-fill me-2"></i>

        لا يمكن تعديل الدور أو الجامعة المرتبطة بالمشرف من هذه الصفحة.

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-check-circle me-1"></i>

            حفظ التعديلات

        </button>

        <a asp-page="/University/Supervisors"
           class="btn btn-light px-5">

            <i class="bi bi-x-circle me-1"></i>

            إلغاء

        </a>

    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
