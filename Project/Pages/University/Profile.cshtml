@page
@model Project.Pages.University.ProfileModel
@{
    ViewData["Title"] = "ملف الجامعة";
    ViewData["UserType"] = "University";
    ViewData["ActivePage"] = "Profile";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">

<div dir="rtl">

    @* ===== Success Alert ===== *@
    @if (TempData["Success"] != null)
    {
        <div class="mb-lg px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm font-bold">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        </div>
    }

    @* ===== Hero Section ===== *@
    <section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
        <div class="relative z-10 max-w-2xl text-right">
            <h1 class="font-h1 text-2xl md:text-h1 mb-md">ملف الجامعة</h1>
            <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
                إدارة وتحديث بيانات الجامعة الأساسية
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
    </section>

    @* ===== Form Card ===== *@
    <form method="post">

        <input asp-for="University.UniversityID" type="hidden" />
        <input asp-for="University.UserID" type="hidden" />

        <div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">

            <div class="p-4 md:p-lg border-b border-slate-100">
                <h3 class="font-h3 text-lg md:text-h3 text-slate-900">بيانات الجامعة</h3>
            </div>

            <div class="p-4 md:p-lg">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    @* اسم الجامعة *@
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-bold text-slate-700">اسم الجامعة</label>
                        <input asp-for="University.Name"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                        <span asp-validation-for="University.Name" class="text-xs text-red-500"></span>
                    </div>

                    @* البريد الإلكتروني *@
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-bold text-slate-700">البريد الإلكتروني</label>
                        <input asp-for="University.Email"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                        <span asp-validation-for="University.Email" class="text-xs text-red-500"></span>
                    </div>

                    @* رقم الهاتف *@
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-bold text-slate-700">رقم الهاتف</label>
                        <input asp-for="University.PhoneNumber"
                               class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
                    </div>

                    @* الحالة *@
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-bold text-slate-700">الحالة</label>
                        <select asp-for="University.IsActive"
                                class="w-full bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                            <option value="true">نشطة</option>
                            <option value="false">غير نشطة</option>
                        </select>
                    </div>

                    @* العنوان *@
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="text-sm font-bold text-slate-700">العنوان</label>
                        <textarea asp-for="University.Address"
                                  rows="4"
                                  class="w-full px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20 resize-none"></textarea>
                    </div>

                </div>
            </div>

            <div class="p-4 md:p-lg border-t border-slate-100 flex justify-start">
                <button type="submit"
                        class="bg-primary-container text-white font-button px-xl py-3 rounded-xl hover:bg-primary/90 transition-colors flex items-center gap-2">
                    <i class="bi bi-check-circle"></i>
                    حفظ التعديلات
                </button>
            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}