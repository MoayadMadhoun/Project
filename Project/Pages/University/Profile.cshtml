@page
@model Project.Pages.University.ProfileModel

@{
    ViewData["Title"] = "ملف الجامعة";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-3">
                        ملف الجامعة
                    </h2>

                    <p class="mb-0">
                        إدارة بيانات الجامعة
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-building fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <form method="post">

        <input asp-for="University.UniversityID" type="hidden" />
        <input asp-for="University.UserID" type="hidden" />

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-header bg-white">

                <h5 class="fw-bold mb-0">
                    بيانات الجامعة
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label">
                            اسم الجامعة
                        </label>

                        <input asp-for="University.Name"
                               class="form-control" />

                        <span asp-validation-for="University.Name"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            البريد الإلكتروني
                        </label>

                        <input asp-for="University.Email"
                               class="form-control" />

                        <span asp-validation-for="University.Email"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            رقم الهاتف
                        </label>

                        <input asp-for="University.PhoneNumber"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            الحالة
                        </label>

                        <select asp-for="University.IsActive"
                                class="form-select">

                            <option value="true">
                                نشطة
                            </option>

                            <option value="false">
                                غير نشطة
                            </option>

                        </select>

                    </div>

                    <div class="col-12">

                        <label class="form-label">
                            العنوان
                        </label>

                        <textarea asp-for="University.Address"
                                  rows="4"
                                  class="form-control">
                        </textarea>

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <button type="submit"
                        class="btn btn-success px-5">

                    <i class="bi bi-check-circle"></i>

                    حفظ التعديلات

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}