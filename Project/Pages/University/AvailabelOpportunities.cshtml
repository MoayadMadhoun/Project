@page
@model Project.Pages.University.AvailabelOpportunitiesModel
@{
    ViewData["Title"] = "الفرص التدريبية المتاحة";
    ViewData["UserType"] = "University";
    ViewData["UserName"] = "جامعة بيرزيت";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
    ViewData["ActivePage"] = "Opportunities";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">
@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">مرحبا بك، جامعة @Model.CurrentUniversity.Name</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
            أهلاً بك في نظام إدارة التدريب الميداني. يمكنكم الآن متابعة شؤون المتدربين، إدارة الكيانات، والتواصل مع التدريب بكل كفاءة.
        </p>
        <div class="flex flex-col sm:flex-row gap-md">
            <a class="w-full sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors" asp-page="/University/TrainingRequests/Create">+ طلب فرصة</a>
            @if (User.IsInRole("DepartmentHead") || User.IsInRole("UniversityTrainingAdmin"))
            {
                <a class="w-full sm:w-auto bg-primary/20 backdrop-blur-md border border-white/30 text-white font-button px-xl py-3 rounded-xl hover:bg-primary/30 transition-colors" asp-page=@(User.IsInRole("DepartmentHead") ? "/University/DepartmentHeadTrainingRequests" : "/University/UniAdminTrainigRequests")>مراجعة الطلبات الجديدة</a>
            }
        </div>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Filters Bar ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div>
        <form method="get" class="flex flex-wrap gap-3 items-center justify-end">
            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
            <div class="relative flex-1 min-w-[180px]">
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                <input asp-for="SearchTerm" class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن فرصة..." type="text" />
            </div>
            <select asp-items="Model.Specialities" asp-for="SpecialtyId" class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">التخصص</option>
           
            </select>
            <select asp-for="StatusId" class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="">حالة الفرصة</option>
                <option value="1">مفتوحة</option>
                <option value="2">منتهية</option>
                <option value="3">مغلقة</option>
            </select>
            <select asp-for="PeriodMonths" class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="0">فترة التدريب</option>
                <option value="1">شهر واحد</option>
                <option value="2">شهرين</option>
                <option value="3">3 أشهر</option>
                <option value="4">4 أشهر</option>
            </select>
            <button type="submit" class="bg-primary-container text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">بحث</button>
        </form>
    </div>
</div>

@* ===== Opportunities Table ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] overflow-hidden">
    <div class="p-4 md:p-lg border-b border-slate-100 flex justify-between items-center">
        @* <button class="text-primary text-sm font-bold hover:underline">عرض الكل</button> *@
        <h3 class="font-h3 text-lg md:text-h3 text-slate-900">الفرص التدريبية المطلوبة</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse min-w-[1100px]">
            <thead class="bg-surface-container-low">
                <tr>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">عنوان الفرصة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المؤسسة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">التخصص</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">المقاعد</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">فترة التدريب</th>
                    @* <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">آخر موعد للتقديم</th> *@
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">حالة الفرصة</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">تاريخ الإنشاء</th>
                    <th class="px-4 py-3 text-slate-500 font-label-caps text-label-caps">الإجراءات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var request in Model.OpportunityRequests)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 text-sm text-slate-900 font-bold">@request.Title</td>
                        <td class="px-4 py-3 text-sm text-slate-900">
                            @foreach(var or in request.OpportunityRequests)
                            {
                                <span>@or.TrainingInstitution.Name</span>
                            }
                            </td>
                        <td class="px-4 py-3 text-sm text-slate-600">
                            @foreach (var sp in request.Specialties)
                            {
                                <span>@sp.Specialty.Name </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-600">@request.RequestedSeats</td>
                        <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">@request.PreferredEndDate?.ToString("yyyy-MM-dd") ← @request.PreferredStartDate?.ToString("yyyy-MM-dd")</td>
                        @* <td class="px-4 py-3 text-sm text-slate-600">@request.</td> *@
                        <td class="px-4 md:px-lg py-4 md:py-md">
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold @(request.Status == Models.TrainingOpportunityRequest.RequestStatus.Published ? "bg-green-100 text-green-700" :
                                                                                       request.Status == Models.TrainingOpportunityRequest.RequestStatus.Closed ? "bg-amber-100 text-amber-700" :
                                                                                       request.Status == Models.TrainingOpportunityRequest.RequestStatus.Cancelled ? "bg-red-100 text-red-700" :
                                                                                       request.Status == Models.TrainingOpportunityRequest.RequestStatus.Draft ? "bg-blue-100 text-blue-700" :
                                                                                       "bg-orange-100 text-orange-700")"> @request.Status.ToString()</span>
                        </td>
                        <td class="px-3 py-3 text-sm text-slate-600">@request.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3">
                            <div class="flex gap-1">
                                
                                <a asp-page="TrainingRequests/Details" asp-route-RequestId="@request.RequestID" class="btn border border-primary text-primary text-xs font-bold rounded-circle px-2 py-2 rounded hover:bg-emerald-50 flex items-center gap-1"><i class="bi bi-eye"></i></a>
                                <a asp-page="TrainingRequests/Edit" asp-route-RequestId="@request.RequestID" class="btn border border-warning text-warning text-xs font-bold rounded-circle px-2 py-2 rounded hover:bg-emerald-50 flex items-center gap-1"><i class="bi bi-pen"></i> </a>
                                <a asp-page="TrainingRequests/Delete" asp-route-RequestId="@request.RequestID" class="btn border border-danger text-danger text-xs font-bold rounded-circle px-2 py-2 rounded hover:bg-rose-50 flex items-center gap-1"> <i class="bi bi-trash3"></i></a>
                               
                                @* <button class="bg-primary text-white text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-primary/90 whitespace-nowrap">تسجيل طلاب</button> *@
                            </div>
                        </td>

                    </tr>
                }

            </tbody>
        </table>
    </div>
    <div class="p-4 md:p-lg flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
            <p class="text-sm text-slate-500 font-body-sm whitespace-nowrap">
                عرض <span class="font-bold text-slate-900">@Model.OpportunityRequests.Count</span> من أصل <span class="font-bold text-slate-900">@Model.OpportunityRequests.TotalCount</span> طلب
            </p>
            <div class="flex items-center gap-2">
                <label class="text-xs text-slate-500 font-label-caps" for="per-page-inst">النتائج:</label>
                <form>
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="PageIndex" value="@Model.PageIndex"/>
                    <input type="hidden" name="SortOrder" value="@Model.SortOrder"/>
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="StatusId" value="@Model.StatusId" />
                    <input type="hidden" name="SpecialtyId" value="@Model.SpecialtyId" />
                    <input type="hidden" name="PeriodMonths" value="@Model.PeriodMonths" />
                <select asp-for="PageSize"
                        onchange="this.form.submit()"
                        class="bg-slate-100 border-none rounded-lg text-xs font-bold text-slate-700 py-1.5 pr-8 pl-3 focus:ring-2 focus:ring-primary/20 appearance-none cursor-pointer"
                        id="per-page-inst">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                </form>
            </div>
        </div>

        <nav class="flex items-center gap-2">
            @if (Model.OpportunityRequests.HasPrevPage)
            {
                <a asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-StatusId="@Model.StatusId"
                   asp-route-SpecialtyId="@Model.SpecialtyId"
                   asp-route-PeriodMonths="@Model.PeriodMonths"
                   asp-route-PageSize="@Model.PageSize"
                    asp-route-PageIndex="@(Model.PageIndex - 1)"
                   class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_right</span></a>
            }
           
            @for (int i = 1; i <= Model.OpportunityRequests.TotalPages; i++)
            {

                <a asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-StatusId="@Model.StatusId"
                   asp-route-SpecialtyId="@Model.SpecialtyId"
                   asp-route-PeriodMonths="@Model.PeriodMonths"
                   asp-route-PageSize="@Model.PageSize"
                    asp-route-PageIndex="@i"
                   class="w-8 h-8 flex items-center justify-center rounded-lg @(Model.PageIndex == i ? "bg-primary-container" : "border border-slate-200 text-slate-600 hover:bg-slate-50 ")  text-white text-sm font-bold">@i</a>
            }
            @if (Model.OpportunityRequests.HasNextPage)
            {
                <a asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-StatusId="@Model.StatusId"
                   asp-route-SpecialtyId="@Model.SpecialtyId"
                   asp-route-PeriodMonths="@Model.PeriodMonths"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-PageIndex="@(Model.PageIndex + 1)"
                   class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50"><span class="material-symbols-outlined">chevron_left</span></a>
            }
        </nav>
    </div>

</div>
