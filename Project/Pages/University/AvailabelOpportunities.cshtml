@page
@model Project.Pages.University.AvailabelOpportunitiesModel
@{
    ViewData["Title"] = "الفرص التدريبية المتاحة";
    ViewData["UserType"] = "University";
    ViewData["UserName"] = "جامعة بيرزيت";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
    ViewData["ActivePage"] = "Opportunities";
}
<link rel="stylesheet" href="~/Styles/opportunities.css">
@* ===== Hero Section ===== *@
<section class="mb-lg md:mb-xl relative rounded-xl md:rounded-2xl overflow-hidden bg-primary-container p-6 md:p-xl text-on-primary">
    <div class="relative z-10 max-w-2xl text-right">
        <h1 class="font-h1 text-2xl md:text-h1 mb-md">مرحبا بك، جامعة بيرزيت</h1>
        <p class="font-body-lg text-sm md:text-body-lg opacity-90 mb-lg">
            أهلاً بك في نظام إدارة التدريب الميداني. يمكنكم الآن متابعة شؤون المتدربين، إدارة الكيانات، والتواصل مع التدريب بكل كفاءة.
        </p>
        <div class="flex flex-col sm:flex-row gap-md">
            <button class="w-full sm:w-auto bg-white text-primary font-button px-xl py-3 rounded-xl shadow-lg hover:bg-surface-container transition-colors">+ طلب فرصة</button>
            <button class="w-full sm:w-auto bg-primary/20 backdrop-blur-md border border-white/30 text-white font-button px-xl py-3 rounded-xl hover:bg-primary/30 transition-colors">مراجعة الطلبات الجديدة</button>
        </div>
    </div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 md:w-64 md:h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-secondary-fixed-dim/20 rounded-full blur-3xl"></div>
</section>

@* ===== Filters Bar ===== *@
<div class="bg-surface-container-lowest rounded-xl border border-slate-100 shadow-[0_4px_20px_rgba(44,62,80,0.05)] p-4 mb-lg">
    <div class="flex flex-wrap gap-3 items-center justify-end">
        <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input class="w-full pr-10 pl-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" placeholder="ابحث عن فرصة..." type="text" />
        </div>
        <select class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>التخصص</option>
            <option>هندسة البرمجيات</option>
            <option>نظم المعلومات</option>
            <option>تحليل البيانات</option>
            <option>تصميم جرافيك</option>
            <option>الأمن السيبراني</option>
        </select>
        <select class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>حالة الفرصة</option>
            <option>مفتوحة</option>
            <option>مغلقة</option>
            <option>منتهية</option>
        </select>
        <select class="bg-slate-100 border-none rounded-xl text-sm font-bold text-slate-700 py-2.5 px-4 focus:ring-2 focus:ring-primary/20 cursor-pointer">
            <option>فترة التدريب</option>
            <option>شهر واحد</option>
            <option>شهرين</option>
            <option>3 أشهر</option>
            <option>4 أشهر</option>
        </select>
        <button class="bg-primary text-white font-button px-6 py-2.5 rounded-xl hover:bg-primary/90 transition-colors">بحث</button>
    </div>
</div>

