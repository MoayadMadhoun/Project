@page "{departmentId}"
@model Project.Pages.University.department.updateModel

@{
    ViewData["Title"] = "تعديل القسم";
    ViewData["UserType"] = "University";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن طلاب، مؤسسات...";
}

<form method="post">

    <!-- Hero Section -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        تعديل القسم
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        تحديث بيانات القسم الأكاديمي وإدارة حالته داخل الجامعة.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-pencil-square fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Department Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                بيانات القسم
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-8">

                    <label class="form-label fw-semibold">
                        اسم القسم
                    </label>

                    <input asp-for="DepartmentName"  type="text"
                           class="form-control shadow-sm rounded-3 bg-light border-0"
                           />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        حالة القسم
                    </label>

                    <select asp-for="IsActive" class="form-select shadow-sm rounded-3 bg-light border-0">
                        <option value="true">
                            نشط
                        </option>

                        <option value="false">
                            غير نشط
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- Information Card -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-info-circle-fill text-primary fs-3"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        ملاحظة
                    </h6>

                    <p class="text-muted mb-0">
                        تعديل بيانات القسم لن يؤثر على الطلبة أو التخصصات المرتبطة به.
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Department Details -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات إضافية
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="text-muted">
                        رقم القسم
                    </label>

                    <div class="fw-semibold">
                        DEP-001
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        عدد التخصصات
                    </label>

                    <div class="fw-semibold">
                        @Model.Department?.Specialties.Count() تخصصات
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        عدد الطلبة
                    </label>

                    <div class="fw-semibold">
                        @Model.Department?.Students.Count() طالب
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button  type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-check-circle me-1"></i>

            حفظ التعديلات

        </button>

        <a href="#"
           class="btn btn-light px-5">

            <i class="bi bi-arrow-right-circle me-1"></i>

            رجوع

        </a>

    </div>

</form>