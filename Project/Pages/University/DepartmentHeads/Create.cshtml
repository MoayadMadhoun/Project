@page 
@model Project.Pages.University.DepartmentHeads.CreateModel

@{
    ViewData["Title"] = "إضافة رئيس قسم";
}

<form method="post">

    <!-- Hero -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-5 text-white"
             style="background:#1ab29a;border-radius:24px;">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h1 class="fw-bold mb-3">
                        إضافة رئيس قسم
                    </h1>

                    <p class="mb-0 fs-5 opacity-75">
                        إنشاء حساب رئيس قسم جديد وربطه بأحد أقسام الجامعة.
                    </p>

                </div>

                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                     style="width:90px;height:90px;">

                    <i class="bi bi-person-badge-fill fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Personal Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                بيانات رئيس القسم
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        الاسم الكامل
                    </label>

                   @* asp-for="Input.Name" *@
                    <input asp-for="Input.Name" class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="أدخل الاسم الكامل" />

                    <span asp-validation-for="Input.Name" class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        البريد الإلكتروني
                    </label>

                    @* asp-for="Input.Email" *@
                    <input asp-for="Input.Email" class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="head@university.edu" />

                    <span asp-validation-for="Input.Email" class="text-danger"></span>


                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        رقم الهاتف
                    </label>

                     @* asp-for="Input.PhoneNumber" *@
                    <input asp-for="Input.PhoneNumber" class="form-control shadow-sm rounded-3 bg-light border-0"
                           placeholder="059xxxxxxx" />

                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>


                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        القسم
                    </label>

                    @* asp-for="Input.DepartmentId"
                            asp-items="Model.Departments" *@
                    <select asp-for="Input.DepartmentId" asp-items="Model.DepartmentList" class="form-select shadow-sm rounded-3 bg-light border-0">

                        <option value="">
                            اختر القسم
                        </option>

                    </select>
                    <span asp-validation-for="Input.DepartmentId" class="text-danger"></span>


                </div>

            </div>

        </div>

    </div>

    <!-- Account Information -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                معلومات الحساب
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <label class="text-muted">
                        الدور
                    </label>

                    <div class="fw-semibold">
                        رئيس قسم
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        الجامعة
                    </label>

                    <div class="fw-semibold">
                        الجامعة الحالية
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted">
                        طريقة الدخول
                    </label>

                    <div class="fw-semibold">
                        البريد الإلكتروني وكلمة المرور
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Permissions -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                صلاحيات رئيس القسم
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <div class="border rounded-4 p-3">

                        <i class="bi bi-check2-square text-success me-2"></i>

                        مراجعة طلبات التدريب

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-4 p-3">

                        <i class="bi bi-people-fill text-primary me-2"></i>

                        متابعة طلبة القسم

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-4 p-3">

                        <i class="bi bi-file-earmark-check text-warning me-2"></i>

                        اعتماد الطلبات أو رفضها

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-4 p-3">

                        <i class="bi bi-bar-chart-fill text-danger me-2"></i>

                        الاطلاع على إحصائيات القسم

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Process -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                إجراءات إنشاء الحساب
            </h5>

        </div>

        <div class="card-body">

            <div class="row text-center g-3">

                <div class="col-md-3">

                    <div class="border rounded-4 p-4">

                        <i class="bi bi-person-plus-fill text-success fs-1"></i>

                        <h6 class="mt-3">
                            إنشاء الحساب
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4">

                        <i class="bi bi-diagram-3-fill text-primary fs-1"></i>

                        <h6 class="mt-3">
                            ربط القسم
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4">

                        <i class="bi bi-key-fill text-warning fs-1"></i>

                        <h6 class="mt-3">
                            إنشاء كلمة المرور
                        </h6>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded-4 p-4">

                        <i class="bi bi-envelope-check-fill text-danger fs-1"></i>

                        <h6 class="mt-3">
                            إرسال التفعيل
                        </h6>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Info -->

    <div class="alert alert-info border-0 shadow-sm mb-4">

        <i class="bi bi-info-circle-fill me-2"></i>

        سيتم إنشاء كلمة مرور عشوائية وكود تفعيل وإرسالهما إلى البريد الإلكتروني الخاص برئيس القسم.

    </div>

    <!-- Buttons -->

    <div class="d-flex gap-2 mb-5">

        <button type="submit"
                class="btn btn-success px-5">

            <i class="bi bi-person-check-fill me-1"></i>

            إنشاء رئيس القسم

        </button>

        <a asp-page="/University/DepartmentsHeads"
           class="btn btn-light px-5">

            <i class="bi bi-x-circle me-1"></i>

            إلغاء

        </a>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
