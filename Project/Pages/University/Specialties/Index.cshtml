@page
@model Project.Pages.University.Specialties.IndexModel

@{
    ViewData["Title"] = "التخصصات";
    ViewData["UserType"] = "University";
    ViewData["PortalTitle"] = "بوابة الجامعة";
    ViewData["PortalSubtitle"] = "إدارة التدريب الميداني";
    ViewData["SearchPlaceholder"] = "بحث عن تخصص...";
}

<!-- Hero Section -->

<div class="card border-0 shadow-sm mb-4">

     
    <div class="card-body p-5 text-white"
         style="background:#1ab29a;border-radius:24px;">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h1 class="fw-bold mb-3">
                    التخصصات
                </h1>

                <p class="mb-0 fs-5 opacity-75">
                    إدارة التخصصات الأكاديمية وربطها بالأقسام والطلبة وفرص التدريب.
                </p>

            </div>

            <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                 style="width:90px;height:90px;">

                <i class="bi bi-mortarboard-fill fs-1"></i>

            </div>

        </div>

    </div>
     

</div>

<!-- Statistics -->

<div class="row g-3 mb-4">

     
    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-journal-bookmark text-primary fs-1"></i>

                <h6 class="mt-2">
                    إجمالي التخصصات
                </h6>

                <h2 class="fw-bold text-primary">
                    @Model.TotalSpecialties
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-check-circle text-success fs-1"></i>

                <h6 class="mt-2">
                    التخصصات النشطة
                </h6>

                <h2 class="fw-bold text-success">
                    @Model.ActiveSpecialties
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-x-circle text-danger fs-1"></i>

                <h6 class="mt-2">
                    التخصصات غير النشطة
                </h6>

                <h2 class="fw-bold text-danger">
                    @Model.InactiveSpecialties
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-people text-warning fs-1"></i>

                <h6 class="mt-2">
                    إجمالي الطلبة
                </h6>

                <h2 class="fw-bold text-warning">
                    @Model.TotalStudents
                </h2>

            </div>

        </div>

    </div>
     

</div>

<form method="get">


<!-- Filters -->

<div class="row g-3 mb-4">

     
    <div class="col-md-3">

        <select asp-for="DepartmentId"
                asp-items="Model.Departments"
                    class="form-select border-none rounded-3">

            <option value="">
                جميع الأقسام
            </option>

        </select>

    </div>

    <div class="col-md-3">

        <select asp-for="StatusId"
                    class="form-select border-none rounded-3">

            <option value="0">
                جميع الحالات
            </option>

            <option value="1">
                نشط
            </option>

            <option value="2">
                غير نشط
            </option>

        </select>

    </div>

    <div class="col-md-4">
            <button type="submit" class="btn text-white" style="background:#1ab29a;">
            <i class="bi bi-search"></i>
            بحث
        </button>
    </div>

    <div class="col-md-2">

        <a asp-page="Create"
               class="btn text-white w-100" style="background:#1ab29a;">

            <i class="bi bi-plus-circle me-1"></i>

            إضافة تخصص

        </a>

    </div>
     

</div>
</form>
<!-- Table -->

<div class="card border-0 shadow-sm rounded-4">

     
    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="fw-bold mb-0">
                قائمة التخصصات
            </h5>

            <span class="text-muted">
                إجمالي @Model.TotalSpecialties تخصص
            </span>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table align-middle table-hover mb-0">

            <thead class="table-light">

                <tr>

                    <th>#</th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-SortOrder="@(Model.SortOrder == "Name_desc" ? "" : "Name_desc")">
                            اسم التخصص
                        </a>
                    </th>

                    <th>القسم</th>

                    <th>التصنيف</th>

                    <th>عدد الطلبة</th>

                    <th>الحالة</th>

                    <th>الإجراءات</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Specialties)
                {
                    <tr>

                        <td>@item.SpecialtyID</td>

                        <td>@item.Name</td>

                        <td>@item.Department?.Name</td>

                        <td>@item.Category</td>

                        <td>@item.Students.Count</td>

                        <td>

                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">
                                    نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    غير نشط
                                </span>
                            }

                        </td>

                        <td>

                            <div class="btn-group">

                                <a asp-page="Details"
                                   asp-route-id="@item.SpecialtyID"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-page="Edit"
                                   asp-route-id="@item.SpecialtyID"
                                   class="btn btn-sm btn-outline-success">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <a asp-page="Delete"
                                   asp-route-id="@item.SpecialtyID"
                                   class="btn btn-sm btn-outline-danger">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>
        </table>

    </div>
     

</div>

<!-- Pagination -->

@if (Model.Specialties.TotalPages > 1)
{
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div class="text-muted small">

                    عرض
                    @(((Model.Specialties.PageIndex - 1) * Model.PageSize) + 1)

                    -

                    @(Math.Min(Model.Specialties.PageIndex * Model.PageSize,
                        Model.Specialties.TotalCount))

                    من أصل

                    @Model.Specialties.TotalCount

                    تخصص

                </div>

                <nav>

                    <ul class="pagination pagination-sm mb-0">

                        <!-- Previous -->

                        <li class="page-item @(Model.Specialties.HasPrevPage ? "" : "disabled")">

                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-PageIndex="@(Model.Specialties.PageIndex - 1)"
                               asp-route-DepartmentId="@Model.DepartmentId"
                               asp-route-StatusId="@Model.StatusId"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-SortOrder="@Model.SortOrder">

                                <i class="bi bi-chevron-right"></i>

                            </a>

                        </li>

                        @for (int i = 1; i <= Model.Specialties.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Specialties.PageIndex ? "active" : "")">

                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-PageIndex="@i"
                                   asp-route-DepartmentId="@Model.DepartmentId"
                                   asp-route-StatusId="@Model.StatusId"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-SortOrder="@Model.SortOrder">

                                    @i

                                </a>

                            </li>
                        }

                        <!-- Next -->

                        <li class="page-item @(Model.Specialties.HasNextPage ? "" : "disabled")">

                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-PageIndex="@(Model.Specialties.PageIndex + 1)"
                               asp-route-DepartmentId="@Model.DepartmentId"
                               asp-route-StatusId="@Model.StatusId"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-SortOrder="@Model.SortOrder">

                                <i class="bi bi-chevron-left"></i>

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>

        </div>

    </div>
}