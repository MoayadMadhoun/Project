@page
@model Project.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    
    Layout = "_NLayout";
}

<div class="container py-3">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <div class="rounded-circle d-inline-flex justify-content-center align-items-center"
                             style="width:130px;height:130px;background:#e8f9f7;">

                            <i class="bi bi-shield-lock-fill"
                               style="font-size:70px;color:#1ab29a;"></i>

                        </div>

                    </div>

                    <h1 class="fw-bold text-danger mb-3">
                        Access Denied
                    </h1>

                    <h4 class="fw-semibold mb-4">
                        ليس لديك صلاحية للوصول إلى هذه الصفحة
                    </h4>

                    <p class="text-muted fs-5">

                        يبدو أنك حاولت الوصول إلى صفحة لا تملك الصلاحية لعرضها.
                        إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع مسؤول النظام.

                    </p>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-center gap-3">

                        <a asp-page="/Index"
                           class="btn btn-success px-5">

                            <i class="bi bi-house-door-fill me-2"></i>

                            الصفحة الرئيسية

                        </a>

                        <button onclick="history.back()"
                                class="btn btn-outline-secondary px-5">

                            <i class="bi bi-arrow-left me-2"></i>

                            رجوع

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>