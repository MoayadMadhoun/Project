                            <button class="btn-opp" style="width:auto;padding:.3rem .9rem;">عرض التفاصيل ←</button>
                        </div>
                    </div>

        

                    <!-- Card 5 -->
       
                    <div class="opp-card swiper-slide">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="opp-badge badge-company">فرصة شركة</span>
                            <div class="opp-logo" style="background:#fff3e8;">
                                <i class="fas fa-oil-can" style="color:#f0a500;"></i>
                            </div>
                        </div>
                        <div class="opp-title">تدريب في إدارة المشاريع</div>
                        <div class="opp-meta">
                            <span><i class="fas fa-graduation-cap"></i> إدارة أعمال</span>
                            <span><i class="fas fa-clock"></i> 3 أشهر</span>
                            <span><i class="fas fa-users"></i> 1</span>
