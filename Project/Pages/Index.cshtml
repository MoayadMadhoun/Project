                            <div class="opp-logo" style="background:#e8f8f3;">
                                <i class="fas fa-calculator" style="color:var(--teal);"></i>
                            </div>
                        </div>
                        <div class="opp-title">تدريب في المحاسبة</div>
                        <div class="opp-meta">
                            <span><i class="fas fa-graduation-cap"></i> محاسبة</span>
